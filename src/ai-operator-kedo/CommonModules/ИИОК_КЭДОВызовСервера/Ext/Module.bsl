#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьОтбор(Отбор, Аргументы)

	Для Каждого Имя Из СтрРазделить("hired_from,hired_to", ",") Цикл
		Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, Имя);
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Дата = ДатаИзСтроки(Значение);
		Если Дата = Неопределено Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не дата в %1: %2.'"), Имя, Строка(Значение)),
				НСтр("ru = 'Дата в формате ISO 8601, например 2026-09-01.'"));
		КонецЕсли;
		Если Имя = "hired_from" Тогда
			Отбор.ПринятыС = НачалоДня(Дата);
		Иначе
			Отбор.ПринятыПо = КонецДня(Дата);
		КонецЕсли;
	КонецЦикла;

	Допустимые = СтрРазделить("not_connected,invited,invite_expired,connected", ",");
	Статусы = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "status", Новый Массив);
	Если ТипЗнч(Статусы) = Тип("Строка") Тогда
		Статусы = СтрРазделить(Статусы, ",", Ложь);
	КонецЕсли;
	Для Каждого Статус Из Статусы Цикл
		Если Допустимые.Найти(СокрЛП(Статус)) = Неопределено Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Неизвестный статус: %1.'"), Статус),
				СтрШаблон(НСтр("ru = 'Допустимые статусы: %1.'"), СтрСоединить(Допустимые, ", ")));
		КонецЕсли;
		Отбор.Статусы.Добавить(СокрЛП(Статус));
	КонецЦикла;

	Организация = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "organization");
	Если ЗначениеЗаполнено(Организация) Тогда
		Отбор.Организация = ИИО_Ответ.СсылкаИзСтроки(Организация);
		Если ТипЗнч(Отбор.Организация) <> Тип("СправочникСсылка.Организации") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не организация: %1.'"), Строка(Организация)),
				НСтр("ru = 'Передай ref организации из ответа инструмента или не задавай organization.'"));
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ДатаИзСтроки(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) = 10 Тогда
		Текст = Текст + "T00:00:00";
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ОписаниеСотрудника(Строка)

	Описание = Новый Структура;
	Описание.Вставить("employee", Строка.Сотрудник);
	Описание.Вставить("hired", Строка.ДатаПриема);
	Описание.Вставить("organization", Строка.Организация);
	Описание.Вставить("department", Строка.Подразделение);
	Описание.Вставить("position", Строка.Должность);
	Описание.Вставить("kedo_status", Строка.Статус);
	Описание.Вставить("has_email", Строка.ЕстьПочта);
	Если ЗначениеЗаполнено(Строка.ДатаУвольнения) Тогда
		Описание.Вставить("dismissed", Строка.ДатаУвольнения);
	КонецЕсли;
	Возврат Описание;

КонецФункции

Функция ОписаниеИсточника(Отбор)

	Источник = Новый Структура;
	Источник.Вставить("data", НСтр("ru = 'Кадровые данные ЗУП и статусы сотрудников в расширении КЭДО, как в «Текущих делах КЭДО»'"));
	Источник.Вставить("organizations", НСтр("ru = 'Организации, сопоставленные в КЭДО'"));
	Если ЗначениеЗаполнено(Отбор.ПринятыС) Тогда
		Источник.Вставить("hired_from", Отбор.ПринятыС);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.ПринятыПо) Тогда
		Источник.Вставить("hired_to", Отбор.ПринятыПо);
	КонецЕсли;
	Если Отбор.Статусы.Количество() > 0 Тогда
		Источник.Вставить("status", Отбор.Статусы);
	КонецЕсли;
	Возврат Источник;

КонецФункции

#КонецОбласти
