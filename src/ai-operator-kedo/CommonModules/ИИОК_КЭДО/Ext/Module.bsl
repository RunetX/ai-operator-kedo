// Участник документооборота КЭДО для сотрудника 1С - тот же, что подставляет штатная форма. КЭДО создает
// участника, если его еще нет, поэтому пакетного варианта у метода нет.
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
//
// Возвращаемое значение:
//  СправочникСсылка.КЭДО_УчастникиДокументооборота - Пустая ссылка, если сотрудник не подключен к КЭДО.
Функция УчастникПоСотруднику(Сотрудник) Экспорт

	Возврат Справочники.КЭДО_УчастникиДокументооборота.ПоСотруднику1С(Сотрудник);

КонецФункции

// Сотрудники 1С участников документооборота КЭДО: один запрос КЭДО на организацию вместо запроса на участника.
//
// Параметры:
//  Участники - Массив из СправочникСсылка.КЭДО_УчастникиДокументооборота
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.КЭДО_УчастникиДокументооборота
//   * Значение - СправочникСсылка.Сотрудники
Функция СотрудникиУчастников(Участники) Экспорт

	Результат = Новый Соответствие;
	Если Участники.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Участники.Ссылка КАК Участник,
	|	Участники.Код КАК Идентификатор,
	|	Участники.Владелец.Код КАК ОрганизацияID
	|ИЗ
	|	Справочник.КЭДО_УчастникиДокументооборота КАК Участники
	|ГДЕ
	|	Участники.Ссылка В(&Участники)
	|	И Участники.ТипУчастника = ЗНАЧЕНИЕ(Перечисление.КЭДО_ТипыУчастниковДокументооборота.Employee)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияID";
	Запрос.УстановитьПараметр("Участники", Участники);
	Таблица = Запрос.Выполнить().Выгрузить();

	ОрганизацииID = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Таблица.ВыгрузитьКолонку("ОрганизацияID"));
	Для Каждого ОрганизацияID Из ОрганизацииID Цикл
		Строки = Таблица.НайтиСтроки(Новый Структура("ОрганизацияID", ОрганизацияID));
		Идентификаторы = Новый Массив;
		Для Каждого Строка Из Строки Цикл
			Идентификаторы.Добавить(Строка.Идентификатор);
		КонецЦикла;
		Сотрудники = КЭДО_Сервер.ПолучитьСотрудников(Идентификаторы, ОрганизацияID);
		Для Каждого Строка Из Строки Цикл
			Сотрудник = Сотрудники.Получить(Строка.Идентификатор);
			Если ЗначениеЗаполнено(Сотрудник) Тогда
				Результат.Вставить(Строка.Участник, Сотрудник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
