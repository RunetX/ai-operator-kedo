// Тесты kedo_documents и kedo_familiarize на сервере: поиск ЛНА со статусом, проверки до открытия формы
// «Отправка на ознакомление» и итог после её закрытия.
// Карточки ЛНА тесты создают в организации КЭДО стенда в транзакции, после теста она откатывается.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТестовыйНабор("Поиск ЛНА")
		.ДобавитьТест("ЛНАНаходитсяПоЧастиНаименованияСоСтатусом")
		.ДобавитьТест("СпецсимволыПоискаИщутсяКакТекст")
		.ДобавитьТест("УУтвержденногоЛНАЕстьСводкаОзнакомления")
		.ДобавитьТест("НеЛНАОтклоняется")
		.ДобавитьТестовыйНабор("Проверки до открытия формы")
		.ДобавитьТест("БезРазрешенияОзнакомлениеЗапрещено")
		.ДобавитьТест("НеутвержденныйЛНАНеОтправляется")
		.ДобавитьТест("ОтправленнуюВерсиюПовторноНеОтправить")
		.ДобавитьТест("ОзнакомлениеПолучаютТолькоПодключенные")
		.ДобавитьТестовыйНабор("Итог после формы")
		.ДобавитьТест("ФормаЗакрытаБезОтправкиЭтоОтмена")
		.ДобавитьТест("ПоСрокуФормаОстаетсяОткрытой");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЛНАНаходитсяПоЧастиНаименованияСоСтатусом() Экспорт

	Маркер = НовыйМаркер();
	Создан = НовыйЛНА(Маркер + " положение");
	ВРаботе = НовыйЛНА(Маркер + " правила", Перечисления.КонтурКэдоЛНАСтатусы.ВРаботе);

	Ответ = ИИОК_ЛНА.Документы(Новый Структура("text", Маркер));

	ЮТест.ОжидаетЧто(Ответ.count).Равно(2);
	ЮТест.ОжидаетЧто(Описание(Ответ, Создан).status, "без записи статуса").Равно("created");
	ЮТест.ОжидаетЧто(Описание(Ответ, ВРаботе).status).Равно("in_approval");
	ЮТест.ОжидаетЧто(Описание(Ответ, ВРаботе)).НеИмеетСвойства("familiarization");
	ЮТест.ОжидаетЧто(Ответ.source.text).Равно(Маркер);

КонецПроцедуры

Процедура СпецсимволыПоискаИщутсяКакТекст() Экспорт

	Маркер = НовыйМаркер();
	НовыйЛНА(Маркер + " 100% [а]");
	НовыйЛНА(Маркер + " 1000 а");

	// Без экранирования «%» и «_» были бы шаблонами ПОДОБНО, а «[а]» — набором символов.
	ЮТест.ОжидаетЧто(ИИОК_ЛНА.Документы(Новый Структура("text", Маркер + " 100%")).count, "%").Равно(1);
	ЮТест.ОжидаетЧто(ИИОК_ЛНА.Документы(Новый Структура("text", Маркер + " 1_0")).count, "_").Равно(0);
	ЮТест.ОжидаетЧто(ИИОК_ЛНА.Документы(Новый Структура("text", Маркер + " 100% [а]")).count, "[]").Равно(1);

КонецПроцедуры

Процедура УУтвержденногоЛНАЕстьСводкаОзнакомления() Экспорт

	ЛНА = НовыйЛНА(НовыйМаркер() + " утверждён", Перечисления.КонтурКэдоЛНАСтатусы.Утвержден);

	Ответ = ИИОК_ЛНА.Документы(Новый Структура("document", ИИО_Ответ.СсылкаВСтроку(ЛНА)));

	ЮТест.ОжидаетЧто(Ответ.documents).ИмеетДлину(1);
	Документ = Ответ.documents[0];
	ЮТест.ОжидаетЧто(Документ.status).Равно("approved");
	ЮТест.ОжидаетЧто(Документ.familiarization.sent).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Документ.familiarization.familiarized).Равно(0);
	// С document в ответе ещё участники ознакомления; у нового ЛНА их нет.
	ЮТест.ОжидаетЧто(Документ.participants).ИмеетДлину(0);

КонецПроцедуры

Процедура НеЛНАОтклоняется() Экспорт

	Сотрудник = НеподключенныйСотрудник();

	Ответ = ИИОК_ЛНА.Документы(Новый Структура("document", Сотрудник.Ссылка));

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("kedo_documents");

КонецПроцедуры

Процедура БезРазрешенияОзнакомлениеЗапрещено() Экспорт

	ОМ_ИИОК_ДанныеВызовСервера.УстановитьРазрешение("kedo_familiarize", Ложь);
	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.Утвержден);

	Ответ = ИИОК_ЛНА.ПодготовитьОзнакомление(Аргументы(ЛНА, НеподключенныйСотрудник()));

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("ACTION_DENIED");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("kedo_familiarize");

КонецПроцедуры

Процедура НеутвержденныйЛНАНеОтправляется() Экспорт

	Разрешить();
	Сотрудник = НеподключенныйСотрудник();
	ЛНА = НовыйЛНА(НовыйМаркер());
	Ответ = ИИОК_ЛНА.ПодготовитьОзнакомление(Аргументы(ЛНА, Сотрудник));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "создан").Равно("LNA_NOT_APPROVED");

	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.ВРаботе);
	Ответ = ИИОК_ЛНА.ПодготовитьОзнакомление(Аргументы(ЛНА, Сотрудник));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "на утверждении").Равно("LNA_NOT_APPROVED");
	// Модель объясняет пользователю, а не отправляет на утверждение сама.
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("ИИ-оператор его не выполняет");

КонецПроцедуры

Процедура ОтправленнуюВерсиюПовторноНеОтправить() Экспорт

	Разрешить();
	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.Утвержден);
	ОМ_ИИОК_ДанныеВызовСервера.ОтметитьОтправленнымНаОзнакомление(ЛНА);

	Ответ = ИИОК_ЛНА.ПодготовитьОзнакомление(Аргументы(ЛНА, НеподключенныйСотрудник()));

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("FAMILIARIZATION_ALREADY_SENT");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("«Процесс ознакомления»");
	Список = ИИОК_ЛНА.Документы(Новый Структура("document", ИИО_Ответ.СсылкаВСтроку(ЛНА)));
	ЮТест.ОжидаетЧто(Список.documents[0].familiarization.sent, "сводка kedo_documents").ЭтоИстина();

КонецПроцедуры

Процедура ОзнакомлениеПолучаютТолькоПодключенные() Экспорт

	Разрешить();
	Сотрудник = НеподключенныйСотрудник();
	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.Утвержден, Сотрудник.ОрганизацияID);
	Параметры = Аргументы(ЛНА, Сотрудник);
	Параметры.employees.Добавить("Справочник.Организации:" + Новый УникальныйИдентификатор);

	Ответ = ИИОК_ЛНА.ПодготовитьОзнакомление(Параметры);
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "не сотрудник").Равно("INVALID_ARGUMENT");

	Параметры.employees.Удалить(1);
	Подготовка = ИИОК_ЛНА.ПодготовитьОзнакомление(Параметры);

	ЮТест.ОжидаетЧто(Подготовка.ЛНА).Равно(ЛНА);
	ЮТест.ОжидаетЧто(Подготовка.Сотрудники).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Подготовка.Пропущены).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Подготовка.Пропущены[0].reason).Равно("not_connected");
	ЮТест.ОжидаетЧто(Подготовка.Пропущены[0].kedo_status).Равно("not_connected");

КонецПроцедуры

Процедура ФормаЗакрытаБезОтправкиЭтоОтмена() Экспорт

	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.Утвержден);
	Сотрудник = НеподключенныйСотрудник();

	Итог = ИИОК_ЛНА.ИтогОзнакомления(ЛНА, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Сотрудник),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.КЭДО_УчастникиДокументооборота.ПустаяСсылка()),
		Новый Массив);

	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.sent).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Итог.not_sent).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Итог).НеИмеетСвойства("form_open");

КонецПроцедуры

Процедура ПоСрокуФормаОстаетсяОткрытой() Экспорт

	ЛНА = НовыйЛНА(НовыйМаркер(), Перечисления.КонтурКэдоЛНАСтатусы.Утвержден);
	Сотрудник = НеподключенныйСотрудник();

	Итог = ИИОК_ЛНА.ИтогОзнакомления(ЛНА, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Сотрудник),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.КЭДО_УчастникиДокументооборота.ПустаяСсылка()),
		Новый Массив, Истина);

	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Итог.form_open).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.hint).Содержит("Не открывай её снова");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Разрешить()

	ОМ_ИИОК_ДанныеВызовСервера.УстановитьРазрешение("kedo_familiarize", Истина);

КонецПроцедуры

Функция НеподключенныйСотрудник()

	Сотрудник = ОМ_ИИОК_ДанныеВызовСервера.НеподключенныйСотрудник();
	Если Сотрудник = Неопределено Тогда
		ЮТест.Пропустить("На стенде нет неподключённых к КЭДО сотрудников");
	КонецЕсли;
	Возврат Сотрудник;

КонецФункции

// Наименования тестовых ЛНА уникальны, чтобы поиск не находил ЛНА стенда.
Функция НовыйМаркер()

	Возврат "ИИОТест" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=") + Прав(Строка(Новый УникальныйИдентификатор), 4);

КонецФункции

// ЛНА создаётся в организации КЭДО сотрудника: kedo_familiarize сравнивает организации ЛНА и сотрудника.
Функция НовыйЛНА(Наименование, Статус = Неопределено, ОрганизацияID = Неопределено)

	Если ОрганизацияID = Неопределено Тогда
		ОрганизацияID = НеподключенныйСотрудник().ОрганизацияID;
	КонецЕсли;
	Возврат ОМ_ИИОК_ДанныеВызовСервера.НовыйЛНА(ОрганизацияID, Наименование, Статус);

КонецФункции

Функция Аргументы(ЛНА, Сотрудник)

	Возврат Новый Структура("document, employees", ИИО_Ответ.СсылкаВСтроку(ЛНА),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Ссылка));

КонецФункции

Функция Описание(Ответ, ЛНА)

	Ссылка = ИИО_Ответ.СсылкаВСтроку(ЛНА);
	Для Каждого Документ Из Ответ.documents Цикл
		Если Документ.document.ref = Ссылка Тогда
			Возврат Документ;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "ЛНА нет в ответе kedo_documents";

КонецФункции

#КонецОбласти
