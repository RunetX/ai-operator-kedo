// Регистрация пакета КЭДО в ядре на сервере (см. ИИО_Пакеты): действия пакета для разрешений ИИ-оператора.
// Инструменты пакет регистрирует на клиенте (ИИОК_ПакетКлиент).

#Область ПрограммныйИнтерфейс

// Действия пакета, которые администратор ИИ-оператора разрешает пользователям в регистре ИИО_РазрешенияДействий.
// Нет записи - действие запрещено. Вызывается ядром (ИИО_Права.РазрешаемыеДействия).
//
// Параметры:
//  Разрешения - Соответствие из КлючИЗначение:
//   * Ключ - Строка - Код действия, который проверяет инструмент пакета.
//   * Значение - Строка - Представление для администратора.
Процедура ПриРегистрацииРазрешений(Разрешения) Экспорт

	Если Не ИИОК_КЭДО.РасширениеКЭДОУстановлено() Тогда
		Возврат;
	КонецЕсли;
	Разрешения.Вставить("kedo_invite", НСтр("ru = 'Пригласить сотрудников в КЭДО'"));
	Если ИИОК_ЛНА.ЛНАЕсть() Тогда
		Разрешения.Вставить("kedo_familiarize", НСтр("ru = 'Отправить ЛНА на ознакомление в КЭДО'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
