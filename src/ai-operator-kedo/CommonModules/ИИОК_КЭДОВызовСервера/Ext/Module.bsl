// Серверная часть kedo_setup с open за один вызов: проверка перед открытием мастера первого запуска КЭДО,
// добавление пользователя в «Администраторы КЭДО» и сводка настройки до мастера.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * ИмяФормы - Строка - Полное имя формы мастера.
//   * СводкаДо - Строка - см. ИИОК_Настройка.СводкаСнимка
//   * АдминистраторДобавлен - Булево - см. ИИОК_Настройка.ДобавитьВАдминистраторы
Функция ПодготовитьОткрытиеМастера() Экспорт

	Ошибка = ИИОК_Настройка.ПроверитьОткрытие();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	АдминистраторДобавлен = ИИОК_Настройка.ДобавитьВАдминистраторы();
	Возврат Новый Структура("ИмяФормы, СводкаДо, АдминистраторДобавлен", ИИОК_Настройка.ИмяФормыМастера(),
		ИИОК_Настройка.СводкаСнимка(), АдминистраторДобавлен);

КонецФункции

