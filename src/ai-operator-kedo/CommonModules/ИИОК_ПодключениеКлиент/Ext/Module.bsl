// Подключение к КЭДО одной кнопкой на клиенте (kedo_setup с open): вход в сервис, вопрос с планом по шагам мастера
// и кнопкой «Подключить», фоновое задание с окном ожидания БСП, ответ модели. Сервер - ИИОК_Подключение.
// Вход - библиотекой входа КЭДО: браузер открывается сразу, а если устройство библиотеки поменялось - штатным окном
// входа КЭДО.

#Область СлужебныйПрограммныйИнтерфейс

// Начинает подключение. Ответ модели придет после вопроса и фонового задания.
//
// Параметры:
//  Вызов - Структура - Вызов инструмента, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
Процедура Начать(Вызов) Экспорт

	Контекст = Новый Структура("Вызов, СводкаДо, План, Хранилище, АдресСоглашения", Вызов,
		ИИОК_КЭДОВызовСервера.СводкаНастройки(), Неопределено, Новый УникальныйИдентификатор, "");
	Если ИИОК_КЭДОВызовСервера.СеансКЭДОЕсть() Тогда
		ПослеВхода(Истина, Контекст);
	Иначе
		НачатьВход(Новый ОписаниеОповещения("ПослеВхода", ИИОК_ПодключениеКлиент, Контекст));
	КонецЕсли;

КонецПроцедуры

// Продолжение после входа в сервис: план и вопрос пользователю.
//
// Параметры:
//  Сеанс - Произвольный - Сеанс КЭДО; Неопределено - вход не выполнен.
//  Контекст - Структура - См. Начать.
Процедура ПослеВхода(Сеанс, Контекст) Экспорт

	Если Сеанс = Неопределено Тогда
		Завершить(Контекст, Истина, НСтр("ru = 'Вход в сервис КЭДО не выполнен.'"));
		Возврат;
	КонецЕсли;
	Контекст.План = ИИОК_КЭДОВызовСервера.ПланПодключения();
	Если ЗначениеЗаполнено(Контекст.План.Ошибка) Тогда
		Завершить(Контекст, Ложь, Контекст.План.Ошибка);
		Возврат;
	КонецЕсли;
	СпроситьПодтверждение(Контекст);

КонецПроцедуры

// Ответ на вопрос с планом.
//
// Параметры:
//  Ответ - Строка, КодВозвратаДиалога, Неопределено - connect, agreement, cancel или закрытие вопроса.
//  Контекст - Структура - См. Начать.
Процедура ПослеВопроса(Ответ, Контекст) Экспорт

	Если Ответ = "agreement" Тогда
		ПоказатьСоглашение(Контекст);
	ИначеЕсли Ответ = "connect" Тогда
		Подключить(Контекст);
	Иначе
		Завершить(Контекст, Истина);
	КонецЕсли;

КонецПроцедуры

// Продолжение после получения каталога временных файлов: сохраняет PDF соглашения.
//
// Параметры:
//  Каталог - Строка
//  Контекст - Структура - См. Начать.
Процедура ПослеКаталогаВременныхФайлов(Каталог, Контекст) Экспорт

	Путь = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(Каталог) + "Соглашение КЭДО.pdf";
	НачатьПолучениеФайлаССервера(Новый ОписаниеОповещения("ПослеПолученияСоглашения", ИИОК_ПодключениеКлиент,
		Контекст), Контекст.АдресСоглашения, Путь);

КонецПроцедуры

// Продолжение после сохранения PDF соглашения: открывает его программой просмотра.
//
// Параметры:
//  Файл - ОписаниеПереданногоФайла, Неопределено
//  Контекст - Структура - См. Начать.
Процедура ПослеПолученияСоглашения(Файл, Контекст) Экспорт

	Если Файл = Неопределено Тогда
		СпроситьПодтверждение(Контекст);
		Возврат;
	КонецЕсли;
	НачатьЗапускПриложения(Новый ОписаниеОповещения("ПослеОткрытияСоглашения", ИИОК_ПодключениеКлиент, Контекст),
		Файл.ПолноеИмя);

КонецПроцедуры

// Возвращает к вопросу с планом после просмотра соглашения.
//
// Параметры:
//  КодВозврата - Число, Неопределено
//  Контекст - Структура - См. Начать.
Процедура ПослеОткрытияСоглашения(КодВозврата, Контекст) Экспорт

	СпроситьПодтверждение(Контекст);

КонецПроцедуры

// Возвращает к вопросу с планом, если сервис не отдал соглашение.
//
// Параметры:
//  Контекст - Структура - См. Начать.
Процедура ПослеПредупрежденияОСоглашении(Контекст) Экспорт

	СпроситьПодтверждение(Контекст);

КонецПроцедуры

// Завершает вызов kedo_setup после фонового задания подключения.
//
// Параметры:
//  Результат - Структура, Неопределено - Результат ожидания БСП; Неопределено - окно ожидания закрыли.
//  Контекст - Структура - См. Начать.
Процедура ПослеПодключения(Результат, Контекст) Экспорт

	Если Результат = Неопределено Тогда
		Завершить(Контекст, Ложь, НСтр("ru = 'Подключение прервано: окно ожидания закрыто до завершения.'"));
		Возврат;
	КонецЕсли;
	Итог = ИИОК_КЭДОВызовСервера.ИтогПодключения(Результат, Контекст.СводкаДо);
	Если Итог.Успех Тогда
		Оповестить("КонтурКэдоМПЗЗавершен");
		ОбновитьИнтерфейс();
		ПоказатьОповещениеПользователя(НСтр("ru = 'КЭДО подключено'"), , Итог.Сообщение);
	КонецЕсли;
	ИИО_РеестрИнструментовКлиент.Завершить(Контекст.Вызов, Итог.Ответ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НачатьВход(Оповещение)

	Аутентификация = ОбщегоНазначенияКлиент.ОбщийМодуль("КонтурКэдоАутентификацияКлиент");
	Попытка
		Клиент = Аутентификация.Клиент();
		Отбор = ОбщегоНазначенияКлиент.ОбщийМодуль("КонтурКэдоАутентификацияКлиентСервер").ОтборХранилищаСессий();
		Отбор.ПользовательИБ = ОбщегоНазначенияКлиент.ОбщийМодуль("КонтурКэдоИнфраКлиент").ТекущийПользовательИБ();
		Клиент.УстановитьОтборСессий(Отбор);
		// Та же цепочка обработки сеанса, что у штатного входа КЭДО, но без кнопки «Войти через браузер».
		Обертка = Новый Соответствие;
		Обертка.Вставить("Ошибки", Неопределено);
		Обертка.Вставить("Стэк", Неопределено);
		Обертка.Вставить("ОписаниеОповещения", Новый ОписаниеОповещения("НачатьВходОбертка", Аутентификация,
			Оповещение));
		Клиент.НачатьПолучениеСессии(Новый ОписаниеОповещения("ОткрытьАутентификаторОбертка", Аутентификация,
			Обертка));
	Исключение
		// Устройство библиотеки входа КЭДО поменялось: входим штатным окном КЭДО, на кнопку больше.
		Аутентификация.НачатьВход(Оповещение);
	КонецПопытки;

КонецПроцедуры

Процедура СпроситьПодтверждение(Контекст)

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("connect", НСтр("ru = 'Подключить'"));
	Если ЗначениеЗаполнено(Контекст.План.Соглашение) Тогда
		Кнопки.Добавить("agreement", НСтр("ru = 'Текст соглашения'"));
	КонецЕсли;
	Кнопки.Добавить("cancel", НСтр("ru = 'Отмена'"));
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопроса", ИИОК_ПодключениеКлиент, Контекст), Контекст.План.Текст,
		Кнопки, , "connect", НСтр("ru = 'Подключение к КЭДО'"));

КонецПроцедуры

Процедура ПоказатьСоглашение(Контекст)

	Контекст.АдресСоглашения = ИИОК_КЭДОВызовСервера.СоглашениеПодключения(Контекст.План.Соглашение,
		Контекст.Хранилище);
	Если Не ЗначениеЗаполнено(Контекст.АдресСоглашения) Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеПредупрежденияОСоглашении", ИИОК_ПодключениеКлиент,
			Контекст), НСтр("ru = 'Сервис КЭДО не отдал текст соглашения. Проверьте подключение к интернету.'"));
		Возврат;
	КонецЕсли;
	НачатьПолучениеКаталогаВременныхФайлов(Новый ОписаниеОповещения("ПослеКаталогаВременныхФайлов",
		ИИОК_ПодключениеКлиент, Контекст));

КонецПроцедуры

Процедура Подключить(Контекст)

	Операция = ИИОК_КЭДОВызовСервера.НачатьПодключение(Контекст.План.Подтверждено, Контекст.Хранилище);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Подключение к КЭДО'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения("ПослеПодключения", ИИОК_ПодключениеКлиент, Контекст), ПараметрыОжидания);

КонецПроцедуры

Процедура Завершить(Контекст, Отменено, ТекстОшибки = "")

	ИИО_РеестрИнструментовКлиент.Завершить(Контекст.Вызов,
		ИИОК_КЭДОВызовСервера.ОтветПодключения(Контекст.СводкаДо, Отменено, ТекстОшибки));

КонецПроцедуры

#КонецОбласти
