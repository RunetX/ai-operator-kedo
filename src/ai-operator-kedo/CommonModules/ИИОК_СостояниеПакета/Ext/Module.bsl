// Состояние пакета для формы «Состояние ИИ-оператора» ядра (этап 3д, Р-2). Ядро находит модуль по окончанию
// имени _СостояниеПакета в подсистеме пакета. Проверки собираются без вызовов ядра: пакет работает и с ядром,
// которое этот модуль еще не знает.

#Область ПрограммныйИнтерфейс

// Имя расширения пакета.
//
// Возвращаемое значение:
//  Строка
Функция ИмяРасширения() Экспорт

	Возврат "ИИОператор_КЭДО";

КонецФункции

// Версия пакета. Совпадает со свойством «Версия» в Configuration.xml (проверяют сборка и выпуск):
// читать версии расширений пользователю не позволяют права.
//
// Возвращаемое значение:
//  Строка
Функция ВерсияПакета() Экспорт

	Возврат "0.2.1.0";

КонецФункции

// С какой версии ядра пакет работает.
//
// Возвращаемое значение:
//  Строка
Функция МинимальнаяВерсияЯдра() Экспорт

	Возврат "0.1.14.0";

КонецФункции

// Уровень API пакетов ядра, для которого написан пакет, см. ИИО_Настройки.ВерсияКонтрактаПакетов.
//
// Возвращаемое значение:
//  Число
Функция ВерсияКонтрактаЯдра() Экспорт

	Возврат 1;

КонецФункции

// Проверки пакета: установлено ли расширение Контур.КЭДО и настроено ли оно.
//
// Параметры:
//  Проверки - Массив из Структура - см. ИИО_Диагностика.НоваяПроверка.
Процедура ПриСбореПроверок(Проверки) Экспорт

	// Версию чужого расширения и настройки КЭДО пользователь сам читать не может.
	УстановитьПривилегированныйРежим(Истина);
	Если Не ИИОК_КЭДО.РасширениеКЭДОУстановлено() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Проверки.Добавить(НоваяПроверка("kedo.extension", НСтр("ru = 'Расширение Контур.КЭДО'"), "error",
			НСтр("ru = 'Расширение Контур.КЭДО не найдено: инструменты КЭДО не работают.'"),
			НСтр("ru = 'Установите расширение Контур.КЭДО из справки Контура.'")));
		Возврат;
	КонецЕсли;
	Проверки.Добавить(НоваяПроверка("kedo.extension", НСтр("ru = 'Расширение Контур.КЭДО'"), "ok",
		СтрШаблон(НСтр("ru = 'Установлено, версия %1.'"), ИИОК_КЭДО.ВерсияРасширенияКЭДО())));
	Настроено = ИИОК_Настройка.Снимок().Настроено;
	УстановитьПривилегированныйРежим(Ложь);
	Если Настроено Тогда
		Проверки.Добавить(НоваяПроверка("kedo.setup", НСтр("ru = 'Подключение КЭДО'"), "ok",
			НСтр("ru = 'КЭДО настроено.'")));
	Иначе
		Проверки.Добавить(НоваяПроверка("kedo.setup", НСтр("ru = 'Подключение КЭДО'"), "warning",
			НСтр("ru = 'КЭДО еще не настроено в этой базе.'"),
			НСтр("ru = 'Попросите ИИ-оператора «Подключи КЭДО» или откройте мастер настройки КЭДО.'")));
	КонецЕсли;

КонецПроцедуры

// Действие проверки пакета. Действий у пакета нет.
//
// Параметры:
//  Действие - Строка
//
// Возвращаемое значение:
//  Строка
Функция ВыполнитьДействие(Действие) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'У пакета нет действия %1.'"), Действие);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка в формате ядра, см. ИИО_Диагностика.НоваяПроверка.
//
// Параметры:
//  Код - Строка
//  Заголовок - Строка
//  Статус - Строка - ok, warning, error, skipped.
//  Текст - Строка
//  Подсказка - Строка
//  Действие - Строка
//
// Возвращаемое значение:
//  Структура
Функция НоваяПроверка(Код, Заголовок, Статус, Текст, Подсказка = "", Действие = "")

	Возврат Новый Структура("Код, Группа, Заголовок, Статус, Текст, Подсказка, Действие",
		Код, "Пакеты", Заголовок, Статус, Текст, Подсказка, Действие);

КонецФункции

#КонецОбласти
