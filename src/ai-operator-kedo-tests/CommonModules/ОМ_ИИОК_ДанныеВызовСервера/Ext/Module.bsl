// Тестовые данные для тестов пакета ИИОператор_КЭДО на стенде ЗУП с расширением КЭДО.
// Приглашения, сотрудники сервиса и ЛНА пишутся так, как их записывает обмен КЭДО (режим загрузки), и связываются
// с сотрудниками демо-базы. Серверные тесты создают их в транзакции (ЮТТесты.ВТранзакции): база не меняется.
// Клиентские тесты транзакций не имеют, поэтому вызывают отсюда только чтение и разрешения с возвратом.

#Область СлужебныйПрограммныйИнтерфейс

// Работающий сотрудник организации, сопоставленной в КЭДО, без приглашения и без связи с сервисом.
//
// Параметры:
//  Кроме - Массив из СправочникСсылка.Сотрудники, Неопределено - Уже выбранные тестом.
//  СКонтактами - Булево, Неопределено - Есть ли в 1С почта или телефон; Неопределено — не важно.
//
// Возвращаемое значение:
//  Структура - см. ОписаниеСотрудника
//  Неопределено - Такого сотрудника на стенде нет.
Функция НеподключенныйСотрудник(Кроме = Неопределено, СКонтактами = Неопределено) Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Статусы.Добавить("not_connected");
	Для Каждого Строка Из ИИОК_КЭДО.ДанныеСотрудников(Отбор) Цикл
		Если Кроме <> Неопределено И Кроме.Найти(Строка.Сотрудник) <> Неопределено Тогда
			Продолжить;
		ИначеЕсли СКонтактами <> Неопределено И (Строка.ЕстьПочта Или Строка.ЕстьТелефон) <> СКонтактами Тогда
			Продолжить;
		КонецЕсли;
		Возврат ОписаниеСотрудника(Строка);
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Уволенный сотрудник организации, сопоставленной в КЭДО.
//
// Возвращаемое значение:
//  Структура - см. ОписаниеСотрудника
//  Неопределено - Такого сотрудника на стенде нет.
Функция УволенныйСотрудник() Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.ТолькоРаботающие = Ложь;
	Для Каждого Строка Из ИИОК_КЭДО.ДанныеСотрудников(Отбор) Цикл
		Если ЗначениеЗаполнено(Строка.ДатаУвольнения) И Строка.ДатаУвольнения < ТекущаяДатаСеанса() Тогда
			Возврат ОписаниеСотрудника(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Приглашение сервиса КЭДО, связанное с сотрудником. По умолчанию данные приглашения совпадают с 1С.
//
// Параметры:
//  Сотрудник - см. ОписаниеСотрудника
//  Просрочено - Булево
//  Поля - Структура, Неопределено - Другие значения ресурсов КЭДО_Invites: ФИО, email, birthdate, inviteChannel.
//
// Возвращаемое значение:
//  Строка - Идентификатор приглашения.
Функция Пригласить(Сотрудник, Просрочено = Ложь, Поля = Неопределено) Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Элемент = Справочники.КонтурКэдоПриглашения.СоздатьЭлемент();
	Элемент.Владелец = ОрганизацияКЭДО(Сотрудник.ОрганизацияID);
	Элемент.Идентификатор = Идентификатор;
	Элемент.Наименование = Сотрудник.ФИО;
	Элемент.СвязанныеОбъекты.Добавить().Объект = Сотрудник.Сотрудник;
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();

	Набор = РегистрыСведений.КЭДО_Invites.СоздатьНаборЗаписей();
	Набор.Отбор.id.Установить(Идентификатор);
	Набор.Отбор.organizations_id.Установить(Сотрудник.ОрганизацияID);
	Запись = Набор.Добавить();
	Запись.id = Идентификатор;
	Запись.organizations_id = Сотрудник.ОрганизацияID;
	Запись.card_id = Строка(Новый УникальныйИдентификатор);
	Запись.ФИО = Сотрудник.ФИО;
	Запись.email = Сотрудник.Почта;
	Запись.birthdate = Сотрудник.ДатаРождения;
	Запись.inviteChannel = "Email";
	Запись.Просрочено = Просрочено;
	Если Поля <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Запись, Поля);
	КонецЕсли;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	Возврат Идентификатор;

КонецФункции

// Сотрудник сервиса КЭДО, связанный с сотрудником 1С (сотрудник подключён). По умолчанию данные совпадают с 1С.
//
// Параметры:
//  Сотрудник - см. ОписаниеСотрудника
//  Поля - Структура, Неопределено - Другие значения ресурсов КЭДО_Employees: ФИО, deleted_at, СертификатыЭП.
//
// Возвращаемое значение:
//  Строка - Идентификатор сотрудника сервиса.
Функция Подключить(Сотрудник, Поля = Неопределено) Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Элемент = Справочники.КонтурКэдоСотрудники.СоздатьЭлемент();
	Элемент.Владелец = ОрганизацияКЭДО(Сотрудник.ОрганизацияID);
	Элемент.Идентификатор = Идентификатор;
	Элемент.Наименование = Сотрудник.ФИО;
	Элемент.СвязанныеОбъекты.Добавить().Объект = Сотрудник.Сотрудник;
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();

	ДанныеСервиса = Новый Структура;
	ДанныеСервиса.Вставить("ФИО", Сотрудник.ФИО);
	ДанныеСервиса.Вставить("email", Сотрудник.Почта);
	ДанныеСервиса.Вставить("birthdate", Сотрудник.ДатаРождения);
	ДанныеСервиса.Вставить("uniqueId", Сотрудник.ТабельныйНомер);
	ДанныеСервиса.Вставить("СертификатыЭП", "КЭП до " + Формат(ДобавитьМесяц(ТекущаяДатаСеанса(), 12), "ДФ=dd.MM.yyyy"));
	Если Поля <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Поля Цикл
			ДанныеСервиса.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	ЗаписатьСотрудникаСервиса(Идентификатор, Сотрудник.ОрганизацияID, ДанныеСервиса);
	Возврат Идентификатор;

КонецФункции

// Новая организация КЭДО, как её записывает обмен, для проверок первичной настройки.
//
// Параметры:
//  Сопоставлена - Булево - Сопоставить с первой организацией 1С, как мастер первого запуска.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.КЭДО_Организации
//   * ОрганизацияID - Строка
//   * Организация - СправочникСсылка.Организации - Пустая, если не сопоставлена.
Функция НоваяОрганизацияКЭДО(Сопоставлена) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Элемент = Справочники.КЭДО_Организации.СоздатьЭлемент();
	Элемент.Наименование = "Организация теста первичной настройки";
	Элемент.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Если Сопоставлена Тогда
		Элемент.Организация = Выборка.Ссылка;
		Элемент.Сопоставлен = Истина;
		Элемент.СвязанныеОбъекты.Добавить().Объект = Выборка.Ссылка;
	КонецЕсли;
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();
	Возврат Новый Структура("Ссылка, ОрганизацияID, Организация", Элемент.Ссылка, Элемент.Идентификатор,
		Элемент.Организация);

КонецФункции

// Сотрудник сервиса в организации КЭДО.
//
// Параметры:
//  Организация - Структура - см. НоваяОрганизацияКЭДО.
//  Связан - Булево - Связать с сотрудником 1С, как это делает обмен или мастер.
Процедура ДобавитьСотрудникаСервиса(Организация, Связан = Ложь) Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Если Связан Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	НЕ Сотрудники.ПометкаУдаления");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Элемент = Справочники.КонтурКэдоСотрудники.СоздатьЭлемент();
		Элемент.Владелец = Организация.Ссылка;
		Элемент.Идентификатор = Идентификатор;
		Элемент.Наименование = "Сотрудник теста первичной настройки";
		Элемент.СвязанныеОбъекты.Добавить().Объект = Выборка.Ссылка;
		Элемент.ОбменДанными.Загрузка = Истина;
		Элемент.Записать();
	КонецЕсли;
	ЗаписатьСотрудникаСервиса(Идентификатор, Организация.ОрганизацияID,
		Новый Структура("ФИО", "Сотрудник теста первичной настройки"));

КонецПроцедуры

// Сотрудник сервиса КЭДО без связи с сотрудником 1С — «Нет связи с 1С» в «Текущих делах КЭДО».
//
// Параметры:
//  ОрганизацияID - Строка
//  ФИО - Строка
Процедура ДобавитьНесвязанногоВСервисе(ОрганизацияID, ФИО) Экспорт

	ЗаписатьСотрудникаСервиса(Строка(Новый УникальныйИдентификатор), ОрганизацияID, Новый Структура("ФИО", ФИО));

КонецПроцедуры

// Последняя передача кадровых данных сотрудника в КЭДО — запись «Отчёта синхронизации».
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
//  ОписаниеОшибки - Строка - Пустая — передача прошла.
Процедура ЗаписатьСинхронизацию(Сотрудник, ОписаниеОшибки) Экспорт

	Идентификатор = Новый УникальныйИдентификатор;
	Набор = РегистрыСведений.КЭДО_СотрудникиКСинхронизации.СоздатьНаборЗаписей();
	Набор.Отбор.Сотрудник.Установить(Сотрудник);
	Набор.Отбор.ДокументСсылка.Установить(Идентификатор);
	Набор.Отбор.ДокументТип.Установить("Тест");
	Запись = Набор.Добавить();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Сотрудник = Сотрудник;
	Запись.ДокументСсылка = Идентификатор;
	Запись.ДокументТип = "Тест";
	Запись.Результат = ?(ЗначениеЗаполнено(ОписаниеОшибки), 0, 1);
	Запись.ОписаниеОшибки = ОписаниеОшибки;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

КонецПроцедуры

// Карточка ЛНА в организации КЭДО.
//
// Параметры:
//  ОрганизацияID - Строка
//  Наименование - Строка
//  Статус - ПеречислениеСсылка.КонтурКэдоЛНАСтатусы, Неопределено - Неопределено — статус не записан («Создан»).
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты
Функция НовыйЛНА(ОрганизацияID, Наименование, Статус = Неопределено) Экспорт

	Элемент = Справочники.КонтурКэдоЛНАЛокальныеНормативныеАкты.СоздатьЭлемент();
	Элемент.Владелец = ОрганизацияКЭДО(ОрганизацияID);
	Элемент.Наименование = Наименование;
	Элемент.ДатаСоздания = ТекущаяДатаСеанса();
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();
	Если Статус <> Неопределено Тогда
		Набор = РегистрыСведений.КонтурКэдоЛНАДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.ЛНА.Установить(Элемент.Ссылка);
		Запись = Набор.Добавить();
		Запись.ЛНА = Элемент.Ссылка;
		Запись.Статус = Статус;
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЕсли;
	Возврат Элемент.Ссылка;

КонецФункции

// Версия карточки ЛНА, отправленная на ознакомление: так её отмечает форма КЭДО при отправке.
//
// Параметры:
//  ЛНА - СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты
Процедура ОтметитьОтправленнымНаОзнакомление(ЛНА) Экспорт

	Версия = Справочники.КонтурКэдоЛНАВерсииЛНА.СоздатьЭлемент();
	Версия.Владелец = ЛНА;
	Версия.УстановитьНовыйКод();
	Версия.Наименование = "Текущая версия";
	Версия.ДатаВерсии = ТекущаяДатаСеанса();
	Версия.Статус = Перечисления.КонтурКэдоЛНАСтатусы.Утвержден;
	Версия.ОтправленоНаОзнакомление = Истина;
	Версия.ОбменДанными.Загрузка = Истина;
	Версия.Записать();

КонецПроцедуры

// Записывает разрешение действия ИИ-оператора текущему пользователю (запись на пользователя важнее записи на группу).
//
// Параметры:
//  Действие - Строка - Например, kedo_invite.
//  Разрешено - Булево
Процедура УстановитьРазрешение(Действие, Разрешено) Экспорт

	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Действие = Действие;
	Запись.Разрешено = Разрешено;
	Запись.Записать();

КонецПроцедуры

// Запрещает действие текущему пользователю. Для клиентских тестов: прежнее значение вернуть ВернутьРазрешение.
//
// Параметры:
//  Действие - Строка
//
// Возвращаемое значение:
//  Булево, Неопределено - Прежнее значение записи на пользователя; Неопределено — записи не было.
Функция ЗапретитьДействие(Действие) Экспорт

	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Действие = Действие;
	Запись.Прочитать();
	Прежнее = ?(Запись.Выбран(), Запись.Разрешено, Неопределено);
	УстановитьРазрешение(Действие, Ложь);
	Возврат Прежнее;

КонецФункции

// Возвращает запись разрешения, которую изменил ЗапретитьДействие.
//
// Параметры:
//  Действие - Строка
//  Прежнее - Булево, Неопределено - Результат ЗапретитьДействие.
Процедура ВернутьРазрешение(Действие, Прежнее) Экспорт

	Если Прежнее <> Неопределено Тогда
		УстановитьРазрешение(Действие, Прежнее);
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Действие = Действие;
	Запись.Удалить();

КонецПроцедуры

// Строковые ссылки сотрудников организаций КЭДО, как их передаёт модель.
//
// Параметры:
//  Количество - Число
//
// Возвращаемое значение:
//  Массив из Строка
Функция СсылкиСотрудников(Количество) Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Результат = Новый Массив;
	Для Каждого Строка Из ИИОК_КЭДО.ДанныеСотрудников(Отбор) Цикл
		Если Результат.Количество() = Количество Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ИИО_Ответ.СсылкаВСтроку(Строка.Сотрудник));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена людей за ссылками сотрудников: наименование сотрудника, ФИО физического лица и фамилия.
// Нужны клиентским тестам, чтобы проверить, что имена не ушли модели; в сообщения тестов их не выводить.
//
// Параметры:
//  Ссылки - Массив из Строка - Ссылки вида Справочник.Сотрудники:<УИД>.
//
// Возвращаемое значение:
//  Массив из Строка
Функция ИменаСотрудников(Ссылки) Экспорт

	Сотрудники = Новый Массив;
	Для Каждого Идентификатор Из Ссылки Цикл
		Сотрудники.Добавить(ИИО_Ответ.СсылкаИзСтроки(Идентификатор));
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Наименование КАК Наименование,
	|	Сотрудники.ФизическоеЛицо.ФИО КАК ФИО
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&Сотрудники)";
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	Имена = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Фамилия = СтрРазделить(СокрЛП(Выборка.ФИО) + " ", " ", Ложь)[0];
		Для Каждого Имя Из СтрРазделить(Выборка.Наименование + Символы.ПС + Выборка.ФИО + Символы.ПС + Фамилия,
			Символы.ПС, Ложь) Цикл
			Если СтрДлина(СокрЛП(Имя)) >= 3 И Имена.Найти(СокрЛП(Имя)) = Неопределено Тогда
				Имена.Добавить(СокрЛП(Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращаемое значение:
//  Структура:
//   * Сотрудник - СправочникСсылка.Сотрудники
//   * Ссылка - Строка - Как её передаёт модель.
//   * Организация - СправочникСсылка.Организации
//   * ОрганизацияID - Строка - Идентификатор организации в КЭДО.
//   * ФИО - Строка
//   * ДатаРождения - Дата
//   * Почта - Строка - Как её сравнивает диагностика: первая почта вида для приглашений.
//   * ТабельныйНомер - Строка
Функция ОписаниеСотрудника(Строка)

	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.ФизическоеЛицо, "ФИО, ДатаРождения");
	Описание = Новый Структура;
	Описание.Вставить("Сотрудник", Строка.Сотрудник);
	Описание.Вставить("Ссылка", ИИО_Ответ.СсылкаВСтроку(Строка.Сотрудник));
	Описание.Вставить("Организация", Строка.Организация);
	Описание.Вставить("ОрганизацияID", Строка.ОрганизацияID);
	Описание.Вставить("ФИО", Данные.ФИО);
	Описание.Вставить("ДатаРождения", Данные.ДатаРождения);
	Описание.Вставить("Почта", Почта(Строка.ФизическоеЛицо));
	Описание.Вставить("ТабельныйНомер", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Сотрудник, "Код"));
	Возврат Описание;

КонецФункции

Функция Почта(ФизическоеЛицо)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контакты.Представление КАК Представление
	|ИЗ
	|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК Контакты
	|ГДЕ
	|	Контакты.Ссылка = &ФизическоеЛицо
	|	И Контакты.Вид = &ВидПочты";
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ВидПочты", ИИОК_КЭДО.ВидПочты());
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Представление, "");

КонецФункции

Функция ОрганизацияКЭДО(ОрганизацияID)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КЭДО_Организации КАК Организации
	|ГДЕ
	|	Организации.Идентификатор = &Идентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", ОрганизацияID);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Нет организации КЭДО с идентификатором %1", ОрганизацияID);
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Процедура ЗаписатьСотрудникаСервиса(Идентификатор, ОрганизацияID, ДанныеСервиса)

	Набор = РегистрыСведений.КЭДО_Employees.СоздатьНаборЗаписей();
	Набор.Отбор.id.Установить(Идентификатор);
	Набор.Отбор.organizations_id.Установить(ОрганизацияID);
	Запись = Набор.Добавить();
	Запись.id = Идентификатор;
	Запись.organizations_id = ОрганизацияID;
	Запись.card_id = Строка(Новый УникальныйИдентификатор);
	ЗаполнитьЗначенияСвойств(Запись, ДанныеСервиса);
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

КонецПроцедуры

#КонецОбласти
