// Обработчики инструментов пакета КЭДО на сервере: сотрудники со статусом в КЭДО, строки для формы приглашения,
// диагностика. Данные сотрудников — ИИОК_КЭДО, проверки диагностики — ИИОК_Диагностика.

#Область СлужебныйПрограммныйИнтерфейс

// Установлено ли в базе расширение КЭДО, с которым работает пакет.
//
// Возвращаемое значение:
//  Булево
Функция РасширениеКЭДОУстановлено() Экспорт

	Возврат Метаданные.Обработки.Найти("КонтурКэдоПриглашениеСотрудников") <> Неопределено
		И Метаданные.Справочники.Найти("КЭДО_Организации") <> Неопределено
		И Метаданные.РегистрыСведений.Найти("КЭДО_Invites") <> Неопределено;

КонецФункции

// Обработчик инструмента kedo_employees.
//
// Параметры:
//  Аргументы - Структура, Соответствие - hired_from, hired_to, status, organization, limit.
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка.
Функция Сотрудники(Знач Аргументы) Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Ошибка = ЗаполнитьОтбор(Отбор, Аргументы);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Лимит = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit"), 100, 500);

	Таблица = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	ПоСтатусам = Новый Структура("not_connected, invited, invite_expired, connected", 0, 0, 0, 0);
	Список = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		ПоСтатусам[Строка.Статус] = ПоСтатусам[Строка.Статус] + 1;
		Если Список.Количество() < Лимит Тогда
			Список.Добавить(ОписаниеСотрудника(Строка));
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("employees", Список);
	Ответ.Вставить("count", Таблица.Количество());
	Ответ.Вставить("truncated", Таблица.Количество() > Лимит);
	Ответ.Вставить("by_status", ПоСтатусам);
	Ответ.Вставить("source", ОписаниеИсточника(Отбор));
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

// Проверяет вызов kedo_invite и готовит строки для формы КЭДО «Приглашение сотрудников в сервис».
// Приглашаются не подключённые сотрудники и сотрудники с просроченным приглашением; подключённые и
// ожидающие ответа на приглашение пропускаются с причиной.
//
// Параметры:
//  Аргументы - Структура, Соответствие - employees.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * Строки - Массив из Структура - Строки для параметра формы СотрудникиКПриглашению.
//   * Пропущены - Массив из Структура - employee, reason.
//   * Сотрудники - Массив из СправочникСсылка.Сотрудники - Все найденные сотрудники вызова.
Функция ПодготовитьПриглашение(Знач Аргументы) Экспорт

	Если Не ИИО_Права.ДействиеРазрешено("kedo_invite") Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'Пользователю не разрешено приглашать сотрудников в КЭДО через ИИ-оператора (действие kedo_invite).'"),
			НСтр("ru = 'Скажи пользователю попросить администратора ИИ-оператора разрешить действие kedo_invite.'"));
	КонецЕсли;

	Ссылки = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "employees", Новый Массив);
	Пропущены = Новый Массив;
	Сотрудники = Новый Массив;
	Для Каждого Элемент Из Ссылки Цикл
		Идентификатор = Элемент;
		Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Элемент, "ref");
		КонецЕсли;
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Идентификатор);
		Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Сотрудники") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не сотрудник: %1.'"), Строка(Идентификатор)),
				НСтр("ru = 'Передай ref сотрудников из ответа kedo_employees.'"));
		КонецЕсли;
		Если Сотрудники.Найти(Ссылка) = Неопределено Тогда
			Сотрудники.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Сотрудники.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не переданы сотрудники.'"),
			НСтр("ru = 'Сначала найди сотрудников инструментом kedo_employees.'"));
	КонецЕсли;

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Сотрудники = Сотрудники;
	Отбор.ТолькоРаботающие = Ложь;
	Таблица = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	Строки = Новый Массив;
	Для Каждого Сотрудник Из Сотрудники Цикл
		Строка = Таблица.Найти(Сотрудник, "Сотрудник");
		Если Строка = Неопределено Тогда
			Пропущены.Добавить(Новый Структура("employee, reason", Сотрудник, "not_in_kedo_organization"));
		ИначеЕсли ЗначениеЗаполнено(Строка.ДатаУвольнения) И Строка.ДатаУвольнения < ТекущаяДатаСеанса() Тогда
			Пропущены.Добавить(Новый Структура("employee, reason", Сотрудник, "dismissed"));
		ИначеЕсли Строка.Статус = "connected" Или Строка.Статус = "invited" Тогда
			Пропущены.Добавить(Новый Структура("employee, reason", Сотрудник, Строка.Статус));
		Иначе
			ДанныеСтроки = Новый Структура;
			ДанныеСтроки.Вставить("СотрудникВ1С", Строка.Сотрудник);
			ДанныеСтроки.Вставить("ОрганизацияВ1С", Строка.Организация);
			ДанныеСтроки.Вставить("ОрганизацияID", Строка.ОрганизацияID);
			ДанныеСтроки.Вставить("card_id", Строка.card_id);
			ДанныеСтроки.Вставить("ПриглашениеID", Строка.ПриглашениеID);
			ДанныеСтроки.Вставить("ПриглашениеSMSID", Строка.ПриглашениеSMSID);
			Строки.Добавить(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Строки, Пропущены, Сотрудники", Строки, Пропущены, Сотрудники);

КонецФункции

// Данные подключения к КЭДО для формы приглашения — так же их готовят «Текущие дела КЭДО».
// Права на приглашение по организациям форма дополняет на клиенте (КЭДО_Клиент.ИнформацияОПользователеПолучить).
//
// Возвращаемое значение:
//  Структура - Данные подключения.
//  Неопределено - Пользователь не вошёл в КЭДО.
Функция ДанныеПодключения() Экспорт

	Подключение = КЭДО_КэшируемыеДанныеСервер.ПодключениеСервер();
	Попытка
		КЭДО_Сервер.ВызовАвторизация(Подключение, Истина);
	Исключение
		КЭДО_Сервер.ЗаписатьИсключение(ИнформацияОбОшибке(), Метаданные.ОбщиеМодули.ИИОК_КЭДОВызовСервера);
		Возврат Неопределено;
	КонецПопытки;
	Если Не Подключение.АвторизацияВыполнена Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КонтурКэдоСтдКоллекцииКлиентСервер.СкопироватьРекурсивноЛок(Подключение);

КонецФункции

// Итог kedo_invite после закрытия формы: статусы сотрудников в КЭДО сейчас.
// Приглашение КЭДО записывает в базу сразу при отправке, поэтому обмен ждать не нужно.
//
// Параметры:
//  Приглашаемые - Массив из СправочникСсылка.Сотрудники - Сотрудники, открытые в форме.
//  Пропущены - Массив из Структура - employee, reason.
//  ФормаОткрыта - Булево - Итог по сроку ожидания: форма ещё открыта, пользователь может пригласить позже.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция ИтогПриглашения(Знач Приглашаемые, Знач Пропущены, Знач ФормаОткрыта = Ложь) Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Сотрудники = Приглашаемые;
	Отбор.ТолькоРаботающие = Ложь;
	Таблица = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	Приглашены = Новый Массив;
	НеПриглашены = Новый Массив;
	Для Каждого Сотрудник Из Приглашаемые Цикл
		Строка = Таблица.Найти(Сотрудник, "Сотрудник");
		Статус = ?(Строка = Неопределено, "not_connected", Строка.Статус);
		Если Статус = "invited" Или Статус = "connected" Тогда
			Приглашены.Добавить(Сотрудник);
		Иначе
			НеПриглашены.Добавить(Новый Структура("employee, kedo_status", Сотрудник, Статус));
		КонецЕсли;
	КонецЦикла;

	Отменено = Приглашаемые.Количество() > 0 И Приглашены.Количество() = 0 И Не ФормаОткрыта;
	Ответ = Новый Структура;
	// Отмену модель должна увидеть первой: младшие модели читают opened: true как «форма открыта»
	// и просят нажать «Пригласить» в уже закрытой форме.
	Если Отменено Тогда
		Ответ.Вставить("cancelled", Истина);
		Ответ.Вставить("hint", НСтр("ru = 'Пользователь закрыл форму приглашения, ничего не отправив: приглашения не ушли, статусы прежние. Так и скажи; снова открывай форму, только если пользователь попросит.'"));
	Иначе
		Ответ.Вставить("opened", Приглашаемые.Количество() > 0);
	КонецЕсли;
	Ответ.Вставить("invited", Приглашены);
	Ответ.Вставить("not_invited", НеПриглашены);
	Ответ.Вставить("skipped", Пропущены);
	Если Не Отменено Тогда
		Ответ.Вставить("cancelled", Ложь);
	КонецЕсли;
	Если ФормаОткрыта Тогда
		Ответ.Вставить("form_open", Истина);
		Ответ.Вставить("hint", НСтр("ru = 'Форма приглашения КЭДО ещё открыта: пользователь может пригласить позже. Не открывай её снова; статусы — kedo_employees.'"));
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

