КонецФункции

// Данные подключения к КЭДО для формы приглашения - так же их готовят «Текущие дела КЭДО». Форма КЭДО принимает
// их параметром, поэтому структура уходит на клиент целиком.
//
// Возвращаемое значение:
//  Структура - Данные подключения.
//  Неопределено - Пользователь не вошел в КЭДО.
Функция ДанныеПодключения() Экспорт

	Подключение = КЭДО_КэшируемыеДанныеСервер.ПодключениеСервер();
	Попытка
		КЭДО_Сервер.ВызовАвторизация(Подключение, Истина);
	Исключение
		// Модель получает ошибку KEDO_AUTH с советом войти в КЭДО, причина - в журнале КЭДО.
		КЭДО_Сервер.ЗаписатьИсключение(ИнформацияОбОшибке(), Метаданные.ОбщиеМодули.ИИОК_КЭДО);
		Возврат Неопределено;
	КонецПопытки;
	Если Не Подключение.АвторизацияВыполнена Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КонтурКэдоСтдКоллекцииКлиентСервер.СкопироватьРекурсивноЛок(Подключение);

КонецФункции

