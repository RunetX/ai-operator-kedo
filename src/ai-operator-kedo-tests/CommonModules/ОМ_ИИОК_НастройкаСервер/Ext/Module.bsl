// Тесты kedo_setup: первичная настройка КЭДО мастером первого запуска.
// Организации и сотрудников сервиса тесты создают в транзакции, после теста она откатывается. «Настроено» —
// признак на всю базу, поэтому проверки «не настроено» пропускаются, если КЭДО на стенде уже настроено.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТестовыйНабор("Снимок")
		.ДобавитьТест("СнимокСчитаетСотрудниковСервисаИСвязанных")
		.ДобавитьТест("СопоставленнаяОрганизацияССотрудникамиЗначитНастроено")
		.ДобавитьТест("БезСопоставленияИлиСотрудниковНеНастроено")
		.ДобавитьТестовыйНабор("Ответ для модели")
		.ДобавитьТест("ПутьПоМастеруТолькоПокаНеНастроено")
		.ДобавитьТест("МастерМожноОткрыть")
		.ДобавитьТестовыйНабор("Итог после мастера")
		.ДобавитьТест("МастерЗакрытБезИзмененийЭтоОтмена")
		.ДобавитьТест("МастерЗакрытПослеНастройкиНеОтмена")
		.ДобавитьТест("МастерОткрытКСрокуЭтоFormOpen");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СнимокСчитаетСотрудниковСервисаИСвязанных() Экспорт

	Организация = ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Истина);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Организация);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Организация, Истина);

	Строка = СтрокаОрганизации(ИИОК_Настройка.Снимок(), Организация);

	ЮТест.ОжидаетЧто(Строка.Сопоставлена).ЭтоИстина();
	ЮТест.ОжидаетЧто(Строка.Организация).Равно(Организация.Организация);
	ЮТест.ОжидаетЧто(Строка.ВСервисе).Равно(2);
	ЮТест.ОжидаетЧто(Строка.Связано).Равно(1);

КонецПроцедуры

Процедура СопоставленнаяОрганизацияССотрудникамиЗначитНастроено() Экспорт

	Организация = ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Истина);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Организация);

	ЮТест.ОжидаетЧто(ИИОК_Настройка.Снимок().Настроено).ЭтоИстина();

КонецПроцедуры

// Тот же признак, что у мастера КЭДО: несопоставленная организация и организация без сотрудников сервиса не в счёт.
Процедура БезСопоставленияИлиСотрудниковНеНастроено() Экспорт

	ПропуститьЕслиНастроено();
	Несопоставленная = ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Ложь);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Несопоставленная);
	ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Истина);

	ЮТест.ОжидаетЧто(ИИОК_Настройка.Снимок().Настроено).ЭтоЛожь();

КонецПроцедуры

Процедура ПутьПоМастеруТолькоПокаНеНастроено() Экспорт

	Состояние = ИИОК_Настройка.Состояние();
	Если Не Состояние.setup_done Тогда
		ЮТест.ОжидаетЧто(Состояние.guide).Заполнено();
		ЮТест.ОжидаетЧто(Состояние.hint).Содержит("open: true");
	КонецЕсли;

	Организация = ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Истина);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Организация);
	Состояние = ИИОК_Настройка.Состояние();

	ЮТест.ОжидаетЧто(Состояние.setup_done).ЭтоИстина();
	ЮТест.ОжидаетЧто(Состояние).НеИмеетСвойства("guide");
	ЮТест.ОжидаетЧто(Состояние.hint).Содержит("kedo_diagnose");

КонецПроцедуры

Процедура МастерМожноОткрыть() Экспорт

	ЮТест.ОжидаетЧто(ИИОК_Настройка.МастерЕсть()).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИОК_Настройка.ПроверитьОткрытие()).Равно(Неопределено);

КонецПроцедуры

Процедура МастерЗакрытБезИзмененийЭтоОтмена() Экспорт

	Итог = ИИОК_Настройка.Итог(ИИОК_Настройка.СводкаСнимка());

	ЮТест.ОжидаетЧто(Итог.opened).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.hint).Содержит("закрыл мастер");

КонецПроцедуры

Процедура МастерЗакрытПослеНастройкиНеОтмена() Экспорт

	СводкаДо = ИИОК_Настройка.СводкаСнимка();
	Организация = ОМ_ИИОК_ДанныеВызовСервера.НоваяОрганизацияКЭДО(Истина);
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьСотрудникаСервиса(Организация, Истина);

	Итог = ИИОК_Настройка.Итог(СводкаДо);

	ЮТест.ОжидаетЧто(Итог).НеИмеетСвойства("cancelled");
	ЮТест.ОжидаетЧто(Итог.setup_done).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.hint).Содержит("kedo_invite");

КонецПроцедуры

Процедура МастерОткрытКСрокуЭтоFormOpen() Экспорт

	Итог = ИИОК_Настройка.Итог(ИИОК_Настройка.СводкаСнимка(), Истина);

	ЮТест.ОжидаетЧто(Итог.form_open).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог).НеИмеетСвойства("cancelled");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаОрганизации(Снимок, Организация)

	Строка = Снимок.Организации.Найти(Организация.Ссылка, "ОрганизацияКЭДО");
	ЮТест.ОжидаетЧто(Строка, "организация теста в снимке").Заполнено();
	Возврат Строка;

КонецФункции

Процедура ПропуститьЕслиНастроено()

	Если ИИОК_Настройка.Снимок().Настроено Тогда
		ЮТест.Пропустить("КЭДО на стенде уже настроено: признак «не настроено» не проверить");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
