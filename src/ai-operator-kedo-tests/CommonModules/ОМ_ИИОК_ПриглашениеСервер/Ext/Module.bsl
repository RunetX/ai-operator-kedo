// Тесты kedo_invite на сервере: проверки до открытия формы КЭДО и итог после ее закрытия.
// Форму и кнопку «Пригласить» тесты не трогают: отправку приглашения формой заменяет запись
// приглашения, как ее делает КЭДО. Все создается в транзакции, после теста она откатывается.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТестовыйНабор("Проверки до открытия формы")
		.ДобавитьТест("БезРазрешенияПриглашениеЗапрещено")
		.ДобавитьТест("НеСотрудникиИПустойСписокОтклоняются")
		.ДобавитьТестовыйНабор("Кого приглашать")
		.ДобавитьТест("ПриглашаютсяНеподключенныеИСПросроченнымПриглашением")
		.ДобавитьТест("ПриглашенныеИПодключенныеПропускаются")
		.ДобавитьТест("УволенныйПропускается")
		.ДобавитьТестовыйНабор("Итог после формы")
		.ДобавитьТест("ФормаЗакрытаБезОтправкиЭтоОтмена")
		.ДобавитьТест("ОтправленноеПриглашениеВидноВИтоге")
		.ДобавитьТест("ПоСрокуФормаОстаетсяОткрытой");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура БезРазрешенияПриглашениеЗапрещено() Экспорт

	ОМ_ИИОК_Данные.УстановитьРазрешение("kedo_invite", Ложь);
	Сотрудник = НеподключенныйСотрудник();

	Ответ = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Аргументы(Сотрудник));

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("ACTION_DENIED");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("kedo_invite");

КонецПроцедуры

Процедура НеСотрудникиИПустойСписокОтклоняются() Экспорт

	Разрешить();

	Ответ = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Новый Структура("employees",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Справочник.Организации:" + Новый УникальныйИдентификатор)));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "не сотрудник").Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("Не сотрудник");

	Ответ = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Новый Структура("employees", Новый Массив));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "пустой список").Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("kedo_employees");

	// Модель может передать сотрудников объектами из ответа kedo_employees.
	Сотрудник = НеподключенныйСотрудник();
	Ответ = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Новый Структура("employees",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("ref", Сотрудник.Ссылка))));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), "сотрудник объектом").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.Строки).ИмеетДлину(1);

КонецПроцедуры

Процедура ПриглашаютсяНеподключенныеИСПросроченнымПриглашением() Экспорт

	Разрешить();
	Неприглашен = НеподключенныйСотрудник();
	Просрочен = НеподключенныйСотрудник(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Неприглашен.Сотрудник));
	Приглашение = ОМ_ИИОК_Данные.Пригласить(Просрочен, Истина);

	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Аргументы(Неприглашен, Просрочен));

	ЮТест.ОжидаетЧто(Подготовка.Пропущены).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Подготовка.Строки).ИмеетДлину(2);
	// Строки для формы КЭДО - как их готовят «Текущие дела КЭДО»: повторное приглашение ссылается на прежнее.
	Строка = СтрокаСотрудника(Подготовка.Строки, Просрочен);
	ЮТест.ОжидаетЧто(Строка.ПриглашениеID, "прежнее приглашение").Равно(Приглашение);
	ЮТест.ОжидаетЧто(Строка.ОрганизацияID).Равно(Просрочен.ОрганизацияID);
	ЮТест.ОжидаетЧто(Строка.ОрганизацияВ1С).Равно(Просрочен.Организация);
	ЮТест.ОжидаетЧто(Строка.card_id).Заполнено();
	ЮТест.ОжидаетЧто(СтрокаСотрудника(Подготовка.Строки, Неприглашен).ПриглашениеID, "без приглашения").Равно("");

КонецПроцедуры

Процедура ПриглашенныеИПодключенныеПропускаются() Экспорт

	Разрешить();
	Приглашен = НеподключенныйСотрудник();
	ОМ_ИИОК_Данные.Пригласить(Приглашен);
	Подключен = НеподключенныйСотрудник(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Приглашен.Сотрудник));
	ОМ_ИИОК_Данные.Подключить(Подключен);

	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Аргументы(Приглашен, Подключен));

	ЮТест.ОжидаетЧто(Подготовка.Строки).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Причина(Подготовка.Пропущены, Приглашен)).Равно("invited");
	ЮТест.ОжидаетЧто(Причина(Подготовка.Пропущены, Подключен)).Равно("connected");

КонецПроцедуры

Процедура УволенныйПропускается() Экспорт

	Разрешить();
	Уволен = ОМ_ИИОК_Данные.УволенныйСотрудник();
	Если Уволен = Неопределено Тогда
		ЮТест.Пропустить("На стенде нет уволенных сотрудников в организации КЭДО");
	КонецЕсли;

	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьПриглашение(Аргументы(Уволен));

	ЮТест.ОжидаетЧто(Подготовка.Строки).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Причина(Подготовка.Пропущены, Уволен)).Равно("dismissed");

КонецПроцедуры

Процедура ФормаЗакрытаБезОтправкиЭтоОтмена() Экспорт

	Сотрудник = НеподключенныйСотрудник();

	Итог = ИИОК_КЭДОВызовСервера.ИтогПриглашения(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Сотрудник), Новый Массив);

	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.invited).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Итог.not_invited).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Итог.not_invited[0].kedo_status).Равно("not_connected");
	ЮТест.ОжидаетЧто(Итог).НеИмеетСвойства("form_open");
	// Без подсказки младшие модели читают opened: true как «форма открыта» и просят нажать «Пригласить».
	ЮТест.ОжидаетЧто(Итог.hint).Содержит("закрыл форму");
	ЮТест.ОжидаетЧто(Итог).НеИмеетСвойства("opened");

КонецПроцедуры

Процедура ОтправленноеПриглашениеВидноВИтоге() Экспорт

	Отправлен = НеподключенныйСотрудник();
	НеОтправлен = НеподключенныйСотрудник(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отправлен.Сотрудник));
	// Форма КЭДО записывает приглашение в базу сразу при отправке.
	ОМ_ИИОК_Данные.Пригласить(Отправлен);
	Пропуск = Новый Структура("employee, reason", НеОтправлен.Сотрудник, "no_invite_rights");

	Итог = ИИОК_КЭДОВызовСервера.ИтогПриглашения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отправлен.Сотрудник),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Пропуск));

	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Итог.invited).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Итог.invited[0].ref).Равно(Отправлен.Ссылка);
	ЮТест.ОжидаетЧто(Итог.skipped).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Итог.skipped[0].reason).Равно("no_invite_rights");

КонецПроцедуры

Процедура ПоСрокуФормаОстаетсяОткрытой() Экспорт

	Сотрудник = НеподключенныйСотрудник();

	Итог = ИИОК_КЭДОВызовСервера.ИтогПриглашения(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Сотрудник), Новый Массив, Истина);

	// Пользователь еще может пригласить: это не отмена, и модель не должна открывать форму снова.
	ЮТест.ОжидаетЧто(Итог.cancelled).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Итог.form_open).ЭтоИстина();
	ЮТест.ОжидаетЧто(Итог.hint).Содержит("Не открывай её снова");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Разрешить()

	ОМ_ИИОК_Данные.УстановитьРазрешение("kedo_invite", Истина);

КонецПроцедуры

Функция НеподключенныйСотрудник(Кроме = Неопределено)

	Сотрудник = ОМ_ИИОК_Данные.НеподключенныйСотрудник(Кроме);
	Если Сотрудник = Неопределено Тогда
		ЮТест.Пропустить("На стенде нет неподключённых к КЭДО сотрудников");
	КонецЕсли;
	Возврат Сотрудник;

КонецФункции

Функция Аргументы(Сотрудник1, Сотрудник2 = Неопределено)

	Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник1.Ссылка);
	Если Сотрудник2 <> Неопределено Тогда
		Ссылки.Добавить(Сотрудник2.Ссылка);
	КонецЕсли;
	Возврат Новый Структура("employees", Ссылки);

КонецФункции

Функция СтрокаСотрудника(Строки, Сотрудник)

	Для Каждого Строка Из Строки Цикл
		Если Строка.СотрудникВ1С = Сотрудник.Сотрудник Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет строки для формы КЭДО по сотруднику";

КонецФункции

Функция Причина(Пропущены, Сотрудник)

	Для Каждого Пропуск Из Пропущены Цикл
		Если Пропуск.employee = Сотрудник.Сотрудник Тогда
			Возврат Пропуск.reason;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
