// Тесты kedo_employees: статус сотрудника в КЭДО, отбор и ответ для модели.
// Опираются на стенд ЗУП с расширением КЭДО: в организации, сопоставленной в КЭДО, есть неподключённые
// сотрудники. Приглашения и сотрудников сервиса тесты создают в транзакции, после теста она откатывается.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТестовыйНабор("Статус в КЭДО")
		.ДобавитьТест("СтатусСчитаетсяКакВТекущихДелах")
		.ДобавитьТест("УдаленныйВСервисеСотрудникНеПодключен")
		.ДобавитьТестовыйНабор("Отбор")
		.ДобавитьТест("ОтборПоСтатусуОставляетТолькоЭтотСтатус")
		.ДобавитьТест("ОтборПоДатеПриемаВключаетГраницы")
		.ДобавитьТест("НекорректныеАргументыОтклоняются")
		.ДобавитьТестовыйНабор("Ответ для модели")
		.ДобавитьТест("ОтветСчитаетСтатусыИОбрезаетсяПоЛимиту")
		.ДобавитьТест("СотрудникПомечаетсяКакФИО")
		.ДобавитьТест("ПреднастройкаПакетаМаскируетДанныеСервиса");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СтатусСчитаетсяКакВТекущихДелах() Экспорт

	Сотрудник = НеподключенныйСотрудник();
	ЮТест.ОжидаетЧто(Статус(Сотрудник), "без приглашения").Равно("not_connected");

	ОМ_ИИОК_ДанныеВызовСервера.Пригласить(Сотрудник, Истина);
	ЮТест.ОжидаетЧто(Статус(Сотрудник), "только просроченное приглашение").Равно("invite_expired");

	// Хотя бы одно действующее приглашение — сотрудник приглашён.
	ОМ_ИИОК_ДанныеВызовСервера.Пригласить(Сотрудник);
	ЮТест.ОжидаетЧто(Статус(Сотрудник), "есть действующее приглашение").Равно("invited");

	// Сотрудник сервиса, связанный с сотрудником 1С, важнее приглашений.
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник);
	ЮТест.ОжидаетЧто(Статус(Сотрудник), "связан с сотрудником сервиса").Равно("connected");

КонецПроцедуры

Процедура УдаленныйВСервисеСотрудникНеПодключен() Экспорт

	Уволенный = НеподключенныйСотрудник();
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Уволенный,
		Новый Структура("deleted_at", ТекущаяДатаСеанса() - 86400));
	Увольняемый = НеподключенныйСотрудник(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Уволенный.Сотрудник));
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Увольняемый,
		Новый Структура("deleted_at", ТекущаяДатаСеанса() + 86400));

	ЮТест.ОжидаетЧто(Статус(Уволенный), "удалён в сервисе вчера").Равно("not_connected");
	ЮТест.ОжидаетЧто(Статус(Увольняемый), "удаляется в сервисе завтра").Равно("connected");

КонецПроцедуры

Процедура ОтборПоСтатусуОставляетТолькоЭтотСтатус() Экспорт

	Сотрудник = НеподключенныйСотрудник();
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник);

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("status", "connected"));

	ЮТест.ОжидаетЧто(Ссылки(Ответ.employees), "подключённый тестом").Содержит(Сотрудник.Ссылка);
	ЮТест.ОжидаетЧто(Ответ.employees).КаждыйЭлементСодержитСвойствоСоЗначением("kedo_status", "connected");
	ЮТест.ОжидаетЧто(Ответ.by_status.not_connected).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.source.status).Содержит("connected");

КонецПроцедуры

Процедура ОтборПоДатеПриемаВключаетГраницы() Экспорт

	ДатаПриема = Дата(1, 1, 1);
	Для Каждого Строка Из ИИОК_КЭДО.ДанныеСотрудников(ИИОК_КЭДО.НовыйОтбор()) Цикл
		Если ЗначениеЗаполнено(Строка.ДатаПриема) Тогда
			ДатаПриема = Строка.ДатаПриема;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(ДатаПриема) Тогда
		ЮТест.Пропустить("На стенде нет сотрудников КЭДО с датой приёма");
	КонецЕсли;
	День = Формат(ДатаПриема, "ДФ=yyyy-MM-dd");

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("hired_from, hired_to", День, День));

	ЮТест.ОжидаетЧто(Ответ.count).Больше(0);
	Для Каждого Описание Из Ответ.employees Цикл
		ЮТест.ОжидаетЧто(Лев(Описание.hired, 10), "дата приёма в отборе").Равно(День);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Ответ.source).ИмеетСвойство("hired_from");
	ЮТест.ОжидаетЧто(Ответ.source).ИмеетСвойство("hired_to");

КонецПроцедуры

Процедура НекорректныеАргументыОтклоняются() Экспорт

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("hired_from", "вчера"));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "дата").Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("hired_from");

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("status", "active"));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "статус").Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("not_connected");

	Сотрудник = НеподключенныйСотрудник();
	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("organization", Сотрудник.Ссылка));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "организация").Равно("INVALID_ARGUMENT");

	// Модель может передать статусы строкой через запятую.
	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("status", "invited, connected"));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), "статусы строкой").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.by_status.not_connected).Равно(0);

КонецПроцедуры

Процедура ОтветСчитаетСтатусыИОбрезаетсяПоЛимиту() Экспорт

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("limit", 1));

	ЮТест.ОжидаетЧто(Ответ.employees).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Ответ.count).Больше(1);
	ЮТест.ОжидаетЧто(Ответ.truncated).ЭтоИстина();
	Всего = 0;
	Для Каждого КлючИЗначение Из Ответ.by_status Цикл
		Всего = Всего + КлючИЗначение.Значение;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Всего, "сумма by_status").Равно(Ответ.count);
	ЮТест.ОжидаетЧто(Ответ.source.data).Содержит("Текущих делах КЭДО");

КонецПроцедуры

Процедура СотрудникПомечаетсяКакФИО() Экспорт

	Ответ = ИИОК_КЭДОВызовСервера.Сотрудники(Новый Структура("limit", 5));

	ЮТест.ОжидаетЧто(Ответ.employees).Заполнено();
	Для Каждого Описание Из Ответ.employees Цикл
		ЮТест.ОжидаетЧто(Описание.employee.ref).НачинаетсяС("Справочник.Сотрудники:");
		// По пометке клиентское ядро заменит представление токеном.
		ЮТест.ОжидаетЧто(Описание.employee.pii, "пометка ПДн сотрудника").НачинаетсяС("ФИО");
	КонецЦикла;

КонецПроцедуры

// Преднастройка пакета подмешивается к преднастройке ядра (ИИО_Пакеты): данные сервиса КЭДО в базе тоже ПДн.
Процедура ПреднастройкаПакетаМаскируетДанныеСервиса() Экспорт

	ЮТест.ОжидаетЧто(ИИО_Маскирование.ВидПДнПоля("РегистрСведений.КЭДО_Invites", "email")).Равно("Email");
	ЮТест.ОжидаетЧто(ИИО_Маскирование.ВидПДнПоля("РегистрСведений.КЭДО_Employees", "phone")).Равно("Телефон");
	ЮТест.ОжидаетЧто(ИИО_Маскирование.ВидПДнПоля("РегистрСведений.КЭДО_Employees", "birthdate")).Равно("ДатаРождения");
	ЮТест.ОжидаетЧто(ИИО_Маскирование.ВидПДнСсылки("Справочник.КонтурКэдоКарточкиСотрудников")).Равно("ФИО");
	// Преднастройка ядра для ЗУП при этом действует.
	ЮТест.ОжидаетЧто(ИИО_Маскирование.ВидПДнСсылки("Справочник.ФизическиеЛица")).НачинаетсяС("ФИО");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НеподключенныйСотрудник(Кроме = Неопределено)

	Сотрудник = ОМ_ИИОК_ДанныеВызовСервера.НеподключенныйСотрудник(Кроме);
	Если Сотрудник = Неопределено Тогда
		ЮТест.Пропустить("На стенде нет неподключённых к КЭДО сотрудников");
	КонецЕсли;
	Возврат Сотрудник;

КонецФункции

Функция Ссылки(Описания)

	Результат = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Результат.Добавить(Описание.employee.ref);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Статус(Сотрудник)

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Сотрудники = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Сотрудник);
	Отбор.ТолькоРаботающие = Ложь;
	Таблица = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	Возврат ?(Таблица.Количество() = 0, "", Таблица[0].Статус);

КонецФункции

#КонецОбласти
