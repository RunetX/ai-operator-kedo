// Инструмент kedo_familiarize: открывает штатную форму КЭДО «Отправка на ознакомление» утверждённого ЛНА
// с выбранными сотрудниками. Отправляет пользователь кнопкой в этой форме; модель получает итог после её закрытия.
// Форма берёт участников из карточки ЛНА, а параметра для них не имеет, поэтому список участников подменяется
// в полученной форме до открытия: карточка ЛНА не меняется.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента kedo_familiarize. Ответ отложен до закрытия формы КЭДО.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Ошибка или итог без открытия формы.
//  Неопределено - Форма открыта, ответ придёт после её закрытия.
Функция Ознакомить(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьОзнакомление(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовка) Тогда
		Возврат Подготовка;
	КонецЕсли;
	Если Подготовка.Участники.Количество() = 0 Тогда
		Возврат ИИОК_КЭДОВызовСервера.ИтогОзнакомления(Подготовка.ЛНА, Новый Массив, Новый Массив, Подготовка.Пропущены);
	КонецЕсли;

	Форма = Неопределено;
	Попытка
		Форма = ПолучитьФорму("Обработка.КонтурКэдоМенеджерЛНА.Форма.ФормаОтправкиНаОзнакомление",
			Новый Структура("ЛНА", Подготовка.ЛНА), , Новый УникальныйИдентификатор);
	Исключение
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета("ИИОК_ОзнакомлениеКлиент",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Форма = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_FORM",
			НСтр("ru = 'Форма отправки ЛНА на ознакомление не открылась.'"),
			НСтр("ru = 'Скажи пользователю открыть карточку ЛНА в разделе КЭДО и нажать «На ознакомление»: там видна причина.'"));
	КонецЕсли;

	Форма.УчастникиДокументооборота.Очистить();
	Для Каждого Участник Из Подготовка.Участники Цикл
		Форма.УчастникиДокументооборота.Добавить().УчастникДокументооборота = Участник;
	КонецЦикла;
	Контекст = Новый Структура("Вызов, ЛНА, Сотрудники, Участники, Пропущены", ПараметрыОбработчика.Вызов,
		Подготовка.ЛНА, Подготовка.Сотрудники, Подготовка.Участники, Подготовка.Пропущены);
	Форма.ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормы", ИИОК_ОзнакомлениеКлиент, Контекст);
	Форма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый;
	Форма.Открыть();
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	ИИО_ФормыКлиент.ОжидатьЗакрытия(Форма, ПараметрыОбработчика.Вызов,
		Новый ОписаниеОповещения("ИтогПоСроку", ИИОК_ОзнакомлениеКлиент, Контекст));
	Возврат Неопределено;

КонецФункции

// Итог kedo_familiarize, если пользователь не закрыл форму КЭДО к сроку: форма остаётся открытой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Открытая форма КЭДО.
//  Контекст - Структура - Вызов, ЛНА, Сотрудники, Участники, Пропущены.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция ИтогПоСроку(Форма, Контекст) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.ИтогОзнакомления(Контекст.ЛНА, Контекст.Сотрудники, Контекст.Участники,
		Контекст.Пропущены, Истина);

КонецФункции

// Завершает вызов kedo_familiarize после закрытия формы КЭДО.
//
// Параметры:
//  Результат - Произвольный - Результат закрытия формы (форма КЭДО его не возвращает).
//  Контекст - Структура - Вызов, ЛНА, Сотрудники, Участники, Пропущены.
Процедура ПослеЗакрытияФормы(Результат, Контекст) Экспорт

	ИИО_РеестрИнструментовКлиент.Завершить(Контекст.Вызов, ИИОК_КЭДОВызовСервера.ИтогОзнакомления(Контекст.ЛНА,
		Контекст.Сотрудники, Контекст.Участники, Контекст.Пропущены));

КонецПроцедуры

#КонецОбласти
