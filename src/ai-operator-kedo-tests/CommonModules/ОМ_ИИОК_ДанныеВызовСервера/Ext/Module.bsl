// Тестовые данные для клиентских тестов пакета ИИОператор_КЭДО: у клиентских тестов нет транзакций, поэтому
// отсюда доступны только чтение и разрешение действия текущему пользователю с возвратом прежнего значения.
// Данные КЭДО для серверных тестов пишет ОМ_ИИОК_Данные.

#Область СлужебныйПрограммныйИнтерфейс

// Запрещает действие текущему пользователю. Для клиентских тестов: прежнее значение вернуть ВернутьРазрешение.
//
// Параметры:
//  Действие - Строка
//
// Возвращаемое значение:
//  Булево, Неопределено - Прежнее значение записи на пользователя; Неопределено - записи не было.
Функция ЗапретитьДействие(Действие) Экспорт

	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Действие = Действие;
	Запись.Прочитать();
	Прежнее = ?(Запись.Выбран(), Запись.Разрешено, Неопределено);
	ОМ_ИИОК_Данные.УстановитьРазрешение(Действие, Ложь);
	Возврат Прежнее;

КонецФункции

// Возвращает запись разрешения, которую изменил ЗапретитьДействие.
//
// Параметры:
//  Действие - Строка
//  Прежнее - Булево, Неопределено - Результат ЗапретитьДействие.
Процедура ВернутьРазрешение(Действие, Прежнее) Экспорт

	Если Прежнее <> Неопределено Тогда
		ОМ_ИИОК_Данные.УстановитьРазрешение(Действие, Прежнее);
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Действие = Действие;
	Запись.Удалить();

КонецПроцедуры

// Строковые ссылки сотрудников организаций КЭДО, как их передает модель.
//
// Параметры:
//  Количество - Число
//
// Возвращаемое значение:
//  Массив из Строка
Функция СсылкиСотрудников(Количество) Экспорт

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Результат = Новый Массив;
	Для Каждого Строка Из ИИОК_КЭДО.ДанныеСотрудников(Отбор) Цикл
		Если Результат.Количество() = Количество Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ИИО_Ответ.СсылкаВСтроку(Строка.Сотрудник));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена людей за ссылками сотрудников: наименование сотрудника, ФИО физического лица и фамилия.
// Нужны клиентским тестам, чтобы проверить, что имена не ушли модели; в сообщения тестов их не выводить.
//
// Параметры:
//  Ссылки - Массив из Строка - Ссылки вида Справочник.Сотрудники:<УИД>.
//
// Возвращаемое значение:
//  Массив из Строка
Функция ИменаСотрудников(Ссылки) Экспорт

	Сотрудники = Новый Массив;
	Для Каждого Идентификатор Из Ссылки Цикл
		Сотрудники.Добавить(ИИО_Ответ.СсылкаИзСтроки(Идентификатор));
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Наименование КАК Наименование,
	|	Сотрудники.ФизическоеЛицо.ФИО КАК ФИО
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&Сотрудники)";
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	Имена = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Фамилия = СтрРазделить(СокрЛП(Выборка.ФИО) + " ", " ", Ложь)[0];
		Для Каждого Имя Из СтрРазделить(Выборка.Наименование + Символы.ПС + Выборка.ФИО + Символы.ПС + Фамилия,
			Символы.ПС, Ложь) Цикл
			Если СтрДлина(СокрЛП(Имя)) >= 3 И Имена.Найти(СокрЛП(Имя)) = Неопределено Тогда
				Имена.Добавить(СокрЛП(Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти
