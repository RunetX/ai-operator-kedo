// Пакет ИИ-оператора для Контур.КЭДО. Инструменты работают поверх поставляемого расширения КЭДО:
// отбирают сотрудников по данным ЗУП и открывают штатные формы КЭДО. В сервис КЭДО пакет сам не обращается.

#Область ПрограммныйИнтерфейс

// Регистрирует инструменты пакета в реестре ядра (см. ИИО_Пакеты). Вызывается ядром.
// Без расширения КЭДО в базе инструменты не регистрируются.
//
// Параметры:
//  Инструменты - Массив из см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент
Процедура ПриРегистрацииИнструментов(Инструменты) Экспорт

	ПараметрыРегистрации = ИИОК_КЭДОВызовСервера.ПараметрыРегистрации();
	Если Не ПараметрыРегистрации.РасширениеКЭДО Тогда
		Возврат;
	КонецЕсли;

	Статусы = ПараметрыРегистрации.Статусы;
	СвойствоСтатусов = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Статусы в КЭДО для отбора: not_connected - не подключен, invited - приглашение отправлено, "
		+ "invite_expired - приглашение просрочено, connected - подключен. По умолчанию все.");
	СвойствоСтатусов.Вставить("items", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string", "Статус.", Статусы));
	Свойства = Новый Структура;
	Свойства.Вставить("hired_from", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Приняты не раньше этой даты, ISO 8601 (2026-09-01)."));
	Свойства.Вставить("hired_to", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Приняты не позже этой даты, ISO 8601 (2026-09-30)."));
	Свойства.Вставить("status", СвойствоСтатусов);
	Свойства.Вставить("organization", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Организация: ref из ответа инструмента (Справочник.Организации:<УИД>). По умолчанию все организации, сопоставленные в КЭДО."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько сотрудников вернуть, по умолчанию 100, не больше 500."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_employees",
		Новый ОписаниеОповещения("Сотрудники", ИИОК_ПакетКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства)));

	СвойствоСотрудников = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Сотрудники из ответа kedo_employees: строки ref (Справочник.Сотрудники:<УИД>) или объекты {""ref"": ...}.");
	СвойствоСотрудников.Вставить("items", Новый Структура);
	Свойства = Новый Структура;
	Свойства.Вставить("employees", СвойствоСотрудников);
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_invite",
		Новый ОписаниеОповещения("Пригласить", ИИОК_ПриглашениеКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "employees"), Истина));

	СвойствоСотрудников = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Сотрудники: строки ref (Справочник.Сотрудники:<УИД>) из ответа kedo_employees или find_ref, не больше 50. "
		+ "Без них - проверка организаций и сводка по всем работающим сотрудникам.");
	СвойствоСотрудников.Вставить("items", Новый Структура);
	Свойства = Новый Структура;
	Свойства.Вставить("employees", СвойствоСотрудников);
	Свойства.Вставить("organization", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Организация для сводки: ref (Справочник.Организации:<УИД>). По умолчанию все организации, сопоставленные в КЭДО."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_diagnose",
		Новый ОписаниеОповещения("Диагностика", ИИОК_ПакетКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства)));

	Свойства = Новый Структура;
	Свойства.Вставить("open", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("boolean",
		"true - подключить КЭДО: вход в сервис и «Подключить» или мастер КЭДО. Без open - состояние настройки."));
	Свойства.Вставить("wizard", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("boolean",
		"true вместе с open - открыть штатный мастер КЭДО вместо подключения одной кнопкой."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_setup",
		Новый ОписаниеОповещения("Настроить", ИИОК_НастройкаКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства), Истина));

	Если Не ПараметрыРегистрации.ЛНА Тогда
		Возврат;
	КонецЕсли;
	Свойства = Новый Структура;
	Свойства.Вставить("text", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Часть наименования ЛНА, например «персональных данных»."));
	Свойства.Вставить("document", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"ЛНА из ответа kedo_documents: вернуть его с ознакомлением по каждому сотруднику."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько ЛНА вернуть, по умолчанию 50, не больше 200."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_documents",
		Новый ОписаниеОповещения("Документы", ИИОК_ПакетКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства)));

	СвойствоСотрудников = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Сотрудники из ответа kedo_employees: строки ref (Справочник.Сотрудники:<УИД>).");
	СвойствоСотрудников.Вставить("items", Новый Структура);
	Свойства = Новый Структура;
	Свойства.Вставить("document", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Утвержденный ЛНА из ответа kedo_documents."));
	Свойства.Вставить("employees", СвойствоСотрудников);
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("kedo_familiarize",
		Новый ОписаниеОповещения("Ознакомить", ИИОК_ОзнакомлениеКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "document,employees"), Истина));

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента kedo_employees.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Сотрудники(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.Сотрудники(ПараметрыОбработчика.Аргументы);

КонецФункции

// Обработчик инструмента kedo_diagnose.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Диагностика(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.Диагностика(ПараметрыОбработчика.Аргументы);

КонецФункции

// Обработчик инструмента kedo_documents.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Документы(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.Документы(ПараметрыОбработчика.Аргументы);

КонецФункции

#КонецОбласти
