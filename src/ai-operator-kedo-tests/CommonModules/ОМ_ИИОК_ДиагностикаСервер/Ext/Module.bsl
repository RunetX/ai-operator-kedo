// Тесты kedo_diagnose на сервере: причины, по которым КЭДО не работает у сотрудника, и сводка по организации.
// Состояние сотрудника в КЭДО тесты создают в транзакции: приглашения, сотрудников
// сервиса, сертификаты и записи синхронизации, как их записывает расширение КЭДО. После теста транзакция откатывается.
// Берутся неподключённые сотрудники без почты и телефона в 1С: тогда данные сервиса совпадают с 1С без подбора.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТестовыйНабор("Аргументы")
		.ДобавитьТест("НекорректныеАргументыОтклоняются")
		.ДобавитьТестовыйНабор("Проблемы сотрудника")
		.ДобавитьТест("НеподключенногоБезКонтактовНеПригласить")
		.ДобавитьТест("ПриглашениеЖдетПринятияИСверяетсяС1С")
		.ДобавитьТест("ПодключенныйБезРасхожденийВПорядке")
		.ДобавитьТест("РасхожденияСервисаИ1СНазываютсяПолями")
		.ДобавитьТест("СрокиПодписиПроверяются")
		.ДобавитьТест("ТотЖеЧеловекВСервисеБезСвязиНаходитсяПоФИО")
		.ДобавитьТест("ОшибкаПередачиДанныхИдетВКонтекстПДн")
		.ДобавитьТестовыйНабор("Сводка")
		.ДобавитьТест("СводкаПоОрганизациямСПримерамиИОграничениями");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура НекорректныеАргументыОтклоняются() Экспорт

	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("employees",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Справочник.Организации:" + Новый УникальныйИдентификатор)));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "не сотрудник").Равно("INVALID_ARGUMENT");

	Сотрудник = НеподключенныйСотрудник();
	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("organization", Сотрудник.Ссылка));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "не организация").Равно("INVALID_ARGUMENT");

	Много = Новый Массив;
	Для Номер = 1 По 51 Цикл
		Много.Добавить(Сотрудник.Ссылка);
	КонецЦикла;
	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("employees", Много));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "больше 50").Равно("INVALID_ARGUMENT");
	// Для всех сотрудников есть сводка без employees.
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("без employees");

КонецПроцедуры

Процедура НеподключенногоБезКонтактовНеПригласить() Экспорт

	Сотрудник = СотрудникБезКонтактов();

	Описание = Диагностика(Сотрудник);

	ЮТест.ОжидаетЧто(Описание.kedo_status).Равно("not_connected");
	ЮТест.ОжидаетЧто(Описание.ok).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Коды(Описание)).Содержит("not_connected");
	ЮТест.ОжидаетЧто(Коды(Описание)).Содержит("no_invite_contact");
	ЮТест.ОжидаетЧто(Проблема(Описание, "not_connected").severity).Равно("blocker");
	// Исправление называет инструмент, но отправляет приглашение пользователь.
	ЮТест.ОжидаетЧто(Проблема(Описание, "not_connected").fix).Содержит("kedo_invite");

КонецПроцедуры

Процедура ПриглашениеЖдетПринятияИСверяетсяС1С() Экспорт

	Сотрудник = СотрудникБезКонтактов();
	ОМ_ИИОК_ДанныеВызовСервера.Пригласить(Сотрудник, Ложь, Новый Структура("ФИО", "Тестов Тест Тестович"));

	Описание = Диагностика(Сотрудник);

	ЮТест.ОжидаетЧто(Описание.kedo_status).Равно("invited");
	ЮТест.ОжидаетЧто(Проблема(Описание, "invite_pending").severity).Равно("warning");
	ЮТест.ОжидаетЧто(Проблема(Описание, "invite_pending").text).Содержит("по почте");
	Расхождение = Проблема(Описание, "data_mismatch");
	ЮТест.ОжидаетЧто(Расхождение.facts.fields).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Расхождение.facts.fields).Содержит("fio");
	ЮТест.ОжидаетЧто(Расхождение.fix).Содержит("отзовите его и отправьте заново");

КонецПроцедуры

Процедура ПодключенныйБезРасхожденийВПорядке() Экспорт

	Сотрудник = СотрудникБезКонтактов();
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник);
	ОМ_ИИОК_ДанныеВызовСервера.ЗаписатьСинхронизацию(Сотрудник.Сотрудник, "");

	Описание = Диагностика(Сотрудник);

	ЮТест.ОжидаетЧто(Описание.kedo_status).Равно("connected");
	ЮТест.ОжидаетЧто(Описание.ok, СтрСоединить(Коды(Описание), ", ")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Коды(Описание)).НеСодержит("data_mismatch");

КонецПроцедуры

Процедура РасхожденияСервисаИ1СНазываютсяПолями() Экспорт

	Сотрудник = СотрудникБезКонтактов();
	ДругаяДата = ?(Сотрудник.ДатаРождения = Дата(1970, 1, 1), Дата(1971, 1, 1), Дата(1970, 1, 1));
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник,
		Новый Структура("ФИО, birthdate", "Тестов Тест Тестович", ДругаяДата));

	Описание = Диагностика(Сотрудник);

	Расхождение = Проблема(Описание, "data_mismatch");
	ЮТест.ОжидаетЧто(Расхождение.facts.fields).Содержит("fio");
	ЮТест.ОжидаетЧто(Расхождение.facts.fields).Содержит("birthdate");
	ЮТест.ОжидаетЧто(Расхождение.facts.fields).НеСодержит("email");
	ЮТест.ОжидаетЧто(Расхождение.text).Содержит("ФИО, дата рождения");
	ЮТест.ОжидаетЧто(Расхождение.fix).Содержит("Передать в КЭДО данные");

КонецПроцедуры

Процедура СрокиПодписиПроверяются() Экспорт

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Варианты = Новый Соответствие;
	Варианты.Вставить("", "no_certificate");
	Варианты.Вставить("НЭП до " + ФорматДаты(Сегодня - 86400), "certificate_expired");
	Варианты.Вставить("НЭП до " + ФорматДаты(Сегодня + 10 * 86400), "certificate_expiring");
	// Истёкший сертификат не мешает, если есть действующий.
	Варианты.Вставить("НЭП до " + ФорматДаты(Сегодня - 86400) + ", КЭП до " + ФорматДаты(Сегодня + 100 * 86400), "");

	Выбраны = Новый Массив;
	Ссылки = Новый Массив;
	Ожидания = Новый Соответствие;
	Для Каждого Вариант Из Варианты Цикл
		Сотрудник = СотрудникБезКонтактов(Выбраны);
		Выбраны.Добавить(Сотрудник.Сотрудник);
		ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник, Новый Структура("СертификатыЭП", Вариант.Ключ));
		Ссылки.Добавить(Сотрудник.Ссылка);
		Ожидания.Вставить(Сотрудник.Ссылка, Вариант);
	КонецЦикла;

	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("employees", Ссылки));

	ЮТест.ОжидаетЧто(Ответ.employees).ИмеетДлину(Варианты.Количество());
	Для Каждого Описание Из Ответ.employees Цикл
		Вариант = Ожидания.Получить(Описание.employee.ref);
		КодыПроблем = Коды(Описание);
		Для Каждого Код Из СтрРазделить("no_certificate,certificate_expired,certificate_expiring", ",") Цикл
			Если Код = Вариант.Значение Тогда
				ЮТест.ОжидаетЧто(КодыПроблем, "«" + Вариант.Ключ + "»").Содержит(Код);
			Иначе
				ЮТест.ОжидаетЧто(КодыПроблем, "«" + Вариант.Ключ + "»").НеСодержит(Код);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ТотЖеЧеловекВСервисеБезСвязиНаходитсяПоФИО() Экспорт

	Сотрудник = СотрудникБезКонтактов();
	// ФИО сравниваются без учёта регистра, «ё» и лишних пробелов.
	ФИОВСервисе = СтрЗаменить(ВРег(СтрЗаменить(Сотрудник.ФИО, "е", "ё")), " ", "  ");
	ОМ_ИИОК_ДанныеВызовСервера.ДобавитьНесвязанногоВСервисе(Сотрудник.ОрганизацияID, ФИОВСервисе);

	Описание = Диагностика(Сотрудник);

	ЮТест.ОжидаетЧто(Проблема(Описание, "probably_unlinked").severity).Равно("warning");
	ЮТест.ОжидаетЧто(Проблема(Описание, "probably_unlinked").fix).Содержит("Установить связь");

КонецПроцедуры

Процедура ОшибкаПередачиДанныхИдетВКонтекстПДн() Экспорт

	Сотрудник = СотрудникБезКонтактов();
	ОМ_ИИОК_ДанныеВызовСервера.Подключить(Сотрудник);
	ОМ_ИИОК_ДанныеВызовСервера.ЗаписатьСинхронизацию(Сотрудник.Сотрудник,
		"Не заполнен СНИЛС у сотрудника " + Сотрудник.ФИО);

	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("employees",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Ссылка)));

	ЮТест.ОжидаетЧто(Коды(Ответ.employees[0])).Содержит("sync_error");
	// Текст ошибки КЭДО содержит ФИО: оно уходит в pii_context, и клиентское ядро заменит его токеном.
	Значения = Новый Массив;
	Для Каждого Значение Из Ответ.pii_context Цикл
		Значения.Добавить(Значение.value);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Значения.Найти(Сотрудник.ФИО) <> Неопределено, "ФИО сотрудника в pii_context").ЭтоИстина();

КонецПроцедуры

Процедура СводкаПоОрганизациямСПримерамиИОграничениями() Экспорт

	НеподключенныйСотрудник();

	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура);

	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("employees");
	ЮТест.ОжидаетЧто(Ответ.organizations).Заполнено();
	ЮТест.ОжидаетЧто(Ответ.employees_checked).Больше(0);
	КодыПроблем = Новый Массив;
	Для Каждого Итог Из Ответ.employee_problems Цикл
		КодыПроблем.Добавить(Итог.code);
		ЮТест.ОжидаетЧто(Итог.count, Итог.code).Больше(0);
		ЮТест.ОжидаетЧто(Итог.employees.Количество(), Итог.code).МеньшеИлиРавно(10);
		ЮТест.ОжидаетЧто(Итог.text, Итог.code).Заполнено();
	КонецЦикла;
	ЮТест.ОжидаетЧто(КодыПроблем).Содержит("not_connected");
	ЮТест.ОжидаетЧто(Ответ.kedo_extension.version).Заполнено();
	// Модель не должна утверждать то, что не проверялось.
	ЮТест.ОжидаетЧто(Ответ.limits).Содержит("без обращения к сервису КЭДО");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НеподключенныйСотрудник()

	Сотрудник = ОМ_ИИОК_ДанныеВызовСервера.НеподключенныйСотрудник();
	Если Сотрудник = Неопределено Тогда
		ЮТест.Пропустить("На стенде нет неподключённых к КЭДО сотрудников");
	КонецЕсли;
	Возврат Сотрудник;

КонецФункции

Функция СотрудникБезКонтактов(Кроме = Неопределено)

	Сотрудник = ОМ_ИИОК_ДанныеВызовСервера.НеподключенныйСотрудник(Кроме, Ложь);
	Если Сотрудник = Неопределено Тогда
		ЮТест.Пропустить("На стенде не хватает неподключённых к КЭДО сотрудников без почты и телефона");
	КонецЕсли;
	Возврат Сотрудник;

КонецФункции

Функция Диагностика(Сотрудник)

	Ответ = ИИОК_Диагностика.Диагностика(Новый Структура("employees",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник.Ссылка)));
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), "ошибка диагностики").ЭтоЛожь();
	Возврат Ответ.employees[0];

КонецФункции

Функция Коды(Описание)

	Результат = Новый Массив;
	Для Каждого Проблема Из Описание.problems Цикл
		Результат.Добавить(Проблема.code);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Проблема(Описание, Код)

	Для Каждого Проблема Из Описание.problems Цикл
		Если Проблема.code = Код Тогда
			Возврат Проблема;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Нет проблемы %1, есть: %2", Код, СтрСоединить(Коды(Описание), ", "));

КонецФункции

Функция ФорматДаты(Дата)

	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");

КонецФункции

#КонецОбласти
