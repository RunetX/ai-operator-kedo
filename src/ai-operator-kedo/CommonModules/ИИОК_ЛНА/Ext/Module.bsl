// ЛНА расширения КЭДО: статус утверждения и ознакомление сотрудников по данным в базе.
// Статус ЛНА хранит регистр КонтурКэдоЛНАДополнительныеСведения, его пересчитывает расширение КЭДО.
// Ознакомление считается так же, как в штатной форме «Процесс ознакомления»: задачи отправки (КЭДО_СозданиеОзнакомления)
// и процессы актов, связанные с процессом утверждения ЛНА. Процессы приходят в базу из ленты изменений КЭДО.

#Область СлужебныйПрограммныйИнтерфейс

// Есть ли в установленном расширении КЭДО локальные нормативные акты и их отправка на ознакомление.
//
// Возвращаемое значение:
//  Булево
Функция ЛНАЕсть() Экспорт

	Возврат Метаданные.Справочники.Найти("КонтурКэдоЛНАЛокальныеНормативныеАкты") <> Неопределено
		И Метаданные.Обработки.Найти("КонтурКэдоМенеджерЛНА") <> Неопределено
		И Метаданные.РегистрыСведений.Найти("КЭДО_СозданиеОзнакомления") <> Неопределено;

КонецФункции

// Обработчик инструмента kedo_documents.
//
// Параметры:
//  Аргументы - Структура, Соответствие - text, document, limit.
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка.
Функция Документы(Знач Аргументы) Экспорт

	Ошибка = ОшибкаВыключенныхЛНА();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Документ = Неопределено;
	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "document");
	Если ЗначениеЗаполнено(Значение) Тогда
		Документ = ИИО_Ответ.СсылкаИзСтроки(Значение);
		Если ТипЗнч(Документ) <> Тип("СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты") Тогда
			Возврат ОшибкаНеЛНА(Значение);
		КонецЕсли;
	КонецЕсли;
	Текст = СокрЛП(Строка(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "text", "")));
	Лимит = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit"), 50, 200);

	Таблица = СписокЛНА(Текст, Документ, Лимит + 1);
	Процессы = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Статус = Перечисления.КонтурКэдоЛНАСтатусы.Утвержден Тогда
			Процессы.Вставить(Строка.ЛНА, КонтурКэдоЛНА.ПроцессКЭДОУтвержденияЛНА(Строка.ЛНА));
		КонецЕсли;
	КонецЦикла;
	Ознакомление = ОзнакомлениеПоПроцессам(Процессы);

	Список = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Список.Количество() = Лимит Тогда
			Прервать;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("document", Строка.ЛНА);
		Описание.Вставить("name", Строка.Наименование);
		Описание.Вставить("status", КодСтатуса(Строка.Статус));
		Описание.Вставить("organization", Строка.Организация);
		Если ЗначениеЗаполнено(Строка.ДатаНачала) Тогда
			Описание.Вставить("valid_from", Строка.ДатаНачала);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ДатаОкончания) Тогда
			Описание.Вставить("valid_to", Строка.ДатаОкончания);
		КонецЕсли;
		Процесс = Процессы.Получить(Строка.ЛНА);
		Если Процесс <> Неопределено Тогда
			Участники = Ознакомление.Получить(Процесс);
			Описание.Вставить("familiarization", СводкаОзнакомления(Строка.ЛНА, Участники));
			Если Документ <> Неопределено Тогда
				Описание.Вставить("participants", ?(Участники = Неопределено, Новый Массив, Участники));
			КонецЕсли;
		КонецЕсли;
		Список.Добавить(Описание);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("documents", Список);
	Ответ.Вставить("count", Список.Количество());
	Ответ.Вставить("truncated", Таблица.Количество() > Лимит);
	Источник = Новый Структура("data", НСтр("ru = 'Карточки ЛНА расширения КЭДО; статус утверждения и ознакомление — по процессам КЭДО в базе, как в форме «Процесс ознакомления». Процессы приходят в базу из ленты изменений КЭДО.'"));
	Если ЗначениеЗаполнено(Текст) Тогда
		Источник.Вставить("text", Текст);
	КонецЕсли;
	Ответ.Вставить("source", Источник);
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

// Проверяет вызов kedo_familiarize и готовит участников для формы КЭДО «Отправка на ознакомление».
// Получают ознакомление только сотрудники, подключённые к КЭДО в организации ЛНА; остальные пропускаются с причиной.
//
// Параметры:
//  Аргументы - Структура, Соответствие - document, employees.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * ЛНА - СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты
//   * Сотрудники - Массив из СправочникСсылка.Сотрудники - Кому отправляется ознакомление.
//   * Участники - Массив из СправочникСсылка.КЭДО_УчастникиДокументооборота - Их участники документооборота.
//   * Пропущены - Массив из Структура - employee, reason, kedo_status.
Функция ПодготовитьОзнакомление(Знач Аргументы) Экспорт

	Если Не ИИО_Права.ДействиеРазрешено("kedo_familiarize") Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'Пользователю не разрешено отправлять ЛНА на ознакомление через ИИ-оператора (действие kedo_familiarize).'"),
			НСтр("ru = 'Скажи пользователю попросить администратора ИИ-оператора разрешить действие kedo_familiarize.'"));
	КонецЕсли;
	Ошибка = ОшибкаВыключенныхЛНА();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "document");
	ЛНА = ИИО_Ответ.СсылкаИзСтроки(Значение);
	Если ТипЗнч(ЛНА) <> Тип("СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты") Или Не ЗначениеЗаполнено(ЛНА) Тогда
		Возврат ОшибкаНеЛНА(Значение);
	КонецЕсли;

	Таблица = СписокЛНА("", ЛНА, 1);
	Если Таблица.Количество() = 0 Тогда
		Возврат ОшибкаНеЛНА(Значение);
	КонецЕсли;
	Карточка = Таблица[0];
	Если Карточка.Статус <> Перечисления.КонтурКэдоЛНАСтатусы.Утвержден Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("LNA_NOT_APPROVED",
			СтрШаблон(НСтр("ru = 'ЛНА «%1» не утверждён в КЭДО (статус: %2). На ознакомление отправляют только утверждённый ЛНА.'"),
				Карточка.Наименование, Строка(Карточка.Статус)),
			НСтр("ru = 'Объясни это пользователю: утверждение отправляют из карточки ЛНА в разделе КЭДО, ИИ-оператор его не выполняет.'"));
	КонецЕсли;
	Если КонтурКэдоЛНА.ТекущаяВерсияЛНАОтправленаНаОзнакомление(ЛНА) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("FAMILIARIZATION_ALREADY_SENT",
			СтрШаблон(НСтр("ru = 'Текущая версия ЛНА «%1» уже отправлена на ознакомление. Добавить получателей можно в форме «Процесс ознакомления» этого ЛНА (кнопка «Добавить»); ИИ-оператор этого пока не делает.'"),
				Карточка.Наименование),
			НСтр("ru = 'Кто уже ознакомлен — kedo_documents с этим document.'"));
	КонецЕсли;

	Ссылки = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "employees", Новый Массив);
	Сотрудники = Новый Массив;
	Для Каждого Элемент Из Ссылки Цикл
		Идентификатор = Элемент;
		Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Элемент, "ref");
		КонецЕсли;
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Идентификатор);
		Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Сотрудники") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не сотрудник: %1.'"), Строка(Идентификатор)),
				НСтр("ru = 'Передай ref сотрудников из ответа kedo_employees.'"));
		КонецЕсли;
		Если Сотрудники.Найти(Ссылка) = Неопределено Тогда
			Сотрудники.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Сотрудники.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не переданы сотрудники.'"),
			НСтр("ru = 'Сначала найди сотрудников инструментом kedo_employees.'"));
	КонецЕсли;

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Сотрудники = Сотрудники;
	Отбор.ТолькоРаботающие = Ложь;
	Строки = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	Результат = Новый Структура("ЛНА, Сотрудники, Участники, Пропущены", ЛНА, Новый Массив, Новый Массив, Новый Массив);
	Для Каждого Сотрудник Из Сотрудники Цикл
		Строка = Строки.Найти(Сотрудник, "Сотрудник");
		Причина = "";
		Если Строка = Неопределено Тогда
			Причина = "not_in_kedo_organization";
		ИначеЕсли Строка.Организация <> Карточка.Организация Тогда
			Причина = "other_organization";
		ИначеЕсли ЗначениеЗаполнено(Строка.ДатаУвольнения) И Строка.ДатаУвольнения < ТекущаяДатаСеанса() Тогда
			Причина = "dismissed";
		ИначеЕсли Строка.Статус <> "connected" Тогда
			Причина = "not_connected";
		КонецЕсли;
		Участник = Неопределено;
		Если Причина = "" Тогда
			Участник = Справочники.КЭДО_УчастникиДокументооборота.ПоСотруднику1С(Сотрудник);
			Если Не ЗначениеЗаполнено(Участник) Тогда
				Причина = "not_connected";
			КонецЕсли;
		КонецЕсли;
		Если Причина = "" Тогда
			Результат.Сотрудники.Добавить(Сотрудник);
			Результат.Участники.Добавить(Участник);
		Иначе
			Пропуск = Новый Структура("employee, reason", Сотрудник, Причина);
			Если Строка <> Неопределено Тогда
				Пропуск.Вставить("kedo_status", Строка.Статус);
			КонецЕсли;
			Результат.Пропущены.Добавить(Пропуск);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Итог kedo_familiarize после закрытия формы КЭДО. Форма ничего не возвращает: при отправке она сразу
// записывает задачи создания актов (КЭДО_СозданиеОзнакомления) и отмечает версию ЛНА отправленной.
//
// Параметры:
//  ЛНА - СправочникСсылка.КонтурКэдоЛНАЛокальныеНормативныеАкты
//  Сотрудники - Массив из СправочникСсылка.Сотрудники - Открытые в форме.
//  Участники - Массив из СправочникСсылка.КЭДО_УчастникиДокументооборота - Их участники, в том же порядке.
//  Пропущены - Массив из Структура
//  ФормаОткрыта - Булево - Итог по сроку ожидания: форма ещё открыта, пользователь может отправить позже.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция ИтогОзнакомления(Знач ЛНА, Знач Сотрудники, Знач Участники, Знач Пропущены, Знач ФормаОткрыта = Ложь) Экспорт

	Отправлено = Сотрудники.Количество() > 0 И КонтурКэдоЛНА.ТекущаяВерсияЛНАОтправленаНаОзнакомление(ЛНА);
	Получатели = Новый Соответствие;
	Если Отправлено Тогда
		Процесс = КонтурКэдоЛНА.ПроцессКЭДОУтвержденияЛНА(ЛНА);
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Получатель КАК Участник
		|ИЗ
		|	РегистрСведений.КЭДО_СозданиеОзнакомления КАК Задачи
		|ГДЕ
		|	Задачи.Процесс = &Процесс
		|	И Задачи.Получатель В(&Участники)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Постоянные.Получатель
		|ИЗ
		|	РегистрСведений.КЭДО_ДанныеСвязанныхПроцессов КАК Связи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КЭДО_ДанныеПроцессовПостоянные КАК Постоянные
		|		ПО (Постоянные.ПроцессРегистратор = Связи.ПроцессРегистратор)
		|ГДЕ
		|	Связи.Процесс = &Процесс
		|	И Связи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.КЭДО_ТипСвязиПроцессов.Familiarization)
		|	И Связи.НаправлениеСвязи = ЗНАЧЕНИЕ(Перечисление.КЭДО_НаправлениеСвязиПроцесссов.Parent)
		|	И Постоянные.Получатель В(&Участники)";
		Запрос.УстановитьПараметр("Процесс", Процесс);
		Запрос.УстановитьПараметр("Участники", Участники);
		Для Каждого Участник Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Участник") Цикл
			Получатели.Вставить(Участник, Истина);
		КонецЦикла;
	КонецЕсли;

	Отправлены = Новый Массив;
	НеОтправлены = Новый Массив;
	Для Индекс = 0 По Сотрудники.ВГраница() Цикл
		Если Получатели.Получить(Участники[Индекс]) <> Неопределено Тогда
			Отправлены.Добавить(Сотрудники[Индекс]);
		Иначе
			НеОтправлены.Добавить(Сотрудники[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("document", ЛНА);
	Ответ.Вставить("opened", Сотрудники.Количество() > 0);
	Ответ.Вставить("sent", Отправлены);
	Ответ.Вставить("not_sent", НеОтправлены);
	Ответ.Вставить("skipped", Пропущены);
	Ответ.Вставить("cancelled", Сотрудники.Количество() > 0 И Не Отправлено И Не ФормаОткрыта);
	Если ФормаОткрыта Тогда
		Ответ.Вставить("form_open", Истина);
	КонецЕсли;
	Если Отправлены.Количество() > 0 Тогда
		Ответ.Вставить("hint", НСтр("ru = 'Акты ознакомления сервис КЭДО создаёт не сразу. Кто ознакомился — kedo_documents с этим document.'"));
	ИначеЕсли ФормаОткрыта Тогда
		Ответ.Вставить("hint", НСтр("ru = 'Форма ознакомления КЭДО ещё открыта: пользователь может отправить позже. Не открывай её снова; итог — kedo_documents с этим document.'"));
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаВыключенныхЛНА()

	Константа = Метаданные.Константы.Найти("КонтурКэдоИспользоватьЛНА");
	Если Константа = Неопределено Или Константы[Константа.Имя].Получить() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_LNA_DISABLED",
		НСтр("ru = 'Работа с ЛНА в расширении КЭДО выключена.'"),
		НСтр("ru = 'Скажи пользователю включить ЛНА в настройках КЭДО (настройка «Использовать ЛНА»).'"));

КонецФункции

Функция ОшибкаНеЛНА(Значение)

	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
		СтрШаблон(НСтр("ru = 'Не ЛНА КЭДО: %1.'"), Строка(Значение)),
		НСтр("ru = 'Передай document из ответа kedo_documents.'"));

КонецФункции

// Карточки ЛНА с текущим статусом.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ЛНА, Наименование, Статус, Организация, ДатаНачала, ДатаОкончания.
Функция СписокЛНА(Текст, Документ, Количество)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000
	|	Акты.Ссылка КАК ЛНА,
	|	Акты.Наименование КАК Наименование,
	|	ЕСТЬNULL(Сведения.Статус, ЗНАЧЕНИЕ(Перечисление.КонтурКэдоЛНАСтатусы.Создан)) КАК Статус,
	|	Акты.Владелец.Организация КАК Организация,
	|	Акты.ДатаНачала КАК ДатаНачала,
	|	Акты.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Справочник.КонтурКэдоЛНАЛокальныеНормативныеАкты КАК Акты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурКэдоЛНАДополнительныеСведения КАК Сведения
	|		ПО (Сведения.ЛНА = Акты.Ссылка)
	|ГДЕ
	|	НЕ Акты.ПометкаУдаления
	|	И НЕ Акты.ЭтоГруппа
	|	И (&Текст = """"
	|			ИЛИ Акты.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
	|	И (НЕ &ОтборПоЛНА
	|			ИЛИ Акты.Ссылка = &ЛНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000", "ПЕРВЫЕ " + Формат(Количество, "ЧГ="));
	Запрос.УстановитьПараметр("Текст", Текст);
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьПодобно(Текст) + "%");
	Запрос.УстановитьПараметр("ОтборПоЛНА", Документ <> Неопределено);
	Запрос.УстановитьПараметр("ЛНА", Документ);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,]", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ознакомление по процессам утверждения ЛНА — как в форме «Процесс ознакомления».
//
// Параметры:
//  Процессы - Соответствие из КлючИЗначение - Ключ: ЛНА, Значение: ДокументСсылка.КЭДО_Процесс.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка.КЭДО_Процесс
//   * Значение - Массив из Структура - employee или participant, status, date.
Функция ОзнакомлениеПоПроцессам(Процессы)

	Результат = Новый Соответствие;
	Список = Новый Массив;
	Для Каждого КлючИЗначение Из Процессы Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Список.Добавить(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Список.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Статус задачи отправки обновляют только формы КЭДО, а акт приходит лентой: задача учитывается, пока акта нет.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.Процесс КАК Процесс,
	|	Постоянные.Получатель КАК Участник,
	|	ВЫБОР
	|		КОГДА Переменные.Отказан
	|			ТОГДА ""refused""
	|		КОГДА Переменные.Завершен
	|			ТОГДА ""familiarized""
	|		ИНАЧЕ ""not_familiarized""
	|	КОНЕЦ КАК Статус,
	|	ВЫБОР
	|		КОГДА Переменные.Завершен
	|			ТОГДА Переменные.ДатаЗавершения
	|		ИНАЧЕ Переменные.Срок
	|	КОНЕЦ КАК Дата
	|ПОМЕСТИТЬ ВТ_Акты
	|ИЗ
	|	РегистрСведений.КЭДО_ДанныеСвязанныхПроцессов КАК Связи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КЭДО_ДанныеПроцессовПостоянные КАК Постоянные
	|		ПО (Постоянные.ПроцессРегистратор = Связи.ПроцессРегистратор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КЭДО_ДанныеПроцессовПеременные КАК Переменные
	|		ПО (Переменные.ПроцессРегистратор = Связи.ПроцессРегистратор)
	|ГДЕ
	|	Связи.Процесс В(&Процессы)
	|	И Связи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.КЭДО_ТипСвязиПроцессов.Familiarization)
	|	И Связи.НаправлениеСвязи = ЗНАЧЕНИЕ(Перечисление.КЭДО_НаправлениеСвязиПроцесссов.Parent)
	|	И НЕ ЕСТЬNULL(Переменные.Удален, ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Акты.Процесс КАК Процесс,
	|	Акты.Участник КАК Участник,
	|	Акты.Статус КАК Статус,
	|	Акты.Дата КАК Дата
	|ИЗ
	|	ВТ_Акты КАК Акты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Задачи.Процесс,
	|	Задачи.Получатель,
	|	ВЫБОР
	|		КОГДА Задачи.Статус = ЗНАЧЕНИЕ(Перечисление.КЭДО_СтатусЗадачи.InProgress)
	|			ТОГДА ""sending""
	|		ИНАЧЕ ""sending_failed""
	|	КОНЕЦ,
	|	ДАТАВРЕМЯ(1, 1, 1)
	|ИЗ
	|	РегистрСведений.КЭДО_СозданиеОзнакомления КАК Задачи
	|ГДЕ
	|	Задачи.Процесс В(&Процессы)
	|	И Задачи.Статус <> ЗНАЧЕНИЕ(Перечисление.КЭДО_СтатусЗадачи.Complete)
	|	И НЕ (Задачи.Процесс, Задачи.Получатель) В
	|				(ВЫБРАТЬ
	|					Акты.Процесс,
	|					Акты.Участник
	|				ИЗ
	|					ВТ_Акты КАК Акты)";
	Запрос.УстановитьПараметр("Процессы", Список);

	Сотрудники = Новый Соответствие;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Участники = Результат.Получить(Строка.Процесс);
		Если Участники = Неопределено Тогда
			Участники = Новый Массив;
			Результат.Вставить(Строка.Процесс, Участники);
		КонецЕсли;
		Сотрудник = Сотрудники.Получить(Строка.Участник);
		Если Сотрудник = Неопределено Тогда
			Сотрудник = Справочники.КЭДО_УчастникиДокументооборота.Сотрудник1С(Строка.Участник);
			Сотрудники.Вставить(Строка.Участник, Сотрудник);
		КонецЕсли;
		Описание = Новый Структура;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			Описание.Вставить("employee", Сотрудник);
		Иначе
			Описание.Вставить("participant", Строка.Участник);
		КонецЕсли;
		Описание.Вставить("status", Строка.Статус);
		Если ЗначениеЗаполнено(Строка.Дата) Тогда
			Описание.Вставить(?(Строка.Статус = "familiarized", "date", "due"), ИИОК_КЭДО.МестнаяДата(Строка.Дата));
		КонецЕсли;
		Участники.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СводкаОзнакомления(ЛНА, Участники)

	Сводка = Новый Структура("sent, familiarized, not_familiarized, refused, sending, sending_failed",
		КонтурКэдоЛНА.ТекущаяВерсияЛНАОтправленаНаОзнакомление(ЛНА), 0, 0, 0, 0, 0);
	Если Участники = Неопределено Тогда
		Возврат Сводка;
	КонецЕсли;
	Для Каждого Участник Из Участники Цикл
		Сводка[Участник.status] = Сводка[Участник.status] + 1;
	КонецЦикла;
	Возврат Сводка;

КонецФункции

Функция КодСтатуса(Статус)

	Коды = Новый Соответствие;
	Коды.Вставить(Перечисления.КонтурКэдоЛНАСтатусы.Создан, "created");
	Коды.Вставить(Перечисления.КонтурКэдоЛНАСтатусы.ВРаботе, "in_approval");
	Коды.Вставить(Перечисления.КонтурКэдоЛНАСтатусы.Утвержден, "approved");
	Коды.Вставить(Перечисления.КонтурКэдоЛНАСтатусы.Отклонен, "rejected");
	Коды.Вставить(Перечисления.КонтурКэдоЛНАСтатусы.Архив, "archived");
	Код = Коды.Получить(Статус);
	Возврат ?(Код = Неопределено, "created", Код);

КонецФункции

#КонецОбласти
