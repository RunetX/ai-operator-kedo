// Данные сотрудников ЗУП со статусом в КЭДО - общая часть инструментов пакета.
// Статус считается так же, как в «Текущих делах КЭДО»: подключен - есть сотрудник сервиса, связанный с сотрудником 1С;
// приглашен или приглашение просрочено - есть приглашение, связанное с ним; иначе не подключен.
// Учитываются только головные сотрудники организаций, сопоставленных в КЭДО.
// Здесь же - единственное место, откуда пакет вызывает методы расширения КЭДО на сервере (область РасширениеКЭДО).

#Область СлужебныйПрограммныйИнтерфейс

// Отбор для ДанныеСотрудников.
//
// Возвращаемое значение:
//  Структура:
//   * ПринятыС - Дата - Пустая дата - без отбора.
//   * ПринятыПо - Дата - Пустая дата - без отбора.
//   * Статусы - Массив из Строка - not_connected, invited, invite_expired, connected; пустой - все.
//   * Организация - СправочникСсылка.Организации, Неопределено
//   * Сотрудники - Массив из СправочникСсылка.Сотрудники, Неопределено
//   * ТолькоРаботающие - Булево
Функция НовыйОтбор() Экспорт

	Отбор = Новый Структура;
	Отбор.Вставить("ПринятыС", Дата(1, 1, 1));
	Отбор.Вставить("ПринятыПо", Дата(1, 1, 1));
	Отбор.Вставить("Статусы", Новый Массив);
	Отбор.Вставить("Организация", Неопределено);
	Отбор.Вставить("Сотрудники", Неопределено);
	Отбор.Вставить("ТолькоРаботающие", Истина);
	Возврат Отбор;

КонецФункции

// Сотрудники со статусом в КЭДО и данными для формы приглашения.
//
// Параметры:
//  Отбор - см. НовыйОтбор
//
// Возвращаемое значение:
//  ТаблицаЗначений - Сотрудник, ФизическоеЛицо, Организация, Подразделение, Должность, ДатаПриема, ДатаУвольнения,
//   ОрганизацияID, EmployeeID, card_id, ПриглашениеID, ПриглашениеSMSID, ЕстьПочта, ЕстьТелефон, Статус.
Функция ДанныеСотрудников(Отбор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЕСТЬNULL(КадроваяИстория.Организация, Сотрудники.ГоловнаяОрганизация) КАК Организация,
	|	КадроваяИстория.Подразделение КАК Подразделение,
	|	КадроваяИстория.Должность КАК Должность,
	|	ЕСТЬNULL(КадровыеДанные.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПриема,
	|	ЕСТЬNULL(КадровыеДанные.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУвольнения
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадроваяИстория
	|		ПО (КадроваяИстория.Сотрудник = Сотрудники.Ссылка)
	|			И (&ТекущаяДата МЕЖДУ КадроваяИстория.ДатаНачала И КадроваяИстория.ДатаОкончания)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК КадровыеДанные
	|		ПО (КадровыеДанные.Сотрудник = Сотрудники.Ссылка)
	|ГДЕ
	|	&ОтборПоСотрудникам
	|	И Сотрудники.Ссылка = Сотрудники.ГоловнойСотрудник
	|	И НЕ Сотрудники.ПометкаУдаления
	|	И &ОтборПринятыС
	|	И &ОтборПринятыПо
	|	И &ОтборРаботающих
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Сотрудники.Сотрудник КАК Сотрудник,
	|	ВТ_Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТ_Сотрудники.Организация КАК Организация,
	|	ВТ_Сотрудники.Подразделение КАК Подразделение,
	|	ВТ_Сотрудники.Должность КАК Должность,
	|	ВТ_Сотрудники.ДатаПриема КАК ДатаПриема,
	|	ВТ_Сотрудники.ДатаУвольнения КАК ДатаУвольнения,
	|	МАКСИМУМ(ОрганизацииКЭДО.Ссылка.Идентификатор) КАК ОрганизацияID
	|ПОМЕСТИТЬ ВТ_СотрудникиКЭДО
	|ИЗ
	|	ВТ_Сотрудники КАК ВТ_Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КЭДО_Организации.СвязанныеОбъекты КАК ОрганизацииКЭДО
	|		ПО (ОрганизацииКЭДО.Объект = ВТ_Сотрудники.Организация)
	|			И (НЕ ОрганизацииКЭДО.Ссылка.ПометкаУдаления)
	|ГДЕ
	|	&ОтборПоОрганизации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Сотрудники.Сотрудник,
	|	ВТ_Сотрудники.ФизическоеЛицо,
	|	ВТ_Сотрудники.Организация,
	|	ВТ_Сотрудники.Подразделение,
	|	ВТ_Сотрудники.Должность,
	|	ВТ_Сотрудники.ДатаПриема,
	|	ВТ_Сотрудники.ДатаУвольнения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связь.Объект КАК Сотрудник,
	|	МАКСИМУМ(Employees.id) КАК EmployeeID,
	|	МАКСИМУМ(Employees.card_id) КАК card_id
	|ПОМЕСТИТЬ ВТ_Подключены
	|ИЗ
	|	РегистрСведений.КЭДО_Employees КАК Employees
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Владелец.Идентификатор = Employees.organizations_id)
	|			И (Связь.Ссылка.Идентификатор = Employees.id)
	|ГДЕ
	|	Связь.Объект В
	|			(ВЫБРАТЬ
	|				ВТ_СотрудникиКЭДО.Сотрудник
	|			ИЗ
	|				ВТ_СотрудникиКЭДО)
	|	И (Employees.deleted_at = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Employees.deleted_at > &ТекущаяДата)
	|
	|СГРУППИРОВАТЬ ПО
	|	Связь.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связь.Объект КАК Сотрудник,
	|	МАКСИМУМ(Invites.card_id) КАК card_id,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Invites.Просрочено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВсеПросрочены,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Invites.inviteChannel = ""Sms""
	|				ТОГДА Invites.id
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК ПриглашениеSMSID,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Invites.inviteChannel <> ""Sms""
	|				ТОГДА Invites.id
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК ПриглашениеID
	|ПОМЕСТИТЬ ВТ_Приглашения
	|ИЗ
	|	РегистрСведений.КЭДО_Invites КАК Invites
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоПриглашения.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Идентификатор = Invites.id)
	|ГДЕ
	|	Связь.Объект В
	|			(ВЫБРАТЬ
	|				ВТ_СотрудникиКЭДО.Сотрудник
	|			ИЗ
	|				ВТ_СотрудникиКЭДО)
	|
	|СГРУППИРОВАТЬ ПО
	|	Связь.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Ссылка КАК ФизическоеЛицо,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Вид = &ВидПочты
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЕстьПочта,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Вид = &ВидТелефона
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЕстьТелефон
	|ПОМЕСТИТЬ ВТ_Контакты
	|ИЗ
	|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Вид В (&ВидПочты, &ВидТелефона)
	|	И ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100)) <> """"
	|	И КонтактнаяИнформация.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_СотрудникиКЭДО.ФизическоеЛицо
	|			ИЗ
	|				ВТ_СотрудникиКЭДО)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтактнаяИнформация.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СотрудникиКЭДО.Сотрудник КАК Сотрудник,
	|	ВТ_СотрудникиКЭДО.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТ_СотрудникиКЭДО.Организация КАК Организация,
	|	ВТ_СотрудникиКЭДО.Подразделение КАК Подразделение,
	|	ВТ_СотрудникиКЭДО.Должность КАК Должность,
	|	ВТ_СотрудникиКЭДО.ДатаПриема КАК ДатаПриема,
	|	ВТ_СотрудникиКЭДО.ДатаУвольнения КАК ДатаУвольнения,
	|	ВТ_СотрудникиКЭДО.ОрганизацияID КАК ОрганизацияID,
	|	ЕСТЬNULL(ВТ_Подключены.EmployeeID, """") КАК EmployeeID,
	|	ЕСТЬNULL(ВТ_Подключены.card_id, ЕСТЬNULL(ВТ_Приглашения.card_id, """")) КАК card_id,
	|	ЕСТЬNULL(ВТ_Приглашения.ПриглашениеID, """") КАК ПриглашениеID,
	|	ЕСТЬNULL(ВТ_Приглашения.ПриглашениеSMSID, """") КАК ПриглашениеSMSID,
	|	ЕСТЬNULL(ВТ_Контакты.ЕстьПочта, 0) = 1 КАК ЕстьПочта,
	|	ЕСТЬNULL(ВТ_Контакты.ЕстьТелефон, 0) = 1 КАК ЕстьТелефон,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_Подключены.Сотрудник ЕСТЬ NULL
	|			ТОГДА ""connected""
	|		КОГДА ВТ_Приглашения.Сотрудник ЕСТЬ NULL
	|			ТОГДА ""not_connected""
	|		КОГДА ВТ_Приглашения.ВсеПросрочены = 1
	|			ТОГДА ""invite_expired""
	|		ИНАЧЕ ""invited""
	|	КОНЕЦ КАК Статус
	|ИЗ
	|	ВТ_СотрудникиКЭДО КАК ВТ_СотрудникиКЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Подключены КАК ВТ_Подключены
	|		ПО (ВТ_Подключены.Сотрудник = ВТ_СотрудникиКЭДО.Сотрудник)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Приглашения КАК ВТ_Приглашения
	|		ПО (ВТ_Приглашения.Сотрудник = ВТ_СотрудникиКЭДО.Сотрудник)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контакты КАК ВТ_Контакты
	|		ПО (ВТ_Контакты.ФизическоеЛицо = ВТ_СотрудникиКЭДО.ФизическоеЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПриема УБЫВ,
	|	Сотрудник";

	// Отборы подставляются в текст, а не через ИЛИ с параметром: отбор по ссылке сотрудника - основное условие,
	// он должен идти по индексу. Без отбора условие - ИСТИНА.
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСотрудникам",
		?(Отбор.Сотрудники = Неопределено, "ИСТИНА", "Сотрудники.Ссылка В (&Сотрудники)"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоОрганизации",
		?(Отбор.Организация = Неопределено, "ИСТИНА", "ВТ_Сотрудники.Организация = &Организация"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПринятыС", ?(Не ЗначениеЗаполнено(Отбор.ПринятыС), "ИСТИНА",
		"ЕСТЬNULL(КадровыеДанные.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) >= &ПринятыС"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПринятыПо", ?(Не ЗначениеЗаполнено(Отбор.ПринятыПо), "ИСТИНА",
		"ЕСТЬNULL(КадровыеДанные.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) <= &ПринятыПо"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборРаботающих", ?(Не Отбор.ТолькоРаботающие, "ИСТИНА",
		"(ЕСТЬNULL(КадровыеДанные.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ КадровыеДанные.ДатаУвольнения >= &ТекущаяДата)"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПринятыС", Отбор.ПринятыС);
	Запрос.УстановитьПараметр("ПринятыПо", Отбор.ПринятыПо);
	Запрос.УстановитьПараметр("Сотрудники", Отбор.Сотрудники);
	Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	Запрос.УстановитьПараметр("ВидПочты", ВидПочты());
	Запрос.УстановитьПараметр("ВидТелефона", ВидТелефона());

	Таблица = Запрос.Выполнить().Выгрузить();
	Если Отбор.Статусы.Количество() > 0 Тогда
		Индекс = Таблица.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если Отбор.Статусы.Найти(Таблица[Индекс].Статус) = Неопределено Тогда
				Таблица.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	Возврат Таблица;

КонецФункции

// Вид контактной информации, на который КЭДО отправляет приглашения по почте (настройка расширения КЭДО).
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации
Функция ВидПочты() Экспорт

	Вид = НастройкаКЭДО("ВидКИДляПриглашений");
	Возврат ?(ЗначениеЗаполнено(Вид), Вид, Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);

КонецФункции

// Вид контактной информации, на который КЭДО отправляет приглашения по SMS (настройка расширения КЭДО).
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации
Функция ВидТелефона() Экспорт

	Вид = НастройкаКЭДО("ВидТелефонаДляПриглашений");
	Возврат ?(ЗначениеЗаполнено(Вид), Вид, Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);

КонецФункции

// Дата в часовом поясе сеанса. Даты процессов, очереди обновления и фоновых заданий расширение КЭДО хранит в UTC,
// а его формы показывают их в местном времени.
//
// Параметры:
//  УниверсальнаяДата - Дата
//
// Возвращаемое значение:
//  Дата
Функция МестнаяДата(УниверсальнаяДата) Экспорт

	Если Не ЗначениеЗаполнено(УниверсальнаяДата) Тогда
		Возврат УниверсальнаяДата;
	КонецЕсли;
	Возврат МестноеВремя(УниверсальнаяДата, ЧасовойПоясСеанса());

КонецФункции

// Статусы сотрудника в КЭДО, как их видит модель.
//
// Возвращаемое значение:
//  Массив из Строка - not_connected, invited, invite_expired, connected.
Функция Статусы() Экспорт

	Возврат СтрРазделить("not_connected,invited,invite_expired,connected", ",");

КонецФункции

// Сотрудники из аргумента employees: строки ref (Справочник.Сотрудники:<УИД>) или объекты {"ref": ...}.
// Повторы отбрасываются, порядок сохраняется.
//
// Параметры:
//  Значение - Массив, Строка, Структура, Соответствие - Значение аргумента employees.
//  Сотрудники - Массив из СправочникСсылка.Сотрудники - Сюда добавляются сотрудники.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели: элемент не сотрудник.
//  Неопределено - Все элементы - сотрудники.
Функция РазобратьСотрудников(Знач Значение, Сотрудники) Экспорт

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Значение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение);
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Идентификатор = Элемент;
		Если ТипЗнч(Элемент) = Тип("Структура") Или ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Элемент, "ref");
		КонецЕсли;
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Идентификатор);
		Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Сотрудники") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не сотрудник: %1.'"), Строка(Идентификатор)),
				НСтр("ru = 'Передай ref сотрудников (Справочник.Сотрудники:<УИД>) из ответа kedo_employees или find_ref.'"));
		КонецЕсли;
		Если Сотрудники.Найти(Ссылка) = Неопределено Тогда
			Сотрудники.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#Область РасширениеКЭДО

// Методы расширения КЭДО на сервере пакет вызывает только отсюда: при обновлении КЭДО проверять их здесь.
// Справочники и регистры КЭДО читают запросы модулей ИИОК_КЭДО, ИИОК_ЛНА, ИИОК_Настройка и ИИОК_Диагностика.

// Установлено ли в базе расширение КЭДО, с которым работает пакет.
//
// Возвращаемое значение:
//  Булево
Функция РасширениеКЭДОУстановлено() Экспорт

	Возврат Метаданные.Обработки.Найти("КонтурКэдоПриглашениеСотрудников") <> Неопределено
		И Метаданные.Справочники.Найти("КЭДО_Организации") <> Неопределено
		И Метаданные.РегистрыСведений.Найти("КЭДО_Invites") <> Неопределено;

КонецФункции

// Версия установленного расширения КЭДО.
//
// Возвращаемое значение:
//  Строка - Пустая строка, если расширения нет.
Функция ВерсияРасширенияКЭДО() Экспорт

	Модуль = Метаданные.ОбщиеМодули.Найти("КЭДО_Сервер");
	Если Модуль = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Расширение = Модуль.РасширениеКонфигурации();
	Возврат ?(Расширение = Неопределено, "", Расширение.Версия);

КонецФункции

// Значение настройки расширения КЭДО.
//
// Параметры:
//  Имя - Строка - Имя настройки КЭДО.
