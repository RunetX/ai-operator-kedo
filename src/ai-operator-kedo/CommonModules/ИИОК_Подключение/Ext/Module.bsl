// Подключение к КЭДО одной кнопкой (kedo_setup с open, КЭДО 1.27 и новее). После входа в сервис ИИ-оператор сам
// проходит шаги мастера первого запуска КЭДО с его умолчаниями: права и доступы, соглашение и сопоставление
// организаций по ИНН, первый обмен, связь пользователя с его сотрудником, типы документов. Соглашение принимается
// и данные меняются только после кнопки «Подключить» в вопросе с планом.
// Функции мастера КЭДО - не публичное API КЭДО: модули берутся через ОбщегоНазначения.ОбщийМодуль, а доступность
// подключения проверяется заранее по версии КЭДО и наличию модулей.

#Область СлужебныйПрограммныйИнтерфейс

// Можно ли подключить КЭДО без мастера: КЭДО 1.27 и новее и КЭДО еще не настроено.
//
// Возвращаемое значение:
//  Булево
Функция Доступно() Экспорт

	Для Каждого ИмяМодуля Из СтрРазделить(ИменаМодулейКЭДО(), ",") Цикл
		Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Если Метаданные.РегистрыСведений.Найти(ИмяРегистраМастера()) = Неопределено
		Или Метаданные.РегистрыСведений.Найти(ИмяРегистраНастроекПользователя()) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Версия = ИИОК_КЭДО.ВерсияРасширенияКЭДО();
	Если Не ЗначениеЗаполнено(Версия) Или СравнитьВерсии(Версия, "1.27.0") < 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ИИОК_Настройка.Снимок().Настроено;

КонецФункции

// Есть ли у текущего пользователя действующий сеанс сервиса КЭДО: тогда входить заново не нужно.
//
// Возвращаемое значение:
//  Булево
Функция СеансЕсть() Экспорт

	Попытка
		ОбщегоНазначения.ОбщийМодуль("КонтурКэдоАутентификация").ПолучитьСеанс();
	Исключение
		// Нет сеанса или токен не обновился: пользователь войдет заново. Причина остается в журнале регистрации,
		// если это не обычное отсутствие входа.
		Информация = ИнформацияОбОшибке();
		Если Не ЭтоОшибкаВхода(Информация) Тогда
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета("ИИОК_Подключение",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// План подключения после входа в сервис: что сделает кнопка «Подключить».
//
// Возвращаемое значение:
//  Структура:
//   * Организации - Массив из Структура - Организации сервиса, у которых есть пара в 1С по ИНН:
//     ** ИдентификаторКЭДО - Строка
//     ** ВСервисе - Строка - Наименование организации в сервисе.
//     ** Организация - СправочникСсылка.Организации
//     ** СоглашениеПринято - Булево
//     ** Сотрудник - СправочникСсылка.Сотрудники, Неопределено - Сотрудник пользователя в этой организации.
//   * БезПары - Массив из Строка - Организации сервиса без пары в 1С: их сопоставляют в мастере КЭДО.
//   * Пользователь - СправочникСсылка.Пользователи
//   * ВАдминистраторы - Булево - Пользователь будет добавлен в группу «Администраторы КЭДО».
Функция План() Экспорт

	Мастер = ОбщегоНазначения.ОбщийМодуль("КонтурКэдоМастерПервогоЗапуска");
	Таблица = Мастер.ПолучитьДанныеШагаОрганизаций();
	Мастер.ПроставитьОтметкиОрганизаций(Таблица);
	Пользователь = Пользователи.ТекущийПользователь();
	ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ФизическоеЛицо");

	План = Новый Структура("Организации, БезПары, Пользователь, ВАдминистраторы",
		Новый Массив, Новый Массив, Пользователь, НуженВАдминистраторы());
	Для Каждого Строка Из Таблица Цикл
		// Отмечены организации с незавершенной настройкой: уже настроенные мастер не трогает.
		Если Не Строка.Отмечена Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.ОрганизацияВ1С) Тогда
			План.БезПары.Добавить(Строка.ОрганизацияВСервисе);
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("ИдентификаторКЭДО, ВСервисе, Организация, СоглашениеПринято, Сотрудник",
			Строка.ИдентификаторКЭДО, Строка.ОрганизацияВСервисе, Строка.ОрганизацияВ1С, Строка.СоглашениеПринято,
			СотрудникПользователя(ФизическоеЛицо, Строка.ОрганизацияВ1С));
		План.Организации.Добавить(Описание);
	КонецЦикла;
	Возврат План;

КонецФункции

// План подключения для вопроса пользователю: текст по шагам мастера и организации, которые подключит кнопка.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - Вопрос с планом.
//   * Подтверждено - Массив из Строка - Организации сервиса, которые подключит кнопка «Подключить».
//   * Соглашение - Строка - Организация сервиса, чье соглашение открывает кнопка «Текст соглашения», или пустая.
//   * Ошибка - Строка - Почему подключить одной кнопкой нельзя, или пустая.
Функция ОписаниеПлана() Экспорт

	Описание = Новый Структура("Текст, Подтверждено, Соглашение, Ошибка", "", Новый Массив, "", "");
	План = План();
	БезПары = СтрСоединить(План.БезПары, ", ");
	Если План.Организации.Количество() = 0 Тогда
		Описание.Ошибка = ?(ЗначениеЗаполнено(БезПары),
			СтрШаблон(НСтр("ru = 'Для организаций сервиса нет пары в 1С по ИНН: %1. Их сопоставляют в мастере КЭДО.'"),
				БезПары),
			НСтр("ru = 'В сервисе КЭДО нет организаций, которые нужно настроить, или у учетной записи нет к ним доступа.'"));
		Возврат Описание;
	КонецЕсли;

	Пары = Новый Массив;
	Сотрудники = Новый Массив;
	Для Каждого Организация Из План.Организации Цикл
		Описание.Подтверждено.Добавить(Организация.ИдентификаторКЭДО);
		Пары.Добавить(СтрШаблон(НСтр("ru = '«%1» в 1С - «%2» в сервисе'"), Организация.Организация,
			Организация.ВСервисе));
		Если Не Организация.СоглашениеПринято И Не ЗначениеЗаполнено(Описание.Соглашение) Тогда
			Описание.Соглашение = Организация.ИдентификаторКЭДО;
		КонецЕсли;
		Если Организация.Сотрудник <> Неопределено Тогда
			Сотрудники.Добавить(СтрШаблон("«%1»", Организация.Сотрудник));
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'ИИ-оператор пройдет мастер первого запуска КЭДО с настройками по умолчанию:'"));
	Строки.Добавить("");
	Строки.Добавить(?(План.ВАдминистраторы,
		НСтр("ru = '1. Права и доступы: вы - администратор КЭДО, регламентные задания КЭДО работают от вашего имени.'"),
		НСтр("ru = '1. Права и доступы: регламентные задания КЭДО работают от вашего имени.'")));
	Строки.Добавить(СтрШаблон(НСтр("ru = '2. Мои организации: %1, сопоставление по ИНН.'"), СтрСоединить(Пары, "; ")));
	Если ЗначениеЗаполнено(Описание.Соглашение) Тогда
		Строки.Добавить(НСтр("ru = '    Будет принято соглашение о признании простой электронной подписи'") + " "
			+ НСтр("ru = 'и усиленной неквалифицированной подписи аналогом собственноручной подписи.'"));
	КонецЕсли;
	Строки.Добавить(НСтр("ru = '3. Обмен с сервисом: загрузка данных КЭДО и выгрузка оргструктуры 1С, до нескольких минут.'"));
	Строки.Добавить(?(Сотрудники.Количество() > 0,
		СтрШаблон(НСтр("ru = '4. Сотрудники: связь с вашим сотрудником %1.'"), СтрСоединить(Сотрудники, ", ")),
		НСтр("ru = '4. Сотрудники: ваш сотрудник в 1С не найден, связь настраивают в мастере КЭДО.'")));
	Строки.Добавить(НСтр("ru = '5. Типы документов: приказ на отпуск (Т-6) - «Приказ на ежегодный оплачиваемый отпуск».'"));
	Если ЗначениеЗаполнено(БезПары) Тогда
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Без пары в 1С по ИНН, настраиваются в мастере КЭДО: %1.'"), БезПары));
	КонецЕсли;
	Описание.Текст = СтрСоединить(Строки, Символы.ПС);
	Возврат Описание;

КонецФункции

// Ответ kedo_setup после подключения одной кнопкой: состояние настройки и итог подключения.
//
// Параметры:
//  Итог - Структура, Неопределено - см. Подключить; Неопределено - подключение не выполнялось или задание упало.
//  СводкаДо - Строка - Сводка настройки до подключения, см. ИИОК_Настройка.СводкаСнимка.
//  Отменено - Булево - Пользователь не вошел в сервис или не подтвердил подключение.
//  ТекстОшибки - Строка - Почему подключение не выполнено, если итога нет.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция Ответ(Знач Итог, Знач СводкаДо, Знач Отменено = Ложь, Знач ТекстОшибки = "") Экспорт

	Если Итог = Неопределено Тогда
		Итог = НовыйИтог();
	КонецЕсли;
	Итог.Вставить("Отменено", Отменено);
	Если ЗначениеЗаполнено(ТекстОшибки) И Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Итог.Ошибка = ТекстОшибки;
	КонецЕсли;
	Возврат ИИОК_Настройка.Итог(СводкаДо, Ложь, Итог.АдминистраторДобавлен, Итог);

КонецФункции

// Файл действующего соглашения сервиса для организации - тот же PDF, что открывает мастер КЭДО.
//
// Параметры:
//  ИдентификаторКЭДО - Строка - Организация сервиса.
//  ИдентификаторХранилища - УникальныйИдентификатор - Владелец временного хранилища.
//
// Возвращаемое значение:
//  Строка - Адрес PDF во временном хранилище или пустая строка, если сервис файл не отдал.
Функция Соглашение(ИдентификаторКЭДО, ИдентификаторХранилища) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ответ = ОбщегоНазначения.ОбщийМодуль("КЭДО_КлиентAPI").АктуальноеСоглашениеPDF(ИдентификаторКЭДО,
			ТипСоглашения());
		Адрес = ?(Ответ.ПроизошлаОшибка, "", ПоместитьВоВременноеХранилище(Ответ.Данные, ИдентификаторХранилища));
	Исключение
		Адрес = "";
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета("ИИОК_Подключение",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Адрес;

КонецФункции

// Подключает КЭДО по плану, который пользователь подтвердил кнопкой «Подключить». Выполняется в фоновом задании:
// первый обмен с сервисом идет минуты. Ход сообщается прогрессом БСП с названиями шагов мастера.
//
// Параметры:
//  Подтверждено - Массив из Строка - Идентификаторы организаций сервиса из плана, который видел пользователь.
//
// Возвращаемое значение:
//  Структура - см. НовыйИтог
Функция Подключить(Знач Подтверждено) Экспорт

	Итог = НовыйИтог();
	Мастер = ОбщегоНазначения.ОбщийМодуль("КонтурКэдоМастерПервогоЗапуска");
	Пользователь = Пользователи.ТекущийПользователь();

	СообщитьШаг(5, НСтр("ru = 'Права и доступы'"));
	Итог.АдминистраторДобавлен = ИИОК_Настройка.ДобавитьВАдминистраторы();
	Итог.Ошибка = Мастер.УстановитьПользователяРегламентныхЗаданий(Пользователь);
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог;
	КонецЕсли;
	ЗафиксироватьШаг(1);

	СообщитьШаг(10, НСтр("ru = 'Вход в сервис'"));
	Если Не СеансЕсть() Тогда
		Итог.Ошибка = НСтр("ru = 'Нет входа в сервис КЭДО: войдите и запустите подключение снова.'");
		Возврат Итог;
	КонецЕсли;
	ЗафиксироватьШаг(2);

	СообщитьШаг(20, НСтр("ru = 'Мои организации: соглашение и сопоставление по ИНН'"));
	План = План();
	Идентификаторы = Новый Соответствие;
	Набор = ПодключитьОрганизации(Мастер, План, Подтверждено, Итог, Идентификаторы);
	Если Набор.Количество() = 0 Тогда
		Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
			Итог.Ошибка = НСтр("ru = 'Ни одна организация не подключена.'");
		КонецЕсли;
		Возврат Итог;
	КонецЕсли;
	ЗафиксироватьШаг(2, Набор);

	СообщитьШаг(35,
		НСтр("ru = 'Обмен с сервисом: загрузка данных КЭДО и выгрузка оргструктуры, до нескольких минут'"));
	Обмен = Мастер.ВыполнитьПервуюНастройкуФоновоеЗадание(Пользователь, Набор, Набор);
	Если ЗначениеЗаполнено(Обмен.ТекстОшибкиОбмена) Тогда
		Итог.Ошибка = Обмен.ТекстОшибкиОбмена;
		Возврат Итог;
	КонецЕсли;
	Если ЗначениеЗаполнено(Обмен.ПредупреждениеОбмена) Тогда
		Итог.Предупреждения.Добавить(Обмен.ПредупреждениеОбмена);
	КонецЕсли;
	Для Каждого ОшибкаСтруктуры Из Обмен.ОшибкиОргструктуры Цикл
		Итог.Предупреждения.Добавить(ОшибкаСтруктуры.ТекстОшибки);
	КонецЦикла;
	ВключитьКЭДОПользователю();
	ЗафиксироватьШаг(3, Набор);

	СообщитьШаг(85, НСтр("ru = 'Сотрудники'"));
	СвязатьСотрудника(Мастер, План, Набор, Идентификаторы, Итог);
	ЗафиксироватьШаг(4);

	СообщитьШаг(95, НСтр("ru = 'Типы документов'"));
	Мастер.ПредзаполнитьСоответствияТиповДокументов(Набор);
	ЗафиксироватьШаг(5);
	ЗафиксироватьШаг(6);

	ИИО_Журнал.ЗаписатьСобытие("КЭДО.Подключение", УровеньЖурналаРегистрации.Информация,
		Новый Структура("organizations, admin_added, employee_linked, warnings",
			Итог.Организации.Количество(), Итог.АдминистраторДобавлен, Итог.Сотрудник <> Неопределено,
			Итог.Предупреждения.Количество()));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйИтог()

	Итог = Новый Структура;
	Итог.Вставить("Организации", Новый Массив);
	Итог.Вставить("Соглашения", Новый Массив);
	Итог.Вставить("Сотрудник", Неопределено);
	Итог.Вставить("АдминистраторДобавлен", Ложь);
	Итог.Вставить("Предупреждения", Новый Массив);
	Итог.Вставить("Ошибка", "");
	Возврат Итог;

КонецФункции

// Принимает соглашения и сопоставляет подтвержденные организации так же, как шаг «Мои организации» мастера.
// Возвращает набор мастера - успешно сопоставленные организации КЭДО; Идентификаторы - их идентификаторы в сервисе.
Функция ПодключитьОрганизации(Мастер, План, Подтверждено, Итог, Идентификаторы)

	Таблица = Мастер.НоваяТаблицаОрганизаций();
	БезСоглашения = Новый Массив;
	Для Каждого Описание Из План.Организации Цикл
		Если Подтверждено.Найти(Описание.ИдентификаторКЭДО) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.Отмечена = Истина;
		Строка.ИдентификаторКЭДО = Описание.ИдентификаторКЭДО;
		Строка.ОрганизацияВСервисе = Описание.ВСервисе;
		Строка.ОрганизацияВ1С = Описание.Организация;
		Строка.СоглашениеПринято = Описание.СоглашениеПринято;
		Строка.ПередатьСтруктуру = Истина;
		Если Не Описание.СоглашениеПринято Тогда
			БезСоглашения.Добавить(Описание.ИдентификаторКЭДО);
		КонецЕсли;
	КонецЦикла;

	Если БезСоглашения.Количество() > 0 Тогда
		Для Каждого Принятие Из Мастер.ПринятьСоглашенияОрганизаций(БезСоглашения) Цикл
			Строка = Таблица.Найти(Принятие.ИдентификаторКЭДО, "ИдентификаторКЭДО");
			Если Принятие.Успех Тогда
				Итог.Соглашения.Добавить(Строка.ОрганизацияВ1С);
			Иначе
				Итог.Предупреждения.Добавить(Принятие.ТекстОшибки);
				Таблица.Удалить(Строка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Набор = Новый Массив;
	Для Каждого Подготовка Из Мастер.ПодготовитьОрганизации(Таблица) Цикл
		// Функция мастера ставит Успех и тогда, когда связь не записалась: проверяем признак самой организации КЭДО.
		Если Подготовка.Успех И ЗначениеЗаполнено(Подготовка.ОрганизацияКЭДО)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подготовка.ОрганизацияКЭДО, "Сопоставлен") = Истина Тогда
			Набор.Добавить(Подготовка.ОрганизацияКЭДО);
			Идентификаторы.Вставить(Подготовка.ОрганизацияКЭДО, Подготовка.ИдентификаторКЭДО);
			Итог.Организации.Добавить(Таблица.Найти(Подготовка.ИдентификаторКЭДО, "ИдентификаторКЭДО").ОрганизацияВ1С);
		Иначе
			Итог.Предупреждения.Добавить(Подготовка.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	Возврат Набор;

КонецФункции

// Связывает сотрудника сервиса, под которым пользователь вошел, с его сотрудником 1С - то, что мастер предлагает
// сделать на шаге «Сотрудники» хотя бы для текущего пользователя.
Процедура СвязатьСотрудника(Мастер, План, Набор, Идентификаторы, Итог)

	Публичный = ОбщегоНазначения.ОбщийМодуль("КонтурКэдо");
	Для Каждого ОрганизацияКЭДО Из Набор Цикл
		Описание = ОписаниеОрганизации(План, Идентификаторы.Получить(ОрганизацияКЭДО));
		Если Описание = Неопределено Или Описание.Сотрудник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СотрудникКЭДО = Публичный.СотрудникТекущегоПользователяПортала(ОрганизацияКЭДО);
		Если Не ЗначениеЗаполнено(СотрудникКЭДО) Тогда
			Продолжить;
		КонецЕсли;
		Занят = Мастер.КарточкаЗанявшаяСотрудника(Описание.Сотрудник, СотрудникКЭДО);
		Если Занят.Занят Тогда
			Продолжить;
		КонецЕсли;
		Мастер.СопоставитьСотрудникаИЗафиксировать(СотрудникКЭДО, Описание.Сотрудник);
		// Процедура мастера ошибок не возвращает: связь проверяем по карточке.
		Если Справочники[ИмяСправочникаСотрудников()].ПолучитьОбъектСвязи(СотрудникКЭДО) = Описание.Сотрудник Тогда
			Итог.Сотрудник = Описание.Сотрудник;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеОрганизации(План, ИдентификаторКЭДО)

	Для Каждого Описание Из План.Организации Цикл
		Если Описание.ИдентификаторКЭДО = ИдентификаторКЭДО Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Сотрудник 1С пользователя в организации: по физическому лицу пользователя, головной, не в архиве.
Функция СотрудникПользователя(ФизическоеЛицо, Организация)

	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
	|	И Сотрудники.ГоловнаяОрганизация = &ГоловнаяОрганизация
	|	И Сотрудники.Ссылка = Сотрудники.ГоловнойСотрудник
	|	И НЕ Сотрудники.ВАрхиве
	|	И НЕ Сотрудники.ПометкаУдаления");
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("ГоловнаяОрганизация",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ГоловнаяОрганизация"));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Сотрудник, Неопределено);

КонецФункции

// Пользователя добавят в «Администраторы КЭДО»: у него есть права администрирования КЭДО, а в группе его нет.
Функция НуженВАдминистраторы()

	Инфра = ОбщегоНазначения.ОбщийМодуль("КонтурКэдоИнфра");
	Возврат Инфра.ЕстьПравоАдминистрированияКЭДО()
		И Не Инфра.ПользовательВГруппеДоступаКЭДО(Инфра.КлючГруппыАдминистраторыКЭДО());

КонецФункции

// «Использовать КЭДО для текущего пользователя» и доступ к организациям - то, что мастер делает после первого обмена.
Процедура ВключитьКЭДОПользователю()

	УстановитьПривилегированныйРежим(Истина);
	РегистрыСведений[ИмяРегистраНастроекПользователя()].ЗаписатьНастройку("ИнтеграцияНастроена", "Да");
	УстановитьПривилегированныйРежим(Ложь);
	Попытка
		Обработки["КонтурКэдоМенеджерАвторизации"].ОбновитьОграниченияДоступа(
			ОбщегоНазначения.ОбщийМодуль("КонтурКэдоИнфра").ТекущийПользовательИБ());
	Исключение
		// Доступ к организациям обновит и отложенная очередь КЭДО: подключение на этом не останавливается.
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета("ИИОК_Подключение",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отмечает шаг мастера пройденным, как это делает форма мастера: открытый вручную мастер покажет готовую настройку.
Процедура ЗафиксироватьШаг(НомерШага, Организации = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	РегистрыСведений[ИмяРегистраМастера()].ЗафиксироватьВыполнениеШага(НомерШага, Организации);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура СообщитьШаг(Процент, Шаг)

	ДлительныеОперации.СообщитьПрогресс(Процент, Шаг);

КонецПроцедуры

Функция ЭтоОшибкаВхода(Информация)

	Код = ОбщегоНазначения.ОбщийМодуль("КонтурКэдоАутентификацияКлиентСервер").КодОшибкиАутентификация();
	Возврат ОбщегоНазначения.ОбщийМодуль("КонтурКэдоИнфраКлиентСервер").ЯвляетсяОшибкойКатегории(Информация, Код);

КонецФункции

// Сравнивает версии по первым трем числам: КЭДО отдает версию из трех чисел.
Функция СравнитьВерсии(Версия, СВерсией)

	Числа = СтрРазделить(Версия, ".", Ложь);
	ЧислаС = СтрРазделить(СВерсией, ".", Ложь);
	Для Индекс = 0 По 2 Цикл
		Число = ?(Индекс < Числа.Количество(), Число(Числа[Индекс]), 0);
		ЧислоС = ?(Индекс < ЧислаС.Количество(), Число(ЧислаС[Индекс]), 0);
		Если Число <> ЧислоС Тогда
			Возврат ?(Число < ЧислоС, -1, 1);
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

