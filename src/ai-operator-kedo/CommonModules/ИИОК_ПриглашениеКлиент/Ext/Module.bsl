// Инструмент kedo_invite: открывает штатную форму КЭДО «Приглашение сотрудников в сервис» с отобранными сотрудниками.
// Отправляет приглашения пользователь кнопкой «Пригласить» в этой форме; модель получает итог после закрытия формы.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента kedo_invite. Ответ отложен до закрытия формы КЭДО.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Ошибка или итог без открытия формы.
//  Неопределено - Форма открыта, ответ придет после ее закрытия.
Функция Пригласить(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьФормуПриглашения(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовка) Тогда
		Возврат Подготовка;
	ИначеЕсли Подготовка.Свойство("Итог") Тогда
		Возврат Подготовка.Итог;
	КонецЕсли;

	Подключение = Подготовка.Подключение;
	Если Подключение <> Неопределено Тогда
		// Права на приглашение по организациям - так же, как перед открытием формы в «Текущих делах КЭДО».
		КЭДО_Клиент.ИнформацияОПользователеПолучить(Подключение);
	КонецЕсли;
	Если Подключение = Неопределено Или Не Подключение.АвторизацияВыполнена Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_AUTH",
			НСтр("ru = 'Пользователь 1С не вошёл в КЭДО.'"),
			НСтр("ru = 'Скажи пользователю войти в КЭДО (раздел КЭДО, «Текущие дела») и повторить просьбу.'"));
	КонецЕсли;

	Строки = Новый Массив;
	Приглашаемые = Новый Массив;
	Для Каждого Строка Из Подготовка.Строки Цикл
		Если Подключение.ПраваДляПриглашений.НайтиПоЗначению(Строка.ОрганизацияВ1С) = Неопределено Тогда
			Подготовка.Пропущены.Добавить(Новый Структура("employee, reason", Строка.СотрудникВ1С, "no_invite_rights"));
		Иначе
			Строки.Добавить(Строка);
			Приглашаемые.Добавить(Строка.СотрудникВ1С);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		// Права по организациям известны только на клиенте после запроса КЭДО, поэтому итог - отдельным вызовом.
		Возврат ИИОК_КЭДОВызовСервера.ИтогПриглашения(Новый Массив, Подготовка.Пропущены);
	КонецЕсли;

	Контекст = Новый Структура("Вызов, Приглашаемые, Пропущены",
		ПараметрыОбработчика.Вызов, Приглашаемые, Подготовка.Пропущены);
	Форма = ОткрытьФорму("Обработка.КонтурКэдоПриглашениеСотрудников.Форма.ПриглашениеСписком",
		Новый Структура("СотрудникиКПриглашению, ДанныеПодключения", Строки, Подключение), ,
		Новый УникальныйИдентификатор, , ,
		Новый ОписаниеОповещения("ПослеЗакрытияФормы", ИИОК_ПриглашениеКлиент, Контекст),
		РежимОткрытияОкнаФормы.Независимый);
	Если Форма = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_FORM",
			НСтр("ru = 'Форма приглашения КЭДО не открылась.'"),
			НСтр("ru = 'Скажи пользователю открыть приглашение из «Текущих дел КЭДО»: там видна причина.'"));
	КонецЕсли;
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	ИИО_ФормыКлиент.ОжидатьЗакрытия(Форма, ПараметрыОбработчика.Вызов,
		Новый ОписаниеОповещения("ИтогПоСроку", ИИОК_ПриглашениеКлиент, Контекст));
	Возврат Неопределено;

КонецФункции

// Итог kedo_invite, если пользователь не закрыл форму КЭДО к сроку: форма остается открытой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Открытая форма КЭДО.
//  Контекст - Структура - Вызов, Приглашаемые, Пропущены.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция ИтогПоСроку(Форма, Контекст) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.ИтогПриглашения(Контекст.Приглашаемые, Контекст.Пропущены, Истина);

КонецФункции

// Завершает вызов kedo_invite после закрытия формы КЭДО.
//
// Параметры:
//  Результат - Произвольный - Результат закрытия формы (форма КЭДО его не возвращает).
//  Контекст - Структура - Вызов, Приглашаемые, Пропущены.
Процедура ПослеЗакрытияФормы(Результат, Контекст) Экспорт

	ИИО_РеестрИнструментовКлиент.Завершить(Контекст.Вызов,
		ИИОК_КЭДОВызовСервера.ИтогПриглашения(Контекст.Приглашаемые, Контекст.Пропущены));

КонецПроцедуры

#КонецОбласти
