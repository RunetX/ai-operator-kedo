// Инструмент kedo_setup: первичная настройка КЭДО.
// Без open - состояние настройки и кратчайший путь. С open в КЭДО 1.27 и новее - подключение одной кнопкой
// (см. ИИОК_ПодключениеКлиент): пользователь входит в сервис и нажимает «Подключить». Иначе или с wizard - штатный
// мастер первого запуска, ответ приходит после его закрытия: входит в сервис, принимает соглашение и запускает обмен
// пользователь кнопками мастера.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента kedo_setup. С open ответ отложен до закрытия мастера.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Состояние настройки или ошибка.
//  Неопределено - Мастер открыт, ответ придет после его закрытия.
Функция Настроить(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Если ИИО_ОтветКлиентСервер.Аргумент(ПараметрыОбработчика.Аргументы, "open", Ложь) <> Истина Тогда
		Возврат ИИОК_КЭДОВызовСервера.СостояниеНастройки();
	КонецЕсли;
	// В КЭДО 1.27 мастер проходит ИИ-оператор: пользователь входит в сервис и нажимает «Подключить».
	Если ИИО_ОтветКлиентСервер.Аргумент(ПараметрыОбработчика.Аргументы, "wizard", Ложь) <> Истина
		И ИИОК_КЭДОВызовСервера.ПодключениеДоступно() Тогда
		ИИОК_ПодключениеКлиент.Начать(ПараметрыОбработчика.Вызов);
		Возврат Неопределено;
	КонецЕсли;
	Подготовка = ИИОК_КЭДОВызовСервера.ПодготовитьОткрытиеМастера();
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовка) Тогда
		Возврат Подготовка;
	КонецЕсли;
	// Второй экземпляр мастера рядом с открытым пользователем (например, из «Текущих дел КЭДО») только запутает.
	Если ОткрытаФорма(Подготовка.ИмяФормы) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
			НСтр("ru = 'Мастер первого запуска КЭДО уже открыт у пользователя.'"),
			НСтр("ru = 'Скажи пользователю закончить в открытом мастере; итог - kedo_setup без open.'"));
	КонецЕсли;

	Контекст = Новый Структура("Вызов, СводкаДо, АдминистраторДобавлен", ПараметрыОбработчика.Вызов,
		Подготовка.СводкаДо, Подготовка.АдминистраторДобавлен);
	Форма = ОткрытьФорму(Подготовка.ИмяФормы, Новый Структура("РежимЗапуска", "Manual"), ,
		Новый УникальныйИдентификатор, , ,
		Новый ОписаниеОповещения("ПослеЗакрытияФормы", ИИОК_НастройкаКлиент, Контекст),
		РежимОткрытияОкнаФормы.Независимый);
	Если Форма = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_FORM",
			НСтр("ru = 'Мастер первого запуска КЭДО не открылся.'"),
			НСтр("ru = 'Скажи пользователю открыть «Текущие дела КЭДО»: мастер открывается оттуда, там видна причина.'"));
	КонецЕсли;
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	ИИО_ФормыКлиент.ОжидатьЗакрытия(Форма, ПараметрыОбработчика.Вызов,
		Новый ОписаниеОповещения("ИтогПоСроку", ИИОК_НастройкаКлиент, Контекст));
	Возврат Неопределено;

КонецФункции

// Итог kedo_setup, если пользователь не закрыл мастер к сроку: мастер остается открытым.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Открытый мастер.
//  Контекст - Структура - Вызов, СводкаДо, АдминистраторДобавлен.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция ИтогПоСроку(Форма, Контекст) Экспорт

	Возврат ИИОК_КЭДОВызовСервера.ИтогНастройки(Контекст.СводкаДо, Истина, Контекст.АдминистраторДобавлен);

КонецФункции

// Завершает вызов kedo_setup после закрытия мастера.
//
// Параметры:
//  Результат - Произвольный - Результат закрытия формы (мастер его не возвращает).
//  Контекст - Структура - Вызов, СводкаДо, АдминистраторДобавлен.
Процедура ПослеЗакрытияФормы(Результат, Контекст) Экспорт

	ИИО_РеестрИнструментовКлиент.Завершить(Контекст.Вызов,
		ИИОК_КЭДОВызовСервера.ИтогНастройки(Контекст.СводкаДо, Ложь, Контекст.АдминистраторДобавлен));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОткрытаФорма(ИмяФормы)

	Окна = ПолучитьОкна();
	Если Окна = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Окно Из Окна Цикл
		Для Каждого Форма Из Окно.Содержимое Цикл
			Если Форма.ИмяФормы = ИмяФормы Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
