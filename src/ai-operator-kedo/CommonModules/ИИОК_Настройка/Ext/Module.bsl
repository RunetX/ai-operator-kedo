// Первичная настройка КЭДО штатным мастером первого запуска (инструмент kedo_setup).
// Состояние настройки — по данным расширения КЭДО в базе, тем же признаком, что у самого расширения: есть
// сопоставленная организация КЭДО с сотрудниками сервиса. Входит в сервис, принимает соглашение и запускает
// обмен пользователь кнопками мастера.

#Область СлужебныйПрограммныйИнтерфейс

// Есть ли в расширении КЭДО мастер первого запуска.
//
// Возвращаемое значение:
//  Булево
Функция МастерЕсть() Экспорт

	Возврат Метаданные.ОбщиеФормы.Найти(ИмяФормыМастера()) <> Неопределено;

КонецФункции

// Полное имя формы мастера первого запуска КЭДО.
//
// Возвращаемое значение:
//  Строка
Функция ИмяФормыМастера() Экспорт

	Возврат "КонтурКэдоМастерПервогоЗапуска";

КонецФункции

// Проверка перед открытием мастера: мастер есть в расширении и пользователь может его открыть.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели.
//  Неопределено - Мастер можно открыть.
Функция ПроверитьОткрытие() Экспорт

	Если Не МастерЕсть() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("KEDO_FORM",
			НСтр("ru = 'В этой версии расширения КЭДО нет мастера первого запуска.'"),
			НСтр("ru = 'Скажи пользователю настроить КЭДО в «Текущих делах КЭДО» или обновить расширение КЭДО.'"));
	КонецЕсли;
	Если Не ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.Найти(ИмяФормыМастера())) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'У пользователя нет прав КЭДО: мастер первого запуска ему недоступен.'"),
			НСтр("ru = 'Скажи пользователю, что КЭДО настраивает администратор 1С или пользователь с ролью КЭДО.'"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Снимок первичной настройки КЭДО: до открытия мастера и после его закрытия.
//
// Возвращаемое значение:
//  Структура:
//   * Настроено - Булево - Есть сопоставленная организация КЭДО с сотрудниками сервиса.
//   * Организации - ТаблицаЗначений - ОрганизацияКЭДО, Организация, Сопоставлена, ВСервисе, Связано.
//   * Шаг - Число - Текущий шаг мастера, 0 — мастер не открывался.
//   * ОбменВключен - Булево - Регламентный обмен с сервисом КЭДО включён, и у него есть пользователь.
Функция Снимок() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.organizations_id КАК ОрганизацияID,
	|	КОЛИЧЕСТВО(*) КАК ВСервисе,
	|	СУММА(ВЫБОР
	|			КОГДА Связь.Объект ССЫЛКА Справочник.Сотрудники
	|					И Связь.Объект <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Связано
	|ПОМЕСТИТЬ Сотрудники
	|ИЗ
	|	РегистрСведений.КЭДО_Employees КАК Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Владелец.Идентификатор = Сотрудники.organizations_id)
	|			И (Связь.Ссылка.Идентификатор = Сотрудники.id)
	|ГДЕ
	|	Сотрудники.deleted_at = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	Сотрудники.organizations_id
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Ссылка КАК ОрганизацияКЭДО,
	|	Организации.Организация КАК Организация,
	|	Организации.Сопоставлен КАК Сопоставлена,
	|	ЕСТЬNULL(Сотрудники.ВСервисе, 0) КАК ВСервисе,
	|	ЕСТЬNULL(Сотрудники.Связано, 0) КАК Связано
	|ИЗ
	|	Справочник.КЭДО_Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Сотрудники КАК Сотрудники
	|		ПО (Сотрудники.ОрганизацияID = Организации.Идентификатор)
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	Организации = Запрос.Выполнить().Выгрузить();

	Настроено = Ложь;
	Для Каждого Строка Из Организации Цикл
		Настроено = Настроено Или Строка.Сопоставлена И Строка.ВСервисе > 0;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Настроено", Настроено);
	Результат.Вставить("Организации", Организации);
	Результат.Вставить("Шаг", ШагМастера());
	Результат.Вставить("ОбменВключен", ОбменВключен());
	Возврат Результат;

КонецФункции

// Сводка снимка настройки строкой: клиент хранит её до закрытия мастера, итог сравнивает с новым снимком.
//
// Возвращаемое значение:
//  Строка
Функция СводкаСнимка() Экспорт

	Возврат Сводка(Снимок());

КонецФункции

// Ответ kedo_setup без открытия мастера: состояние настройки и кратчайший путь по мастеру.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция Состояние() Экспорт

	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.КЭДО_Организации) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'У пользователя нет прав КЭДО.'"),
			НСтр("ru = 'Скажи пользователю, что КЭДО настраивает администратор 1С или пользователь с ролью КЭДО.'"));
	КонецЕсли;
	Текущий = Снимок();
	Ответ = ОписаниеНастройки(Текущий);
	Если Текущий.Настроено Тогда
		Ответ.Вставить("hint", НСтр("ru = 'КЭДО уже настроено. Проблемы — kedo_diagnose, приглашения — kedo_employees и kedo_invite. Ещё одну организацию настраивают в мастере: kedo_setup с open: true.'"));
	ИначеЕсли МастерЕсть() Тогда
		Ответ.Вставить("hint", НСтр("ru = 'Назови пользователю шаги из guide и вызови kedo_setup с open: true — откроется мастер КЭДО.'"));
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

// Ответ kedo_setup после закрытия мастера или по сроку ожидания.
//
// Параметры:
//  СводкаДо - Строка - см. СводкаСнимка до открытия мастера.
//  ФормаОткрыта - Булево - Итог по сроку ожидания: мастер ещё открыт.
//
// Возвращаемое значение:
//  Структура - Ответ для модели.
Функция Итог(Знач СводкаДо, Знач ФормаОткрыта = Ложь) Экспорт

	Стало = Снимок();
	Ответ = ОписаниеНастройки(Стало);
	Ответ.Вставить("opened", Истина);
	Изменилось = СводкаДо <> Сводка(Стало);
	Если ФормаОткрыта Тогда
		Ответ.Вставить("form_open", Истина);
		Ответ.Вставить("hint", НСтр("ru = 'Мастер КЭДО ещё открыт: пользователь продолжает. Не открывай его снова; итог — kedo_setup без open.'"));
	ИначеЕсли Не Изменилось Тогда
		Ответ.Вставить("cancelled", Истина);
		Ответ.Вставить("hint", НСтр("ru = 'Мастер закрыт без изменений. Продолжить — kedo_setup с open: true.'"));
	ИначеЕсли Стало.Настроено Тогда
		Ответ.Вставить("hint", НСтр("ru = 'КЭДО настроено. Дальше — пригласить сотрудников: kedo_employees со status not_connected, затем kedo_invite.'"));
	Иначе
		Ответ.Вставить("hint", НСтр("ru = 'Мастер закрыт до конца настройки. Назови оставшийся шаг (wizard_step) и кнопку на нём из guide; продолжить — kedo_setup с open: true.'"));
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеНастройки(Снимок)

	Организации = Новый Массив;
	Несопоставленных = 0;
	Для Каждого Строка Из Снимок.Организации Цикл
		Если Строка.Сопоставлена И ЗначениеЗаполнено(Строка.Организация) Тогда
			Организации.Добавить(Новый Структура("organization, employees_in_kedo, employees_linked",
				Строка.Организация, Строка.ВСервисе, Строка.Связано));
		Иначе
			Несопоставленных = Несопоставленных + 1;
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("setup_done", Снимок.Настроено);
	Ответ.Вставить("kedo_version", ВерсияКЭДО());
	Ответ.Вставить("organizations", Организации);
	Если Несопоставленных > 0 Тогда
		Ответ.Вставить("unmapped_kedo_organizations", Несопоставленных);
	КонецЕсли;
	Ответ.Вставить("exchange_enabled", Снимок.ОбменВключен);
	Если Не Снимок.Настроено Тогда
		Шаги = ШагиМастера();
		Если Снимок.Шаг > 0 И Снимок.Шаг <= Шаги.Количество() Тогда
			Ответ.Вставить("wizard_step", Шаги[Снимок.Шаг - 1]);
		КонецЕсли;
		Ответ.Вставить("guide", ПутьПоУмолчанию());
	КонецЕсли;
	Ответ.Вставить("source", НСтр("ru = 'Данные расширения КЭДО в 1С: организации КЭДО и их сопоставление, сотрудники сервиса, состояние мастера первого запуска'"));
	Возврат Ответ;

КонецФункции

Функция Сводка(Снимок)

	ВСервисе = 0;
	Связано = 0;
	Сопоставлено = 0;
	Для Каждого Строка Из Снимок.Организации Цикл
		ВСервисе = ВСервисе + Строка.ВСервисе;
		Связано = Связано + Строка.Связано;
		Сопоставлено = Сопоставлено + ?(Строка.Сопоставлена, 1, 0);
	КонецЦикла;
	Возврат СтрШаблон("%1|%2|%3|%4|%5|%6", Снимок.Настроено, Снимок.Организации.Количество(), Сопоставлено,
		ВСервисе, Связано, Формат(Снимок.Шаг, "ЧН=0; ЧГ=") + ?(Снимок.ОбменВключен, "+", "-"));

КонецФункции

// В 1.27 мастер другой: первый шаг «Права и доступы», организации и соглашения — на одном шаге.
Функция МастерВерсии127()

	Возврат Метаданные.РегистрыСведений.Найти("КонтурКэдоСостояниеЗадачПланаОбменаССервисом") <> Неопределено;

КонецФункции

Функция ШагиМастера()

	Если МастерВерсии127() Тогда
		Шаги = "Права и доступы,Вход в сервис,Мои организации,Сотрудники,Типы документов,Другие настройки";
	Иначе
		Шаги = "Вход в сервис,Выбор организации,Настройка обмена,Сотрудники,Типы документов,Завершение";
	КонецЕсли;
	Возврат СтрРазделить(Шаги, ",");

КонецФункции

// Кнопки мастера, которые оставляют настройки по умолчанию.
Функция ПутьПоУмолчанию()

	Путь = Новый Массив;
	Если МастерВерсии127() Тогда
		Путь.Добавить(НСтр("ru = '«Права и доступы»: «Далее» — пользователь регламентных заданий и прокси уже заполнены.'"));
		Путь.Добавить(НСтр("ru = '«Вход в сервис»: «Войти» и подтвердить вход в браузере по ссылке или QR-коду.'"));
		Путь.Добавить(НСтр("ru = '«Мои организации»: ненастроенные организации уже отмечены — «Принять соглашения», затем «Выполнить обмен».'"));
		Путь.Добавить(НСтр("ru = '«Сотрудники», «Типы документов» и «Другие настройки»: «Далее».'"));
		Путь.Добавить(НСтр("ru = '«Завершить».'"));
	Иначе
		Путь.Добавить(НСтр("ru = 'Первый экран (только у администратора): «Пропустить», если настраиваете сами; «Передать» — если настройку продолжит другой пользователь с профилем КЭДО.'"));
		Путь.Добавить(НСтр("ru = '«Вход в сервис»: «Войти» и подтвердить вход в браузере по ссылке или QR-коду.'"));
		Путь.Добавить(НСтр("ru = '«Выбор организации»: в строке своей организации — «Принять соглашение и продолжить»; организация 1С подбирается по ИНН.'"));
		Путь.Добавить(НСтр("ru = '«Настройка обмена»: «Выполнить обмен».'"));
		Путь.Добавить(НСтр("ru = '«Сотрудники» и «Типы документов»: «Пропустить».'"));
		Путь.Добавить(НСтр("ru = '«Завершить».'"));
	КонецЕсли;
	Возврат Путь;

КонецФункции

Функция ШагМастера()

	Если Метаданные.РегистрыСведений.Найти("КонтурКэдоНастройкиМастераПервогоЗапуска") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Настройки.ТекущийШаг) КАК Шаг
	|ИЗ
	|	РегистрСведений.КонтурКэдоНастройкиМастераПервогоЗапуска КАК Настройки");
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Формат состояния мастера меняется между версиями КЭДО: без шага итог всё равно считается по данным.
		Возврат 0;
	КонецПопытки;
	Выборка.Следующий();
	Возврат ?(ТипЗнч(Выборка.Шаг) = Тип("Число"), Выборка.Шаг, 0);

КонецФункции

Функция ОбменВключен()

	Задание = Метаданные.РегламентныеЗадания.Найти("КонтурКэдоОбменССервисом");
	Если Задание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// Регламентные задания читаются только с административными правами; кадровику достаточно признака.
	УстановитьПривилегированныйРежим(Истина);
	Предопределенное = РегламентныеЗадания.НайтиПредопределенное(Задание);
	// Задание включено уже в метаданных расширения, а пользователя ему назначает мастер на шаге обмена.
	Возврат Предопределенное <> Неопределено И Предопределенное.Использование
		И ЗначениеЗаполнено(Предопределенное.ИмяПользователя);

КонецФункции

Функция ВерсияКЭДО()

	Модуль = Метаданные.ОбщиеМодули.Найти("КЭДО_Сервер");
	Если Модуль = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Расширение = Модуль.РасширениеКонфигурации();
	Возврат ?(Расширение = Неопределено, "", Расширение.Версия);

КонецФункции

#КонецОбласти
