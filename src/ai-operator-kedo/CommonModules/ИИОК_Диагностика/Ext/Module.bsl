// Диагностика КЭДО: почему у сотрудника или организации не работает КЭДО.
// Проверки идут только по данным расширения КЭДО в базе - копии данных сервиса и служебным регистрам; в сервис модуль
// не обращается. Условия повторяют «Текущие дела КЭДО»: статус сотрудника, «Нет связи с 1С», «Данные в КЭДО
// не соответствуют 1С», срок электронной подписи, предупреждения об обновлении структуры и синхронизации сотрудников.
// Подписка на модуль интеграции проверяется так же, как расширение КЭДО проверяет ее перед отправкой документов.
// Данные читаются с правами пользователя: без прав на данные расширения КЭДО диагностика не выполняется.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента kedo_diagnose.
// С employees - проверки по каждому сотруднику и его организации; без них - по организациям и сводка проблем
// работающих сотрудников.
//
// Параметры:
//  Аргументы - Структура, Соответствие - employees, organization.
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка.
Функция Диагностика(Знач Аргументы) Экспорт

	Если Не ДоступныДанныеКЭДО() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'У пользователя нет прав на данные расширения КЭДО, которые проверяет диагностика.'"),
			НСтр("ru = 'Скажи пользователю, что диагностику КЭДО выполняет пользователь с ролью КЭДО или администратор 1С.'"));
	КонецЕсли;
	Переданные = Новый Массив;
	Ошибка = РазобратьСотрудников(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "employees", Новый Массив), Переданные);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Организация = Неопределено;
	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "organization");
	Если ЗначениеЗаполнено(Значение) Тогда
		Организация = ИИО_Ответ.СсылкаИзСтроки(Значение);
		Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Не организация: %1.'"), Строка(Значение)),
				НСтр("ru = 'Передай ref организации из ответа инструмента или не задавай organization.'"));
		КонецЕсли;
	КонецЕсли;

	Контекст = Новый Структура("Имена, ПДн", Новый Соответствие, Новый Массив);
	Ответ = Новый Структура;
	Если Переданные.Количество() > 0 Тогда
		Проверка = ПроверитьПереданных(Переданные, Контекст);
	Иначе
		Проверка = ПроверитьВсех(Организация, Контекст);
	КонецЕсли;
	ВерсияКЭДО = ИИОК_КЭДО.ВерсияРасширенияКЭДО();
	Ответ.Вставить("organizations", ПроверитьОрганизации(Проверка.Организации, ВерсияКЭДО));
	Если Переданные.Количество() > 0 Тогда
		Ответ.Вставить("employees", Проверка.Сотрудники);
	Иначе
		Ответ.Вставить("employees_checked", Проверка.Проверено);
		Ответ.Вставить("employee_problems", Проверка.Сводка);
	КонецЕсли;
	Ответ.Вставить("kedo_extension", Новый Структура("version, problems", ВерсияКЭДО, ПроверитьРасширение(Контекст)));
	Ответ.Вставить("limits", НСтр("ru = 'Проверено по данным расширения КЭДО в этой базе 1С, без обращения к сервису КЭДО. Не проверялись: документы на подписании; код производственного календаря; то, что видно только в сервисе: доставка писем и SMS, блокировка учётной записи, способы подписи в организации, права пользователя в сервисе.'"));
	Ответ.Вставить("source", Новый Структура("data", НСтр("ru = 'Данные расширения КЭДО в базе: сотрудники и приглашения сервиса, сертификаты, подписки, очередь обновления, журнал событий КЭДО; кадровые и контактные данные ЗУП'")));
	Если Контекст.ПДн.Количество() > 0 Тогда
		Ответ.Вставить("pii_context", Контекст.ПДн);
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Сотрудники

Функция РазобратьСотрудников(Ссылки, Сотрудники)

	Если ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылки);
	КонецЕсли;
	Если Ссылки.Количество() > МаксимумСотрудников() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Слишком много сотрудников: %1, можно не больше %2.'"), Ссылки.Количество(),
				МаксимумСотрудников()),
			НСтр("ru = 'Для сводки по всем сотрудникам вызови kedo_diagnose без employees.'"));
	КонецЕсли;
	Возврат ИИОК_КЭДО.РазобратьСотрудников(Ссылки, Сотрудники);

КонецФункции

// Проверка переданных сотрудников. КЭДО работает с головным сотрудником, поэтому проверяется он.
Функция ПроверитьПереданных(Переданные, Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ГоловнойСотрудник КАК Головной,
	|	Сотрудники.ГоловнойСотрудник.ГоловнаяОрганизация КАК Организация
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&Сотрудники)";
	Запрос.УстановитьПараметр("Сотрудники", Переданные);
	Головные = Запрос.Выполнить().Выгрузить();

	Сотрудники = Новый Массив;
	Для Каждого Строка Из Головные Цикл
		Если Сотрудники.Найти(Строка.Головной) = Неопределено Тогда
			Сотрудники.Добавить(Строка.Головной);
		КонецЕсли;
	КонецЦикла;
	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Сотрудники = Сотрудники;
	Отбор.ТолькоРаботающие = Ложь;
	Строки = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	ПоСотрудникам = ПроблемыСотрудников(Строки, Контекст);

	Организации = Новый Массив;
	Описания = Новый Массив;
	Для Каждого Переданный Из Переданные Цикл
		Головная = Головные.Найти(Переданный, "Сотрудник");
		Если Головная = Неопределено Тогда
			Описание = Новый Структура("employee, problems", Переданный, Новый Массив);
			ДобавитьПроблему(Описание.problems, "not_found", "blocker",
				НСтр("ru = 'Сотрудник не найден или нет прав на его просмотр.'"));
			Описания.Добавить(Описание);
			Продолжить;
		КонецЕсли;
		Строка = Строки.Найти(Головная.Головной, "Сотрудник");
		Если Строка = Неопределено Тогда
			Описание = Новый Структура("employee, organization, problems", Головная.Головной, Головная.Организация,
				Новый Массив);
			ДобавитьПроблему(Описание.problems, "organization_not_mapped", "blocker",
				НСтр("ru = 'Организация сотрудника не сопоставлена с организацией в КЭДО: для КЭДО этого сотрудника нет, пригласить его и отправить ему документы нельзя.'"),
				НСтр("ru = 'Сопоставить организацию с организацией КЭДО в настройках расширения КЭДО.'"));
			ДобавитьОрганизацию(Организации, Головная.Организация);
		Иначе
			Описание = ОписаниеСотрудника(Строка, ПоСотрудникам.Получить(Строка.Сотрудник));
			ДобавитьОрганизацию(Организации, Строка.Организация);
		КонецЕсли;
		Если Головная.Головной <> Переданный Тогда
			Описание.problems.Вставить(0, НоваяПроблема("head_employee_checked", "info",
				НСтр("ru = 'Передано не основное место работы: КЭДО работает с головным сотрудником, проверен он.'")));
		КонецЕсли;
		Описания.Добавить(Описание);
	КонецЦикла;

	Возврат Новый Структура("Сотрудники, Организации", Описания, Организации);

КонецФункции

// Проверка всех работающих сотрудников организаций, сопоставленных в КЭДО: сводка по кодам проблем.
Функция ПроверитьВсех(Организация, Контекст)

	Отбор = ИИОК_КЭДО.НовыйОтбор();
	Отбор.Организация = Организация;
	Строки = ИИОК_КЭДО.ДанныеСотрудников(Отбор);
	ПоСотрудникам = ПроблемыСотрудников(Строки, Контекст);

	Сводка = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Для Каждого Проблема Из ПоСотрудникам.Получить(Строка.Сотрудник) Цикл
			Итог = Сводка.Получить(Проблема.code);
			Если Итог = Неопределено Тогда
				Итог = Новый Структура("code, severity, count, employees, text", Проблема.code, Проблема.severity, 0,
					Новый Массив, Проблема.text);
				Если Проблема.Свойство("fix") Тогда
					Итог.Вставить("fix", Проблема.fix);
				КонецЕсли;
				Сводка.Вставить(Проблема.code, Итог);
				Порядок.Добавить(Итог);
			КонецЕсли;
			Итог.count = Итог.count + 1;
			Если Итог.employees.Количество() < ПримеровВСводке() Тогда
				Итог.employees.Добавить(Строка.Сотрудник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Организации = Новый Массив;
	Если Организация <> Неопределено Тогда
		Организации.Добавить(Организация);
	Иначе
		Для Каждого Сопоставленная Из СопоставленныеОрганизации() Цикл
			Организации.Добавить(Сопоставленная);
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Проверено, Сводка, Организации", Строки.Количество(), УпорядоченныеПроблемы(Порядок),
		Организации);

КонецФункции

// Проблемы сотрудников из ИИОК_КЭДО.ДанныеСотрудников.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Сотрудники
//   * Значение - Массив из см. НоваяПроблема
Функция ПроблемыСотрудников(Строки, Контекст)

	Результат = Новый Соответствие;
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Детали = ДеталиСотрудников(Строки.ВыгрузитьКолонку("Сотрудник"));
	ОрганизацииID = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если ОрганизацииID.Найти(Строка.ОрганизацияID) = Неопределено Тогда
			ОрганизацииID.Добавить(Строка.ОрганизацияID);
		КонецЕсли;
	КонецЦикла;
	Несвязанные = НесвязанныеПоФИО(ОрганизацииID);
	Настройки = НастройкиСравнения();

	Для Каждого Строка Из Строки Цикл
		Проблемы = ПроблемыСотрудника(Строка, Детали, Несвязанные, Настройки);
		Результат.Вставить(Строка.Сотрудник, Проблемы);
		Лицо = Детали.Лица.Получить(Строка.Сотрудник);
		Если Лицо <> Неопределено Тогда
			ДобавитьИмя(Контекст, Лицо.ФИО);
			Для Каждого Проблема Из Проблемы Цикл
				Если Проблема.code = "sync_error" Тогда
					ДобавитьПДн(Контекст, Лицо.ФИО);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроблемыСотрудника(Строка, Детали, Несвязанные, Настройки)

	Проблемы = Новый Массив;
	Сотрудник = Строка.Сотрудник;
	Лицо = Детали.Лица.Получить(Сотрудник);
	Если ЗначениеЗаполнено(Строка.ДатаУвольнения) И Строка.ДатаУвольнения < ТекущаяДатаСеанса() Тогда
		ДобавитьПроблему(Проблемы, "dismissed", "info",
			СтрШаблон(НСтр("ru = 'Уволен в 1С %1.'"), ФорматДаты(Строка.ДатаУвольнения)));
	КонецЕсли;

	Расхождения = Новый Массив;
	ТекстРасхождений = "";
	Если Строка.Статус = "not_connected" Или Строка.Статус = "invite_expired" Тогда
		Если Строка.Статус = "not_connected" Тогда
			ДобавитьПроблему(Проблемы, "not_connected", "blocker",
				НСтр("ru = 'Не подключен к КЭДО: приглашения нет, документы ему не отправить.'"),
				НСтр("ru = 'Пригласить через kedo_invite: откроется форма КЭДО, отправляет пользователь кнопкой «Пригласить».'"));
		Иначе
			ДобавитьПроблему(Проблемы, "invite_expired", "blocker",
				НСтр("ru = 'Приглашение в КЭДО просрочено: сотрудник не принял его вовремя.'"),
				НСтр("ru = 'Отправить приглашение повторно через kedo_invite.'"));
		КонецЕсли;
		Если Не Строка.ЕстьПочта И Не Строка.ЕстьТелефон Тогда
			ДобавитьПроблему(Проблемы, "no_invite_contact", "blocker",
				НСтр("ru = 'В 1С нет ни почты, ни мобильного телефона сотрудника: приглашение не на что отправить.'"),
				НСтр("ru = 'Заполнить почту или мобильный телефон в контактной информации физического лица.'"));
		ИначеЕсли Не Строка.ЕстьПочта Тогда
			ДобавитьПроблему(Проблемы, "no_email", "info",
				НСтр("ru = 'Почты в 1С нет: приглашение можно отправить только по SMS.'"));
		КонецЕсли;
		Если Лицо <> Неопределено Тогда
			Вид = Несвязанные.Получить(КлючФИО(Строка.ОрганизацияID, Лицо.ФИО));
			Если Вид <> Неопределено Тогда
				ДобавитьПроблему(Проблемы, "probably_unlinked", "warning",
					?(Вид = "employee",
						НСтр("ru = 'В КЭДО уже есть сотрудник с такими же ФИО, но он не связан с этим сотрудником 1С. Скорее всего, это тот же человек.'"),
						НСтр("ru = 'В КЭДО уже есть приглашение на такие же ФИО, но оно не связано с этим сотрудником 1С. Скорее всего, это тот же человек.'")),
					НСтр("ru = 'Установить связь в «Текущих делах КЭДО» (в строке с предупреждением «Нет связи с 1С» - «Установить связь»), а не приглашать заново.'"));
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Строка.Статус = "invited" Тогда
		Приглашение = Детали.Приглашения.Получить(Сотрудник);
		ПоSMS = Приглашение <> Неопределено И Приглашение.ПоSMS;
		ДобавитьПроблему(Проблемы, "invite_pending", "warning",
			?(ПоSMS, НСтр("ru = 'Приглашение в КЭДО отправлено по SMS и ещё не принято.'"),
				НСтр("ru = 'Приглашение в КЭДО отправлено по почте и ещё не принято.'")),
			НСтр("ru = 'Попросить сотрудника принять приглашение по ссылке из письма или SMS. Отозвать приглашение и отправить заново можно в «Текущих делах КЭДО».'"));
		Если Лицо <> Неопределено И Приглашение <> Неопределено Тогда
			Расхождения = РасхожденияПриглашения(Строка, Лицо, Приглашение, Настройки);
			ТекстРасхождений = НСтр("ru = 'Если в приглашении неверная почта или телефон, оно не дойдёт: отзовите его и отправьте заново в «Текущих делах КЭДО». Остальные данные передаются в КЭДО после подключения.'");
		КонецЕсли;

	Иначе
		Сервис = Детали.Сервис.Получить(Сотрудник);
		Если Лицо <> Неопределено И Сервис <> Неопределено Тогда
			ДолжностиНеПереданы = Детали.ДолжностиНеПереданы.Получить(Сотрудник) <> Неопределено;
			Расхождения = РасхожденияСотрудника(Строка, Лицо, Сервис, ДолжностиНеПереданы, Настройки);
			ТекстРасхождений = НСтр("ru = 'Передать данные в КЭДО: «Текущие дела КЭДО» → «Передать в КЭДО данные по выделенным сотрудникам»; если ошибка в 1С - сначала исправить её.'");
		КонецЕсли;
		ДобавитьПроблемыПодписи(Проблемы, Сервис, Детали.Сертификаты.Получить(Сотрудник));
	КонецЕсли;

	Если Расхождения.Количество() > 0 Тогда
		Проблема = НоваяПроблема("data_mismatch", "warning",
			СтрШаблон(НСтр("ru = 'Данные в КЭДО не совпадают с 1С: %1.'"),
				СтрСоединить(НазванияПолей(Расхождения), ", ")),
			ТекстРасхождений);
		Проблема.Вставить("facts", Новый Структура("fields", Расхождения));
		Проблемы.Добавить(Проблема);
	КонецЕсли;

	Синхронизация = Детали.Синхронизация.Получить(Сотрудник);
	Если Синхронизация <> Неопределено Тогда
		Если Синхронизация.Результат = 0 И ЗначениеЗаполнено(Синхронизация.ОписаниеОшибки) Тогда
			ДобавитьПроблему(Проблемы, "sync_error", "warning",
				СтрШаблон(НСтр("ru = 'Последняя передача кадровых данных сотрудника в КЭДО (%1) завершилась ошибкой: %2'"),
					ФорматДатыВремени(Синхронизация.Период), СокрЛП(Синхронизация.ОписаниеОшибки)),
				НСтр("ru = 'Посмотреть «Отчёт синхронизации» в «Текущих делах КЭДО», исправить причину и передать данные повторно.'"));
		ИначеЕсли Синхронизация.Результат = -1 Тогда
			ДобавитьПроблему(Проблемы, "dismissal_sync_forbidden", "info",
				НСтр("ru = 'Передача увольнения этого сотрудника в КЭДО запрещена вручную в настройках КЭДО.'"));
		КонецЕсли;
	КонецЕсли;

	Возврат УпорядоченныеПроблемы(Проблемы);

КонецФункции

// Поля, которые «Текущие дела КЭДО» сравнивают для предупреждения «Данные в КЭДО не соответствуют 1С».
Функция РасхожденияСотрудника(Строка, Лицо, Сервис, ДолжностиНеПереданы, Настройки)

	Поля = Новый Массив;
	Если Лицо.ФИО <> Сервис.ФИО Тогда
		Поля.Добавить("fio");
	КонецЕсли;
	Если Лицо.Почта <> Сервис.Почта Тогда
		Поля.Добавить("email");
	КонецЕсли;
	Если ТелефонКЭДО(Лицо.Телефон) <> Сервис.Телефон Тогда
		Поля.Добавить("phone");
	КонецЕсли;
	Если Лицо.ДатаРождения <> Сервис.ДатаРождения Тогда
		Поля.Добавить("birthdate");
	КонецЕсли;
	Если Уволен1С(Строка.ДатаУвольнения, Настройки) Тогда
		Поля.Добавить("dismissal");
	КонецЕсли;
	Если ДолжностиНеПереданы Тогда
		Поля.Добавить("position");
	КонецЕсли;
	Если Настройки.ПередаватьТабельныйНомер И Сервис.ТабельныйНомер <> Лицо.ТабельныйНомер Тогда
		Поля.Добавить("personnel_number");
	КонецЕсли;
	Возврат Поля;

КонецФункции

// Для приглашения «Текущие дела КЭДО» сравнивают ФИО, почту, дату рождения и увольнение. Телефон приглашения
// сравнивается, только если оно отправлено по SMS: иначе телефона в приглашении нет.
Функция РасхожденияПриглашения(Строка, Лицо, Приглашение, Настройки)

	Поля = Новый Массив;
	Если Лицо.ФИО <> Приглашение.ФИО Тогда
		Поля.Добавить("fio");
	КонецЕсли;
	Если Лицо.Почта <> Приглашение.Почта Тогда
		Поля.Добавить("email");
	КонецЕсли;
	Если Приглашение.ПоSMS И ТелефонКЭДО(Лицо.Телефон) <> Приглашение.Телефон Тогда
		Поля.Добавить("phone");
	КонецЕсли;
	Если Лицо.ДатаРождения <> Приглашение.ДатаРождения Тогда
		Поля.Добавить("birthdate");
	КонецЕсли;
	Если Уволен1С(Строка.ДатаУвольнения, Настройки) Тогда
		Поля.Добавить("dismissal");
	КонецЕсли;
	Возврат Поля;

КонецФункции

Функция НазванияПолей(Поля)

	Названия = Новый Соответствие;
	Названия.Вставить("fio", НСтр("ru = 'ФИО'"));
	Названия.Вставить("email", НСтр("ru = 'почта'"));
	Названия.Вставить("phone", НСтр("ru = 'телефон'"));
	Названия.Вставить("birthdate", НСтр("ru = 'дата рождения'"));
	Названия.Вставить("dismissal", НСтр("ru = 'увольнение'"));
	Названия.Вставить("position", НСтр("ru = 'должность'"));
	Названия.Вставить("personnel_number", НСтр("ru = 'табельный номер'"));
	Результат = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Результат.Добавить(Названия.Получить(Поле));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Уволен ли сотрудник для КЭДО - как в «Текущих делах КЭДО» с учетом настройки «Синхронизировать текущей датой».
Функция Уволен1С(ДатаУвольнения, Настройки)

	Если Не ЗначениеЗаполнено(ДатаУвольнения) Тогда
		Возврат Ложь;
	ИначеЕсли Настройки.СинхронизироватьТекущейДатой Тогда
		Возврат НачалоДня(ДатаУвольнения) <= НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Возврат КонецДня(ДатаУвольнения) < ТекущаяДатаСеанса();

КонецФункции

// Телефон из 1С в виде, в котором его хранит КЭДО: «+» и цифры.
Функция ТелефонКЭДО(Телефон)

	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Возврат "";
	КонецЕсли;
	Цифры = "";
	Для Номер = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Номер, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат "+" + Цифры;

КонецФункции

Функция НастройкиСравнения()

	Настройки = Новый Структура;
	Настройки.Вставить("ПередаватьТабельныйНомер", ИИОК_КЭДО.НастройкаКЭДО("ПередаватьТабельныйНомер") = "Да");
	Настройки.Вставить("СинхронизироватьТекущейДатой",
		ИИОК_КЭДО.НастройкаКЭДОИзРегистра("СинхронизироватьТекущейДатой") = "Да");
	Возврат Настройки;

КонецФункции

// Подпись нужна сотруднику, если в организации документы подписывают НЭП или КЭП; для простой подписи сертификат
// не нужен, а какие подписи включены в организации, в базе не хранится.
Процедура ДобавитьПроблемыПодписи(Проблемы, Сервис, СертификатыСправочника)

	Сертификаты = СертификатыСотрудника(Сервис, СертификатыСправочника);
	Заявка = ?(Сервис = Неопределено, "", СокрЛП(Сервис.ЗаявкаНЭП));
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Лучший = Неопределено;
	Для Каждого Сертификат Из Сертификаты Цикл
		Если Лучший = Неопределено Или Сертификат.valid_to > Лучший.valid_to Тогда
			Лучший = Сертификат;
		КонецЕсли;
	КонецЦикла;

	ТекстВыпуска = НСтр("ru = 'Выпустить НЭП в «Текущих делах КЭДО» (команда «Выпустить НЭП»).'");
	Если ЗначениеЗаполнено(Заявка) Тогда
		ДобавитьПроблему(Проблемы, "nep_request", "info", СтрШаблон(НСтр("ru = 'Заявка на выпуск НЭП: %1.'"), Заявка));
	КонецЕсли;
	Если Лучший = Неопределено Тогда
		Если Не ЗначениеЗаполнено(Заявка) Тогда
			ДобавитьПроблему(Проблемы, "no_certificate", "warning",
				НСтр("ru = 'По данным КЭДО у сотрудника нет НЭП или КЭП: документы, которые в организации подписывают НЭП или КЭП, он подписать не сможет. Для простой электронной подписи сертификат не нужен.'"),
				ТекстВыпуска);
		КонецЕсли;
	ИначеЕсли Лучший.valid_to < Сегодня Тогда
		ДобавитьПроблему(Проблемы, "certificate_expired", "warning",
			СтрШаблон(НСтр("ru = 'Все сертификаты сотрудника истекли, последний (%1) действовал до %2.'"), Лучший.type,
				ФорматДаты(Лучший.valid_to)),
			ТекстВыпуска);
	Иначе
		Осталось = Цел((Лучший.valid_to - Сегодня) / 86400);
		Если Осталось <= ДнейДоОкончанияПодписи() Тогда
			ДобавитьПроблему(Проблемы, "certificate_expiring", "warning",
				СтрШаблон(НСтр("ru = 'Сертификат %1 действует до %2, осталось %3 дн.'"), Лучший.type,
					ФорматДаты(Лучший.valid_to), Осталось),
				НСтр("ru = 'Выпустить новую НЭП заранее в «Текущих делах КЭДО».'"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Сертификаты из сведений сервиса («НЭП до 23.12.2026, КЭП до 15.08.2027») и введенные вручную в «Текущих делах КЭДО».
Функция СертификатыСотрудника(Сервис, СертификатыСправочника)

	Сертификаты = Новый Массив;
	Если Сервис <> Неопределено Тогда
		Для Каждого Часть Из СтрРазделить(Сервис.СертификатыЭП, ",", Ложь) Цикл
			Позиция = СтрНайти(Часть, " до ");
			Если Позиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			Дата = ДатаИзСтроки(СокрЛП(Сред(Часть, Позиция + 4)));
			Если Дата <> Неопределено Тогда
				ДобавитьСертификат(Сертификаты, СокрЛП(Лев(Часть, Позиция - 1)), Дата);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если СертификатыСправочника <> Неопределено Тогда
		Для Каждого Сертификат Из СертификатыСправочника Цикл
			ДобавитьСертификат(Сертификаты, Сертификат.type, Сертификат.valid_to);
		КонецЦикла;
	КонецЕсли;
	Возврат Сертификаты;

КонецФункции

Процедура ДобавитьСертификат(Сертификаты, Тип, Дата)

	Для Каждого Сертификат Из Сертификаты Цикл
		Если Сертификат.type = Тип И Сертификат.valid_to = Дата Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Сертификаты.Добавить(Новый Структура("type, valid_to", Тип, Дата));

КонецПроцедуры

// Дата вида 23.12.2026.
Функция ДатаИзСтроки(Текст)

	Части = СтрРазделить(Текст, ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Лев(Части[2], 4)), Число(Части[1]), Число(Части[0]));
	Исключение
		// Текст сведений сервиса не дата: такой сертификат пропускается, остальные проверки идут дальше.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ОписаниеСотрудника(Строка, Проблемы)

	Описание = Новый Структура;
	Описание.Вставить("employee", Строка.Сотрудник);
	Описание.Вставить("organization", Строка.Организация);
	Описание.Вставить("kedo_status", Строка.Статус);
	Описание.Вставить("ok", Не ЕстьСерьезные(Проблемы));
	Описание.Вставить("problems", Проблемы);
	Возврат Описание;

КонецФункции

// Данные для сравнения и проверок по сотрудникам.
//
// Возвращаемое значение:
//  Структура - Соответствия с ключом СправочникСсылка.Сотрудники:
//   * Лица - Соответствие - ФИО, ДатаРождения, Почта, Телефон, ТабельныйНомер.
//   * Сервис - Соответствие - ФИО, Почта, Телефон, ДатаРождения, ТабельныйНомер, ЗаявкаНЭП, СертификатыЭП.
//   * Приглашения - Соответствие - ФИО, Почта, Телефон, ДатаРождения, ПоSMS.
//   * ДолжностиНеПереданы - Соответствие - Булево.
//   * Сертификаты - Соответствие - Массив из Структура: type, valid_to.
//   * Синхронизация - Соответствие - Период, Результат, ОписаниеОшибки.
Функция ДеталиСотрудников(Сотрудники)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Код КАК ТабельныйНомер,
	|	Сотрудники.ФизическоеЛицо.ФИО КАК ФИО,
	|	Сотрудники.ФизическоеЛицо.ДатаРождения КАК ДатаРождения,
	|	Контакты.Вид КАК Вид,
	|	Контакты.Представление КАК Представление
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК Контакты
	|		ПО (Контакты.Ссылка = Сотрудники.ФизическоеЛицо)
	|			И (Контакты.Вид В (&ВидПочты, &ВидТелефона))
	|ГДЕ
	|	Сотрудники.Ссылка В(&Сотрудники)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связь.Объект КАК Сотрудник,
	|	Employees.ФИО КАК ФИО,
	|	Employees.email КАК Почта,
	|	Employees.phone КАК Телефон,
	|	Employees.birthdate КАК ДатаРождения,
	|	Employees.uniqueId КАК ТабельныйНомер,
	|	Employees.ЗаявкаНЭП КАК ЗаявкаНЭП,
	|	Employees.СертификатыЭП КАК СертификатыЭП
	|ИЗ
	|	РегистрСведений.КЭДО_Employees КАК Employees
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Владелец.Идентификатор = Employees.organizations_id)
	|			И (Связь.Ссылка.Идентификатор = Employees.id)
	|ГДЕ
	|	Связь.Объект В(&Сотрудники)
	|	И (Employees.deleted_at = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Employees.deleted_at > &ТекущаяДата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связь.Объект КАК Сотрудник,
	|	Invites.ФИО КАК ФИО,
	|	Invites.email КАК Почта,
	|	Invites.phone КАК Телефон,
	|	Invites.birthdate КАК ДатаРождения,
	|	Invites.inviteChannel = ""Sms"" КАК ПоSMS,
	|	Invites.Просрочено КАК Просрочено
	|ИЗ
	|	РегистрСведений.КЭДО_Invites КАК Invites
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоПриглашения.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Идентификатор = Invites.id)
	|ГДЕ
	|	Связь.Объект В(&Сотрудники)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Просрочено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связь.Объект КАК Сотрудник
	|ИЗ
	|	Справочник.КонтурКэдоДолжностиСотрудников КАК Должности
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.Ссылка = Должности.Владелец)
	|			И (Связь.НомерСтроки = 1)
	|ГДЕ
	|	Связь.Объект В(&Сотрудники)
	|	И Должности.СтатусСинхронизации В
	|			(ЗНАЧЕНИЕ(Перечисление.КонтурКэдоСтатусыСинхронизации.ЖдетСинхронизации),
	|			ЗНАЧЕНИЕ(Перечисление.КонтурКэдоСтатусыСинхронизации.ЖдетУдаления))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связь.Объект КАК Сотрудник,
	|	Сертификаты.Квалифицированный КАК Квалифицированный,
	|	МАКСИМУМ(Сертификаты.ДействителенДо) КАК ДействителенДо
	|ИЗ
	|	Справочник.КонтурКэдоСертификатыСотрудника КАК Сертификаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.Ссылка = Сертификаты.Владелец)
	|			И (Связь.НомерСтроки = 1)
	|ГДЕ
	|	Связь.Объект В(&Сотрудники)
	|	И НЕ Сертификаты.ПометкаУдаления
	|	И Сертификаты.ДействителенДо > ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	Связь.Объект,
	|	Сертификаты.Квалифицированный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Синхронизация.Сотрудник КАК Сотрудник,
	|	МАКСИМУМ(Синхронизация.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ПоследняяСинхронизация
	|ИЗ
	|	РегистрСведений.КЭДО_СотрудникиКСинхронизации КАК Синхронизация
	|ГДЕ
	|	Синхронизация.Сотрудник В(&Сотрудники)
	|
	|СГРУППИРОВАТЬ ПО
	|	Синхронизация.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Синхронизация.Сотрудник КАК Сотрудник,
	|	Синхронизация.Период КАК Период,
	|	Синхронизация.Результат КАК Результат,
	|	Синхронизация.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	РегистрСведений.КЭДО_СотрудникиКСинхронизации КАК Синхронизация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоследняяСинхронизация КАК Последняя
	|		ПО (Последняя.Сотрудник = Синхронизация.Сотрудник)
	|			И (Последняя.Период = Синхронизация.Период)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Результат";
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ВидПочты", ИИОК_КЭДО.ВидПочты());
	Запрос.УстановитьПараметр("ВидТелефона", ИИОК_КЭДО.ВидТелефона());
	Результаты = Запрос.ВыполнитьПакет();

	Детали = Новый Структура;
	Детали.Вставить("Лица", ЛицаСотрудников(Результаты[0].Выбрать()));
	Детали.Вставить("Сервис", ПервыеПоСотруднику(Результаты[1].Выбрать(),
		"ФИО, Почта, Телефон, ДатаРождения, ТабельныйНомер, ЗаявкаНЭП, СертификатыЭП"));
	Детали.Вставить("Приглашения", ПервыеПоСотруднику(Результаты[2].Выбрать(),
		"ФИО, Почта, Телефон, ДатаРождения, ПоSMS"));
	ДолжностиНеПереданы = Новый Соответствие;
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДолжностиНеПереданы.Вставить(Выборка.Сотрудник, Истина);
	КонецЦикла;
	Детали.Вставить("ДолжностиНеПереданы", ДолжностиНеПереданы);
	Сертификаты = Новый Соответствие;
	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Сертификаты.Получить(Выборка.Сотрудник);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Сертификаты.Вставить(Выборка.Сотрудник, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("type, valid_to", ?(Выборка.Квалифицированный, "КЭП", "НЭП"),
			НачалоДня(Выборка.ДействителенДо)));
	КонецЦикла;
	Детали.Вставить("Сертификаты", Сертификаты);
	Детали.Вставить("Синхронизация", ПервыеПоСотруднику(Результаты[6].Выбрать(), "Период, Результат, ОписаниеОшибки"));
	Возврат Детали;

КонецФункции

Функция ЛицаСотрудников(Выборка)

	ВидПочты = ИИОК_КЭДО.ВидПочты();
	Лица = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Лицо = Лица.Получить(Выборка.Сотрудник);
		Если Лицо = Неопределено Тогда
			Лицо = Новый Структура("ФИО, ДатаРождения, Почта, Телефон, ТабельныйНомер", Выборка.ФИО,
				Выборка.ДатаРождения, "", "", Выборка.ТабельныйНомер);
			Лица.Вставить(Выборка.Сотрудник, Лицо);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Представление) Тогда
			Продолжить;
		ИначеЕсли Выборка.Вид = ВидПочты Тогда
			Лицо.Почта = ?(ЗначениеЗаполнено(Лицо.Почта), Лицо.Почта, Выборка.Представление);
		Иначе
			Лицо.Телефон = ?(ЗначениеЗаполнено(Лицо.Телефон), Лицо.Телефон, Выборка.Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Лица;

КонецФункции

Функция ПервыеПоСотруднику(Выборка, Поля)

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Сотрудник) = Неопределено Тогда
			Значения = Новый Структура(Поля);
			ЗаполнитьЗначенияСвойств(Значения, Выборка);
			Результат.Вставить(Выборка.Сотрудник, Значения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сотрудники и приглашения сервиса без связи с сотрудником 1С - как «Нет связи с 1С» в «Текущих делах КЭДО».
// Уволенные в КЭДО не учитываются.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ОрганизацияID, Вид (employee, invite), ФИО.
Функция НесвязанныеВКЭДО(ОрганизацииID)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Employees.organizations_id КАК ОрганизацияID,
	|	""employee"" КАК Вид,
	|	Employees.ФИО КАК ФИО
	|ИЗ
	|	РегистрСведений.КЭДО_Employees КАК Employees
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоСотрудники.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Владелец.Идентификатор = Employees.organizations_id)
	|			И (Связь.Ссылка.Идентификатор = Employees.id)
	|ГДЕ
	|	Employees.organizations_id В(&ОрганизацииID)
	|	И (Employees.deleted_at = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Employees.deleted_at > &ТекущаяДата)
	|	И (Связь.Объект ЕСТЬ NULL
	|			ИЛИ НЕ Связь.Объект ССЫЛКА Справочник.Сотрудники
	|			ИЛИ Связь.Объект = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Invites.organizations_id,
	|	""invite"",
	|	Invites.ФИО
	|ИЗ
	|	РегистрСведений.КЭДО_Invites КАК Invites
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурКэдоПриглашения.СвязанныеОбъекты КАК Связь
	|		ПО (Связь.НомерСтроки = 1)
	|			И (Связь.Ссылка.Идентификатор = Invites.id)
	|ГДЕ
	|	Invites.organizations_id В(&ОрганизацииID)
	|	И (Связь.Объект ЕСТЬ NULL
	|			ИЛИ НЕ Связь.Объект ССЫЛКА Справочник.Сотрудники
	|			ИЛИ Связь.Объект = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ОрганизацииID", ОрганизацииID);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НесвязанныеПоФИО(ОрганизацииID)

	Результат = Новый Соответствие;
	Для Каждого Строка Из НесвязанныеВКЭДО(ОрганизацииID) Цикл
		Ключ = КлючФИО(Строка.ОрганизацияID, Строка.ФИО);
		Если Результат.Получить(Ключ) <> "employee" Тогда
			Результат.Вставить(Ключ, Строка.Вид);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючФИО(ОрганизацияID, ФИО)

	// Заглавная "е с двумя точками" (Символ(1025)) в ФИО приравнивается к Е.
	Текст = СтрЗаменить(ВРег(СокрЛП(ФИО)), Символ(1025), "Е");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат ОрганизацияID + "|" + Текст;

КонецФункции

#КонецОбласти

#Область Организации

Функция СопоставленныеОрганизации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связи.Объект КАК Организация
	|ИЗ
	|	Справочник.КЭДО_Организации.СвязанныеОбъекты КАК Связи
	|ГДЕ
	|	НЕ Связи.Ссылка.ПометкаУдаления
	|	И Связи.Объект ССЫЛКА Справочник.Организации
	|	И Связи.Объект <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");

КонецФункции

// Проверки организаций: сопоставление, подписка на модуль интеграции, свежесть данных сервиса,
// фоновая передача данных сотрудников, сотрудники сервиса без связи с 1С.
Функция ПроверитьОрганизации(Организации, ВерсияКЭДО)

	Результат = Новый Массив;
	Если Организации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.Объект КАК Организация,
	|	МАКСИМУМ(Связи.Ссылка) КАК ОрганизацияКЭДО
	|ПОМЕСТИТЬ ВТ_Организации
	|ИЗ
	|	Справочник.КЭДО_Организации.СвязанныеОбъекты КАК Связи
	|ГДЕ
	|	Связи.Объект В(&Организации)
	|	И НЕ Связи.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Связи.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Организации.Организация КАК Организация,
	|	ВТ_Организации.ОрганизацияКЭДО КАК ОрганизацияКЭДО,
	|	ВТ_Организации.ОрганизацияКЭДО.Идентификатор КАК ОрганизацияID
	|ИЗ
	|	ВТ_Организации КАК ВТ_Организации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Подписки.ОрганизацияКЭДО КАК ОрганизацияКЭДО,
	|	Подписки.ИдСервиса КАК ИдСервиса,
	|	Подписки.Период КАК Начало,
	|	Подписки.КонецПериода КАК Конец,
	|	Подписки.ДатаЗагрузки КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.КонтурКэдоПодпискиНаСервисы КАК Подписки
	|ГДЕ
	|	Подписки.ОрганизацияКЭДО В
	|			(ВЫБРАТЬ
	|				ВТ_Организации.ОрганизацияКЭДО
	|			ИЗ
	|				ВТ_Организации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Очередь.ОрганизацияКЭДО КАК ОрганизацияКЭДО,
	|	МАКСИМУМ(Очередь.ДатаЗавершения) КАК ДатаЗавершения
	|ИЗ
	|	РегистрСведений.КЭДО_ОчередьЗаданий КАК Очередь
	|ГДЕ
	|	Очередь.Тип = ЗНАЧЕНИЕ(Перечисление.КЭДО_ТипыЗаданий.Обновление)
	|	И Очередь.Состояние = ЗНАЧЕНИЕ(Перечисление.КЭДО_СостоянияЗаданий.Выполнено)
	|	И Очередь.ОрганизацияКЭДО В
	|			(ВЫБРАТЬ
	|				ВТ_Организации.ОрганизацияКЭДО
	|			ИЗ
	|				ВТ_Организации)
	|
	|СГРУППИРОВАТЬ ПО
	|	Очередь.ОрганизацияКЭДО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФоновыеЗадания.organizations_id КАК ОрганизацияID,
	|	ФоновыеЗадания.ДатаОкончания КАК ДатаОкончания,
	|	ФоновыеЗадания.БылиОшибки КАК БылиОшибки
	|ИЗ
	|	РегистрСведений.КЭДО_ДанныеФоновыхЗаданий КАК ФоновыеЗадания
	|ГДЕ
	|	ФоновыеЗадания.Идентификатор = ""СинхронизацияДанныхСотрудников""";
	Запрос.УстановитьПараметр("Организации", Организации);
	Результаты = Запрос.ВыполнитьПакет();
	Сопоставленные = Результаты[1].Выгрузить();
	Подписки = Результаты[2].Выгрузить();
	Обновления = Результаты[3].Выгрузить();
	СинхронизацииСотрудников = Результаты[4].Выгрузить();
	Несвязанные = НесвязанныеВКЭДО(Сопоставленные.ВыгрузитьКолонку("ОрганизацияID"));

	Для Каждого Организация Из Организации Цикл
		Описание = Новый Структура("organization, mapped, problems", Организация, Ложь, Новый Массив);
		Результат.Добавить(Описание);
		Сопоставление = Сопоставленные.Найти(Организация, "Организация");
		Если Сопоставление = Неопределено Тогда
			ДобавитьПроблему(Описание.problems, "organization_not_mapped", "blocker",
				НСтр("ru = 'Организация не сопоставлена с организацией в КЭДО: КЭДО не видит её сотрудников, приглашать их и отправлять им документы нельзя.'"),
				НСтр("ru = 'Сопоставить организацию с организацией КЭДО в настройках расширения КЭДО.'"));
			Продолжить;
		КонецЕсли;
		Описание.mapped = Истина;
		ОтборКЭДО = Новый Структура("ОрганизацияКЭДО", Сопоставление.ОрганизацияКЭДО);
		ОтборID = Новый Структура("ОрганизацияID", Сопоставление.ОрганизацияID);
		ПроверитьПодписку(Описание, Подписки.НайтиСтроки(ОтборКЭДО), ВерсияКЭДО);
		Обновление = Обновления.Найти(Сопоставление.ОрганизацияКЭДО, "ОрганизацияКЭДО");
		ДатаОбновления = ?(Обновление = Неопределено, Дата(1, 1, 1), ИИОК_КЭДО.МестнаяДата(Обновление.ДатаЗавершения));
		ПроверитьОбновление(Описание, ДатаОбновления);
		Синхронизация = СинхронизацииСотрудников.Найти(Сопоставление.ОрганизацияID, "ОрганизацияID");
		ПроверитьФоновуюСинхронизацию(Описание, Синхронизация);
		ПроверитьНесвязанных(Описание, Несвязанные.НайтиСтроки(ОтборID));
		Описание.problems = УпорядоченныеПроблемы(Описание.problems);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// С версии 1.27 расширение КЭДО не отправляет из 1С документы, ЛНА, прием и отпуска организации без действующей
// подписки на модуль интеграции с 1С; приглашения эта проверка не затрагивает, в версиях до 1.27 ее нет.
// Сведения о подписках расширение загружает из сервиса при входе в КЭДО.
Процедура ПроверитьПодписку(Описание, Подписки, ВерсияКЭДО)

	Если Подписки.Количество() = 0 Тогда
		ДобавитьПроблему(Описание.problems, "subscriptions_unknown", "info",
			НСтр("ru = 'Сведений о подписках организации в базе нет: расширение КЭДО загружает их при входе в КЭДО.'"));
		Возврат;
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();
	Загружены = Дата(1, 1, 1);
	Конец = Неопределено;
	Для Каждого Подписка Из Подписки Цикл
		Загружены = Макс(Загружены, Подписка.ДатаЗагрузки);
		Если СервисыИнтеграции().Найти(Подписка.ИдСервиса) <> Неопределено
			И Подписка.Начало <= Сейчас И Подписка.Конец >= Сейчас Тогда
			Конец = ?(Конец = Неопределено, Подписка.Конец, Макс(Конец, Подписка.Конец));
		КонецЕсли;
	КонецЦикла;
	Описание.Вставить("subscriptions_loaded", Загружены);
	ПодпискаПроверяется = ПроверяетПодписку(ВерсияКЭДО);
	Если Конец = Неопределено И ПодпискаПроверяется Тогда
		Проблема = НоваяПроблема("no_integration_subscription", "blocker",
			СтрШаблон(НСтр("ru = 'По данным на %1 у организации нет действующей подписки на модуль интеграции КЭДО с 1С. Без неё расширение КЭДО не отправляет из 1С документы, ЛНА, документы о приёме и отпусках; приглашать сотрудников можно.'"),
				ФорматДатыВремени(Загружены)),
			НСтр("ru = 'Подключить модуль интеграции КЭДО с 1С для этой организации. Если он уже оплачен, сведения обновятся при следующем входе в КЭДО; если не обновляются, обратиться в поддержку Контура.'"));
		Проблема.Вставить("facts", Новый Структура("service_ids", СервисыИнтеграции()));
		Описание.problems.Добавить(Проблема);
	ИначеЕсли Конец = Неопределено Тогда
		ДобавитьПроблему(Описание.problems, "no_integration_subscription", "info",
			СтрШаблон(НСтр("ru = 'По данным на %1 у организации нет действующей подписки на модуль интеграции КЭДО с 1С. Установленная версия расширения КЭДО (%2) подписку не проверяет, отправка из 1С работает. С версии 1.27 без подписки расширение не отправляет из 1С документы, ЛНА, документы о приёме и отпусках.'"),
				ФорматДатыВремени(Загружены), ВерсияКЭДО),
			НСтр("ru = 'Подключить модуль интеграции КЭДО с 1С до обновления расширения КЭДО до версии 1.27 или новее.'"));
	ИначеЕсли ПодпискаПроверяется И Конец - Сейчас <= ДнейДоОкончанияПодписки() * 86400 Тогда
		ДобавитьПроблему(Описание.problems, "integration_subscription_expiring", "warning",
			СтрШаблон(НСтр("ru = 'Подписка на модуль интеграции КЭДО с 1С заканчивается %1.'"), ФорматДаты(Конец)),
			НСтр("ru = 'Продлить подписку заранее: после окончания расширение перестанет отправлять документы из 1С.'"));
	КонецЕсли;

КонецПроцедуры

// Проверяет ли установленная версия расширения КЭДО подписку на модуль интеграции: проверка появилась в 1.27.
Функция ПроверяетПодписку(ВерсияКЭДО)

	Части = СтрРазделить(ВерсияКЭДО, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Истина;
	КонецЕсли;
	Старшая = ЧислоИзНачала(Части[0]);
	Младшая = ЧислоИзНачала(Части[1]);
	Возврат Старшая > 1 Или Старшая = 1 И Младшая >= 27;

КонецФункции

// Число из цифр в начале строки: у предварительных сборок КЭДО версии вида 1.27.0-rc.1.
Функция ЧислоИзНачала(Текст)

	Цифры = "";
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Номер, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;
	Возврат ?(Цифры = "", 0, Число(Цифры));

КонецФункции

// Идентификаторы сервисов модуля интеграции в сведениях о подписках.
Функция СервисыИнтеграции()

	Возврат СтрРазделить("integration_kedo,integration_wedo", ",");

КонецФункции

// «Текущие дела КЭДО» предупреждают, если обновление структуры организации не выполнялось больше 12 часов:
// сотрудники сервиса, приглашения и сертификаты в базе - копия, обновляемая этим заданием.
Процедура ПроверитьОбновление(Описание, ДатаОбновления)

	Описание.Вставить("data_updated", ?(ЗначениеЗаполнено(ДатаОбновления), ДатаОбновления, Неопределено));
	Если ТекущаяДатаСеанса() - ДатаОбновления <= ЧасовАктуальности() * 3600 Тогда
		Возврат;
	КонецЕсли;
	ДобавитьПроблему(Описание.problems, "data_stale", "warning",
		?(ЗначениеЗаполнено(ДатаОбновления),
			СтрШаблон(НСтр("ru = 'Обновление структуры организации из КЭДО (подразделения, должности, сотрудники, приглашения, сертификаты) последний раз выполнялось %1; «Текущие дела КЭДО» предупреждают об этом. Часть данных расширение обновляет и при других операциях, но статусы могут быть устаревшими.'"),
				ФорматДатыВремени(ДатаОбновления)),
			НСтр("ru = 'Обновление структуры организации из КЭДО ни разу не выполнялось: сведений о подразделениях, должностях, сотрудниках и приглашениях сервиса в базе может не быть.'")),
		НСтр("ru = 'Обновить данные в «Текущих делах КЭДО»: там же показано предупреждение об обновлении структуры организации.'"));

КонецПроцедуры

Процедура ПроверитьФоновуюСинхронизацию(Описание, Задание)

	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДатаОкончания = ИИОК_КЭДО.МестнаяДата(Задание.ДатаОкончания);
	Если Задание.БылиОшибки Тогда
		ДобавитьПроблему(Описание.problems, "employee_sync_errors", "warning",
			СтрШаблон(НСтр("ru = 'Последняя фоновая передача кадровых данных сотрудников в КЭДО (%1) прошла с ошибками.'"),
				ФорматДатыВремени(ДатаОкончания)),
			НСтр("ru = 'Открыть «Отчёт синхронизации» в «Текущих делах КЭДО»: там ошибки по каждому сотруднику.'"));
	ИначеЕсли ТекущаяДатаСеанса() - ДатаОкончания > ЧасовАктуальности() * 3600 Тогда
		ДобавитьПроблему(Описание.problems, "employee_sync_stale", "warning",
			СтрШаблон(НСтр("ru = 'Фоновая передача кадровых данных сотрудников в КЭДО последний раз выполнялась %1.'"),
				ФорматДатыВремени(ДатаОкончания)),
			НСтр("ru = 'Проверить, что в базе выполняются регламентные задания КЭДО; отчёт синхронизации - в «Текущих делах КЭДО».'"));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНесвязанных(Описание, Несвязанные)

	Сотрудников = 0;
	Приглашений = 0;
	Для Каждого Строка Из Несвязанные Цикл
		Если Строка.Вид = "employee" Тогда
			Сотрудников = Сотрудников + 1;
		Иначе
			Приглашений = Приглашений + 1;
		КонецЕсли;
	КонецЦикла;
	Если Сотрудников + Приглашений = 0 Тогда
		Возврат;
	КонецЕсли;
	Проблема = НоваяПроблема("unlinked_in_kedo", "warning",
		СтрШаблон(НСтр("ru = 'В КЭДО есть сотрудники (%1) и приглашения (%2) этой организации без связи с сотрудниками 1С: документы из 1С им не отправить. В «Текущих делах КЭДО» они отмечены «Нет связи с 1С».'"),
			Сотрудников, Приглашений),
		НСтр("ru = 'Установить связь в «Текущих делах КЭДО» («Установить связь» в строке сотрудника).'"));
	Проблема.Вставить("facts", Новый Структура("employees, invites", Сотрудников, Приглашений));
	Описание.problems.Добавить(Проблема);

КонецПроцедуры

Процедура ДобавитьОрганизацию(Организации, Организация)

	Если ЗначениеЗаполнено(Организация) И Организации.Найти(Организация) = Неопределено Тогда
		Организации.Добавить(Организация);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Расширение

// Ошибки расширения КЭДО за последние дни: журнал событий КЭДО и задания очереди, завершившиеся ошибкой.
// Тексты могут называть людей: ФИО из сведений сервиса, чья фамилия встречается в тексте, уходят в контекст ПДн.
// Ошибка раньше последнего успешного обмена с сервисом, скорее всего, уже не актуальна: например, ошибку получения
// токена расширение пишет при каждом запуске, а через секунды входит в сервис.
Функция ПроверитьРасширение(Контекст)

	Проблемы = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Журнал.Период КАК Период,
	|	Журнал.ИмяСобытия КАК Событие,
	|	ПОДСТРОКА(Журнал.Комментарий, 1, 1000) КАК Текст
	|ИЗ
	|	РегистрСведений.КЭДО_ЖурналСобытий КАК Журнал
	|ГДЕ
	|	Журнал.Период >= &Начало
	|	И Журнал.Уровень = ЗНАЧЕНИЕ(Перечисление.КЭДО_УровниЖурналаСобытий.Ошибка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	Состояния.ДатаИзмененияСостояния КАК Период,
	|	ПОДСТРОКА(Состояния.КраткоеПредставлениеОшибки, 1, 300) КАК Текст
	|ИЗ
	|	РегистрСведений.КонтурКэдоОчередьСостояниеЗаданий КАК Состояния
	|ГДЕ
	|	Состояния.Состояние = ЗНАЧЕНИЕ(Перечисление.КонтурКэдоОчередьСостояниеЗаданий.Ошибка)
	|	И Состояния.ДатаИзмененияСостояния >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Employees.ФИО КАК ФИО
	|ИЗ
	|	РегистрСведений.КЭДО_Employees КАК Employees
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Invites.ФИО
	|ИЗ
	|	РегистрСведений.КЭДО_Invites КАК Invites
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Подписки.ДатаЗагрузки) КАК Дата
	|ИЗ
	|	РегистрСведений.КонтурКэдоПодпискиНаСервисы КАК Подписки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Лента.ДатаОбновления) КАК Дата
	|ИЗ
	|	РегистрСведений.КЭДО_РезультатыЧтенияЛенты КАК Лента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Очередь.ДатаЗавершения) КАК Дата
	|ИЗ
	|	РегистрСведений.КЭДО_ОчередьЗаданий КАК Очередь
	|ГДЕ
	|	Очередь.Состояние = ЗНАЧЕНИЕ(Перечисление.КЭДО_СостоянияЗаданий.Выполнено)";
	Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - ДнейЖурнала() * 86400);
	Результаты = Запрос.ВыполнитьПакет();
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	ДобавитьОшибки(Группы, Порядок, Результаты[0].Выбрать(), Неопределено);
	ДобавитьОшибки(Группы, Порядок, Результаты[1].Выбрать(), НСтр("ru = 'Очередь заданий КЭДО'"));
	Для Каждого ФИО Из Результаты[2].Выгрузить().ВыгрузитьКолонку("ФИО") Цикл
		ДобавитьИмя(Контекст, ФИО);
	КонецЦикла;
	ПоследнийОбмен = Макс(ДатаИзРезультата(Результаты[3]),
		ИИОК_КЭДО.МестнаяДата(ДатаИзРезультата(Результаты[4])), ИИОК_КЭДО.МестнаяДата(ДатаИзРезультата(Результаты[5])));
	Если Порядок.Количество() = 0 Тогда
		Возврат Проблемы;
	КонецЕсли;

	Всего = 0;
	Для Каждого Группа Из Порядок Цикл
		Всего = Всего + Группа.count;
	КонецЦикла;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Группа");
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Последняя");
	Для Каждого Группа Из Порядок Цикл
		Строка = Таблица.Добавить();
		Строка.Группа = Группа;
		Строка.Количество = Группа.count;
		Строка.Последняя = Группа.last;
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв, Последняя Убыв");
	Ошибки = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Ошибки.Количество() = ГруппОшибок() Тогда
			Прервать;
		КонецЕсли;
		Ошибки.Добавить(Строка.Группа);
		ДобавитьИменаИзТекста(Контекст, Строка.Группа.text);
	КонецЦикла;
	Факты = Новый Структура("errors", Ошибки);
	Если Не ЗначениеЗаполнено(ПоследнийОбмен) Тогда
		Проблема = НоваяПроблема("extension_errors", "warning",
			СтрШаблон(НСтр("ru = 'За последние %1 дн. расширение КЭДО записало ошибок: %2. Самые частые - в facts.errors.'"),
				ДнейЖурнала(), Всего));
		Проблема.Вставить("facts", Факты);
		Проблемы.Добавить(Проблема);
		Возврат Проблемы;
	КонецЕсли;

	Факты.Вставить("last_exchange", ПоследнийОбмен);
	ПослеОбмена = 0;
	Для Каждого Группа Из Порядок Цикл
		Если Группа.last > ПоследнийОбмен И Не Группа.Свойство("cause") Тогда
			ПослеОбмена = ПослеОбмена + Группа.count;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Группа Из Ошибки Цикл
		Группа.Вставить("before_last_exchange", Группа.last <= ПоследнийОбмен);
	КонецЦикла;
	Если ПослеОбмена = 0 Тогда
		Проблема = НоваяПроблема("extension_errors", "info",
			СтрШаблон(НСтр("ru = 'За последние %1 дн. расширение КЭДО записало ошибок: %2. После последнего успешного обмена с сервисом КЭДО (%3) ошибок, мешающих работе, нет: ошибки с cause работе не мешают, остальные случились раньше этого обмена и, скорее всего, уже не актуальны. Самые частые - в facts.errors.'"),
				ДнейЖурнала(), Всего, ФорматДатыВремени(ПоследнийОбмен)));
	Иначе
		Проблема = НоваяПроблема("extension_errors", "warning",
			СтрШаблон(НСтр("ru = 'За последние %1 дн. расширение КЭДО записало ошибок: %2, из них после последнего успешного обмена с сервисом КЭДО (%3) - %4. Ошибки с before_last_exchange, скорее всего, уже не актуальны. Самые частые - в facts.errors.'"),
				ДнейЖурнала(), Всего, ФорматДатыВремени(ПоследнийОбмен), ПослеОбмена));
	КонецЕсли;
	Проблема.Вставить("facts", Факты);
	Проблемы.Добавить(Проблема);
	Возврат Проблемы;

КонецФункции

Процедура ДобавитьОшибки(Группы, Порядок, Выборка, Событие)

	Пока Выборка.Следующий() Цикл
		ИмяСобытия = ?(Событие = Неопределено, Выборка.Событие, Событие);
		Текст = ПерваяСтрока(Выборка.Текст);
		Причина = ИзвестнаяПричина(Текст, Выборка.Текст);
		Ключ = ИмяСобытия + Символы.ПС + Текст + Символы.ПС + Причина;
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("event, text, count, last", ИмяСобытия, Текст, 0, Выборка.Период);
			Если ЗначениеЗаполнено(Причина) Тогда
				Группа.Вставить("cause", Причина);
			КонецЕсли;
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;
		Группа.count = Группа.count + 1;
		Группа.last = Макс(Группа.last, Выборка.Период);
	КонецЦикла;

КонецПроцедуры

// Причина ошибки, которая работе КЭДО не мешает, по тексту и стеку из журнала КЭДО. Такие ошибки не считаются
// признаком проблемы.
Функция ИзвестнаяПричина(ПерваяСтрока, ПолныйТекст)

	Если ПерваяСтрока = "Не удалось получить токен доступа"
		И СтрНайти(ПолныйТекст, "ОбновитьОграниченияДоступа") > 0 Тогда
		Возврат НСтр("ru = 'Расширение КЭДО при запуске обновляет ограничения доступа для всех пользователей 1С; у тех, кто не входил в КЭДО, токена нет. Работе вошедших пользователей это не мешает.'");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ДатаИзРезультата(Результат)

	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Дата) Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	Возврат Дата(1, 1, 1);

КонецФункции

Функция ПерваяСтрока(Текст)

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС + Символы.ВК, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Возврат Лев(СокрЛП(Строка), 200);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Общее

// Проблема для модели.
//
// Параметры:
//  Код - Строка - Код проблемы.
//  Важность - Строка - blocker (КЭДО для сотрудника или организации не работает), warning (работает с ограничениями
//   или требует внимания), info (к сведению).
//  Текст - Строка - Что не так.
//  Исправление - Строка - Что сделать; пустая строка - не добавлять.
//
// Возвращаемое значение:
//  Структура - code, severity, text, fix.
Функция НоваяПроблема(Код, Важность, Текст, Исправление = "")

	Проблема = Новый Структура("code, severity, text", Код, Важность, Текст);
	Если ЗначениеЗаполнено(Исправление) Тогда
		Проблема.Вставить("fix", Исправление);
	КонецЕсли;
	Возврат Проблема;

КонецФункции

Процедура ДобавитьПроблему(Проблемы, Код, Важность, Текст, Исправление = "")

	Проблемы.Добавить(НоваяПроблема(Код, Важность, Текст, Исправление));

КонецПроцедуры

Функция УпорядоченныеПроблемы(Проблемы)

	Результат = Новый Массив;
	Для Каждого Важность Из СтрРазделить("blocker,warning,info", ",") Цикл
		Для Каждого Проблема Из Проблемы Цикл
			Если Проблема.severity = Важность Тогда
				Результат.Добавить(Проблема);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьСерьезные(Проблемы)

	Для Каждого Проблема Из Проблемы Цикл
		Если Проблема.severity <> "info" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Запоминает ФИО, которое может встретиться в свободном тексте ответа: в контекст ПДн оно попадет, только если
// его фамилия есть в тексте (см. ДобавитьИменаИзТекста).
Процедура ДобавитьИмя(Контекст, ФИО)

	Если Не ЗначениеЗаполнено(ФИО) Тогда
		Возврат;
	КонецЕсли;
	Фамилия = ВРег(СтрРазделить(СокрЛП(ФИО), " ", Ложь)[0]);
	Если СтрДлина(Фамилия) < 3 Тогда
		Возврат;
	КонецЕсли;
	Имена = Контекст.Имена.Получить(Фамилия);
	Если Имена = Неопределено Тогда
		Имена = Новый Массив;
		Контекст.Имена.Вставить(Фамилия, Имена);
	КонецЕсли;
	Если Имена.Найти(ФИО) = Неопределено Тогда
		Имена.Добавить(ФИО);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьИменаИзТекста(Контекст, Текст)

	ТекстВРег = ВРег(Текст);
	Для Каждого КлючИЗначение Из Контекст.Имена Цикл
		Если СтрНайти(ТекстВРег, КлючИЗначение.Ключ) > 0 Тогда
			Для Каждого ФИО Из КлючИЗначение.Значение Цикл
				ДобавитьПДн(Контекст, ФИО);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПДн(Контекст, ФИО)

	Для Каждого Значение Из Контекст.ПДн Цикл
		Если Значение.value = ФИО Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Контекст.ПДн.Добавить(ИИО_Ответ.ЗначениеСПДн(ФИО, "ФИО"));

КонецПроцедуры

// Есть ли у пользователя право чтения всех данных расширения КЭДО, которые читает диагностика.
// Основная роль КЭДО дает его целиком.
Функция ДоступныДанныеКЭДО()

	ПолныеИмена = СтрРазделить("Справочник.КЭДО_Организации,Справочник.КонтурКэдоСотрудники,"
		+ "Справочник.КонтурКэдоПриглашения,Справочник.КонтурКэдоДолжностиСотрудников,"
		+ "Справочник.КонтурКэдоСертификатыСотрудника,РегистрСведений.КЭДО_Employees,РегистрСведений.КЭДО_Invites,"
		+ "РегистрСведений.КЭДО_СотрудникиКСинхронизации,РегистрСведений.КонтурКэдоПодпискиНаСервисы,"
		+ "РегистрСведений.КЭДО_ОчередьЗаданий,РегистрСведений.КЭДО_ДанныеФоновыхЗаданий,"
		+ "РегистрСведений.КЭДО_ЖурналСобытий,РегистрСведений.КонтурКэдоОчередьСостояниеЗаданий,"
		+ "РегистрСведений.КЭДО_РезультатыЧтенияЛенты", ",");
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМетаданных <> Неопределено И Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

